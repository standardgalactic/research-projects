._magic-edit-selection_19h6r_1 { background: var(--theme-user-selection-bg,var(--selection)); -webkit-box-decoration-break: clone; box-decoration-break: clone; padding: 4.5px 0px; }

[data-me-role="container"] { display: block; position: relative; }

.writing-block-editor [data-me-role="container"], .writing-block-editor [data-me-role="orig"], .writing-block-editor [data-me-role="sugg"] { user-select: none; }

[data-me-role="orig"], [data-me-role="sugg"] { display: block; margin-block: 12px; position: relative; }

[data-me-role="orig"] { color: var(--text-primary); }

[data-me-role="orig"]::before, [data-me-role="sugg"]::before { border-radius: 0px 999px 999px 0px; content: ""; inset-block: 0px; inset-inline-start: -16px; position: absolute; width: 4px; }

@media (min-width: 640px) {
  [data-me-role="orig"]::before, [data-me-role="sugg"]::before { inset-inline-start: -20px; }
}

[data-me-role="orig"]::before { background: var(--black); }

.dark [data-me-role="orig"]::before { background: var(--gray-400); }

[data-me-role="sugg"]::before { background: rgb(2, 133, 255); }

[data-me-role="orig"] [data-me-change="delta"] { color: color-mix(in srgb,var(--text-primary) 50%,transparent); text-decoration-line: line-through; text-decoration-style: initial; text-decoration-color: color-mix(in srgb,var(--text-primary) 15%,transparent); text-decoration-thickness: 1px; }

[data-me-role="sugg"] [data-me-change="delta"] { color: rgb(2, 133, 255); }

._keyBindingTight_19h6r_76 kbd { box-shadow: none !important; color: var(--text-tertiary) !important; padding-inline: 0px !important; padding-top: 0px !important; }

.writing-block-editor .ProseMirror li p, .writing-block-editor .ProseMirror td p, .writing-block-editor .ProseMirror th p { margin: 0px; }

.writing-block-editor .ProseMirror p .selection-highlight { padding-bottom: 0.28em; padding-top: 0.28em; }

.writing-block-editor .ProseMirror p + p { margin-block: 0.75rem; }

.writing-block-editor .writing-block-generate-suggestion { color: rgb(2, 133, 255); cursor: text; user-select: text; }

.mapboxgl-map { -webkit-tap-highlight-color: rgba(0, 0, 0, 0); font: 12px / 20px "Helvetica Neue", Arial, Helvetica, sans-serif; overflow: hidden; position: relative; }

.mapboxgl-canvas { left: 0px; position: absolute; top: 0px; }

.mapboxgl-map:-webkit-full-screen { height: 100%; width: 100%; }

.mapboxgl-canary { background-color: salmon; }

.mapboxgl-canvas-container.mapboxgl-interactive, .mapboxgl-ctrl-group button.mapboxgl-ctrl-compass { cursor: grab; user-select: none; }

.mapboxgl-canvas-container.mapboxgl-interactive.mapboxgl-track-pointer { cursor: pointer; }

.mapboxgl-canvas-container.mapboxgl-interactive:active, .mapboxgl-ctrl-group button.mapboxgl-ctrl-compass:active { cursor: grabbing; }

.mapboxgl-canvas-container.mapboxgl-touch-zoom-rotate, .mapboxgl-canvas-container.mapboxgl-touch-zoom-rotate .mapboxgl-canvas { touch-action: pan-x pan-y; }

.mapboxgl-canvas-container.mapboxgl-touch-drag-pan, .mapboxgl-canvas-container.mapboxgl-touch-drag-pan .mapboxgl-canvas { touch-action: pinch-zoom; }

