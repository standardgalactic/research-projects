if __name__ == "__main__":
&nbsp; &nbsp; print('Semantic phase demo â€” create synthetic fields and compute diagnostics')
&nbsp; &nbsp; N = 32
&nbsp; &nbsp; rng = np.random.default_rng(1)
&nbsp; &nbsp; Phi = rng.normal(scale=0.01, size=(N, N))
&nbsp; &nbsp; # add a bump
&nbsp; &nbsp; x = np.linspace(0, 1, N)
