m:block"><button class="flex items-center gap-1 py-1 ps-1.5 pe-2.5 select-none disabled:cursor-not-allowed disabled:opacity-50">Download</button></span></div><div class="hover:text-token-text-primary"><button class="btn relative btn-primary -my-1 -me-3 flex items-center gap-1 py-1 select-none"><div class="flex items-center justify-center"><span class="" data-state="closed"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="block sm:hidden"><path d="M6 14.7229V5.27708C6 4.29072 7.08894 3.69295 7.9211 4.22251L15.3428 8.94541C16.1147 9.43661 16.1147 10.5634 15.3428 11.0546L7.92109 15.7775C7.08894 16.307 6 15.7093 6 14.7229Z"></path></svg></span><span class="hidden sm:block">Run code</span></div></button></div></div></div></div><div class="relative flex min-h-0 w-full flex-1 flex-col self-end"><div class="relative flex min-h-0 flex-auto flex-col overflow-hidden border-t transition-colors border-transparent"><section class="popover flex h-full w-full flex-col bg-transparent"><section class="relative flex min-h-0 flex-auto grow flex-col overflow-hidden"><div class="block h-auto"><div class="flex justify-start h-full" style="margin: 0px 16px;"><div class="relative z-0 flex h-full max-w-full"><div id="codemirror" class="_codemirror_hsqxh_1 _preview_hsqxh_26 z-10 flex h-full w-full flex-col items-stretch" style="width: 0px;"><div class="cm-editor Í¼1 Í¼2 Í¼13 Í¼14 Í¼12"><div class="cm-announced" aria-live="polite"></div><div tabindex="-1" class="cm-scroller" data-aria-hidden="true" aria-hidden="true"><div spellcheck="false" autocorrect="off" autocapitalize="off" translate="no" contenteditable="false" style="tab-size: 4;" class="cm-content" role="textbox" aria-multiline="true" aria-readonly="true"><div class="cm-line">"""</div><div class="cm-line">Synthetic Experiments</div><div class="cm-line"><br></div><div class="cm-line">Generates controlled toy models for calibration and Monte Carlo validation of RSVP fields.</div><div class="cm-line">"""</div><div class="cm-line"><br></div><div class="cm-line">import numpy as np</div><div class="cm-line">from utils.logging_utils import log_event</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">def generate_toy_fields(lattice_size=16, pattern='random', seed=None):</div><div class="cm-line">    if seed is not None:</div><div class="cm-line">        np.random.seed(seed)</div><div class="cm-line">    if pattern == 'random':</div><div class="cm-line">        Phi = np.random.randn(lattice_size, lattice_size)</div><div class="cm-line">        V = np.random.randn(lattice_size, lattice_size, 2)</div><div class="cm-line">        S = np.random.randn(lattice_size, lattice_size)</div><div class="cm-line">    elif pattern == 'uniform':</div><div class="cm-line">        Phi = np.ones((lattice_size, lattice_size))</div><div class="cm-line">        V = np.zeros((lattice_size, lattice_size, 2))</div><div class="cm-line">        S = np.ones((lattice_size, lattice_size))</div><div class="cm-line">    elif pattern == 'gradient':</div><div class="cm-line">        Phi = np.linspace(0,1,lattice_size).reshape(-1,1) * np.ones((1,lattice_size))</div><div class="cm-line">        V = np.zeros((lattice_size, lattice_size, 2))</div><div class="cm-line">        S = np.linspace(0,1,lattice_size).reshape(-1,1) * np.ones((1,lattice_size))</div><div class="cm-line">    else:</div><div class="cm-line">        raise ValueError('Unknown pattern type')</div><div class="cm-line">    return Phi, V, S</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">def monte_carlo_runs(n_runs=10, lattice_size=16, pattern='random', seed=None, log_file=None):</div><div class="cm-line">    results = []</div><div class="cm-line">    for i in range(n_runs):</div><div class="cm-line">        run_seed = None if seed is None else seed + i</div><div class="cm-line">        Phi, V, S = generate_toy_fields(lattice_size, pattern, seed=run_seed)</div><div class="cm-line">        # Placeholder metric: mean of Phi and S</div><div class="cm-gap" style="height: 168px;"></div></div></div></div></div></div></div></div></section></section></div></div></div></div><div data-message-author-role="assistant" data-message-id="80b1b255-2f99-489e-a9b3-e37a3ee8fda2" dir="auto" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal [.text-message+&amp;]:mt-1" data-message-model-slug="gpt-5-mini" data-aria-hidden="true" aria-hidden="true"><div class="flex w-full flex-col gap-1 empty:hidden first:pt-[1px]"><div class="markdown prose dark:prose-invert w-full break-words dark markdown-new-styling"><p data-start="0" data-end="155">âœ… Created <strong data-start="10" data-end="40"><code data-start="12" data-end="38">synthetic_experiments.py</code></strong> â€” generates controlled toy fields, runs Monte Carlo simulations, computes placeholder metrics, and logs results.</p>
