k"><button class="flex items-center gap-1 py-1 ps-1.5 pe-2.5 select-none disabled:cursor-not-allowed disabled:opacity-50">Download</button></span></div><div class="hover:text-token-text-primary"><button class="btn relative btn-primary -my-1 -me-3 flex items-center gap-1 py-1 select-none"><div class="flex items-center justify-center"><span class="" data-state="closed"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="block sm:hidden"><path d="M6 14.7229V5.27708C6 4.29072 7.08894 3.69295 7.9211 4.22251L15.3428 8.94541C16.1147 9.43661 16.1147 10.5634 15.3428 11.0546L7.92109 15.7775C7.08894 16.307 6 15.7093 6 14.7229Z"></path></svg></span><span class="hidden sm:block">Run code</span></div></button></div></div></div></div><div class="relative flex min-h-0 w-full flex-1 flex-col self-end"><div class="relative flex min-h-0 flex-auto flex-col overflow-hidden border-t transition-colors border-transparent"><section class="popover flex h-full w-full flex-col bg-transparent"><section class="relative flex min-h-0 flex-auto grow flex-col overflow-hidden"><div class="block h-auto"><div class="flex justify-start h-full" style="margin: 0px 16px;"><div class="relative z-0 flex h-full max-w-full"><div id="codemirror" class="_codemirror_hsqxh_1 _preview_hsqxh_26 z-10 flex h-full w-full flex-col items-stretch" style="width: 0px;"><div class="cm-editor Í¼1 Í¼2 Í¼13 Í¼14 Í¼12"><div class="cm-announced" aria-live="polite"></div><div tabindex="-1" class="cm-scroller" data-aria-hidden="true" aria-hidden="true"><div spellcheck="false" autocorrect="off" autocapitalize="off" translate="no" contenteditable="false" style="tab-size: 4;" class="cm-content" role="textbox" aria-multiline="true" aria-readonly="true"><div class="cm-line">"""</div><div class="cm-line">Governance Metrics Analysis</div><div class="cm-line"><br></div><div class="cm-line">Computes collapse probabilities, Î»_c confidence intervals, and stability scores for RSVP field simulations.</div><div class="cm-line">"""</div><div class="cm-line"><br></div><div class="cm-line">import numpy as np</div><div class="cm-line">from scipy.stats import linregress</div><div class="cm-line">from utils.logging_utils import log_event</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">def compute_collapse_probability(entropy_history, threshold=None):</div><div class="cm-line">    """Estimate collapse probability based on Î£Ì‡ exceeding threshold."""</div><div class="cm-line">    if threshold is None:</div><div class="cm-line">        threshold = np.mean(entropy_history) + 2*np.std(entropy_history)</div><div class="cm-line">    collapse_events = entropy_history &gt; threshold</div><div class="cm-line">    return np.sum(collapse_events) / len(entropy_history)</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">def compute_lambda_critical(entropy_history, lambda_values):</div><div class="cm-line">    """Estimate Î»_c as the Î» where mean Î£Ì‡ crosses a critical value."""</div><div class="cm-line">    mean_sigma = [np.mean(history) for history in entropy_history]</div><div class="cm-line">    slope, intercept, r_value, p_value, std_err = linregress(lambda_values, mean_sigma)</div><div class="cm-line">    lambda_c = (np.mean(mean_sigma) - intercept) / slope if slope != 0 else np.nan</div><div class="cm-line">    return lambda_c</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">def stability_score(entropy_history):</div><div class="cm-line">    """Compute a simple stability score based on Î£Ì‡ variance."""</div><div class="cm-line">    return 1.0 / (np.var(entropy_history) + 1e-8)</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">if __name__ == "__main__":</div><div class="cm-line">    # Demo usage</div><div class="cm-line">    entropy_demo = np.random.rand(50) * 0.5 + 0.5</div><div class="cm-line">    lambda_d