estamps, and reproducibility metadata for RSVP simulations.</div><div class="cm-line"><br></div><div class="cm-line">Purpose:</div><div class="cm-line">- Verify integrity of input/output files</div><div class="cm-line">- Track reproducibility across runs</div><div class="cm-line"><br></div><div class="cm-line">Inputs:</div><div class="cm-line">- File paths, metadata dicts</div><div class="cm-line"><br></div><div class="cm-line">Outputs:</div><div class="cm-line">- Manifest dictionary</div><div class="cm-line">- Optional JSON file</div><div class="cm-line"><br></div><div class="cm-line">Testing Focus:</div><div class="cm-line">- Correct hash generation</div><div class="cm-line">- Metadata completeness</div><div class="cm-line">"""</div><div class="cm-line">from __future__ import annotations</div><div class="cm-line">import hashlib</div><div class="cm-line">import json</div><div class="cm-line">import os</div><div class="cm-line">from datetime import datetime</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">def compute_sha256(file_path: str) -&gt; str:</div><div class="cm-line">    sha256 = hashlib.sha256()</div><div class="cm-line">    with open(file_path, 'rb') as f:</div><div class="cm-line">        for chunk in iter(lambda: f.read(4096), b''):</div><div class="cm-line">            sha256.update(chunk)</div><div class="cm-line">    return sha256.hexdigest()</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">def generate_manifest(file_paths: list[str], metadata: dict = None) -&gt; dict:</div><div class="cm-gap" style="height: 350px;"></div></div></div></div></div></div></div></div></section></section></div></div></div></div><div data-message-author-role="assistant" data-message-id="3f19577e-bd0f-4296-9fb6-41f7d4533f36" dir="auto" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal [.text-message+&amp;]:mt-1" data-message-model-sl