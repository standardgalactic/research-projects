9 7.03247 8.61165L7.13696 8.69661L9.33521 10.8949V3.33333Z"></path></svg></button></span></span><span class="hidden sm:block"><button class="flex items-center gap-1 py-1 ps-1.5 pe-2.5 select-none disabled:cursor-not-allowed disabled:opacity-50">Download</button></span></div><div class="hover:text-token-text-primary"><button class="btn relative btn-primary -my-1 -me-3 flex items-center gap-1 py-1 select-none"><div class="flex items-center justify-center"><span class="" data-state="closed"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="block sm:hidden"><path d="M6 14.7229V5.27708C6 4.29072 7.08894 3.69295 7.9211 4.22251L15.3428 8.94541C16.1147 9.43661 16.1147 10.5634 15.3428 11.0546L7.92109 15.7775C7.08894 16.307 6 15.7093 6 14.7229Z"></path></svg></span><span class="hidden sm:block">Run code</span></div></button></div></div></div></div><div class="relative flex min-h-0 w-full flex-1 flex-col self-end"><div class="relative flex min-h-0 flex-auto flex-col overflow-hidden border-t transition-colors border-transparent"><section class="popover flex h-full w-full flex-col bg-transparent"><section class="relative flex min-h-0 flex-auto grow flex-col overflow-hidden"><div class="block h-auto"><div class="flex justify-start h-full" style="margin: 0px 16px;"><div class="relative z-0 flex h-full max-w-full"><div id="codemirror" class="_codemirror_hsqxh_1 _preview_hsqxh_26 z-10 flex h-full w-full flex-col items-stretch" style="width: 0px;"><div class="cm-editor Í¼1 Í¼2 Í¼13 Í¼14 Í¼12"><div class="cm-announced" aria-live="polite"></div><div tabindex="-1" class="cm-scroller" data-aria-hidden="true" aria-hidden="true"><div spellcheck="false" autocorrect="off" autocapitalize="off" translate="no" contenteditable="false" style="tab-size: 4;" class="cm-content" role="textbox" aria-multiline="true" aria-readonly="true"><div class="cm-line">"""</div><div class="cm-line">derived_geometry.py</div><div class="cm-line"><br></div><div class="cm-line">Derived geometry utilities for the RSVP Analysis Suite (RAS).</div><div class="cm-line">Includes:</div><div class="cm-line">- basic support for derived bundles (vector bundles, scalar bundles)</div><div class="cm-line">- derived fiber products (toy examples with arrays/matrices)</div><div class="cm-line">- computation of (-1)-shifted symplectic forms on discrete fields</div><div class="cm-line">- obstruction detection for singularities in field tilings</div><div class="cm-line">- linearized curvature and topological invariants (simplified)</div><div class="cm-line"><br></div><div class="cm-line">This module is a starting point for integrating RSVP theory with derived geometric methods.</div><div class="cm-line">"""</div><div class="cm-line">from __future__ import annotations</div><div class="cm-line">from typing import Tuple, Optional</div><div class="cm-line"><br></div><div class="cm-line">import numpy as np</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line"># ----------------------------- Vector bundle helpers -----------------------------</div><div class="cm-line"><br></div><div class="cm-line">def create_vector_bundle(base_shape: Tuple[int, ...], fiber_dim: int) -&gt; np.ndarray:</div><div class="cm-line">    """Create a discrete vector bundle over a regular base grid."""</div><div class="cm-line">    return np.zeros(base_shape + (fiber_dim,))</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">def fiber_dot(bundle1: np.ndarray, bundle2: np.ndarray) -&gt; np.ndarray:</div><div class="cm-line">    """Pointwise dot product over fibers."""</div><div class="cm-line">    return np.sum(bundle1 * bundle2, axis=-1)</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">def fiber_norm(bundle: np.ndarray) -&gt; np.ndarray:</div><div class="cm-line">    return np.sqrt(fiber_dot(bundle, bundle))</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line"># ----------------------------- Derived fiber product (toy) -----------------------------</div><div class="cm-gap" style="height: 896px;"></div></div></div></div></div></div></div></div></section></section></div></div></div></div><div data-message-author-role="assistant" data-message-id="c4953b9b-fa25-4ed9-b641-dbdb6fd4eb79" dir="auto" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal [.text-message+&amp;]:mt-1" data-message-model-slug="gpt-5-mini" data-aria-hidden="true" aria-hidden="true"><div class="flex w-full flex-col gap-1 empty:hidden first:pt-[1px]"><div class="markdown prose dark:prose-invert w-full break-words dark markdown-new-styling"><p data-start="0" data-end="191">âœ… Created <strong data-start="10" data-end="35"><code data-start="12" data-end="33">derived_geometry.py</code></strong> â€” includes vector bundle helpers, derived fiber products, (-1)-shifted symplectic forms, singularity detection, and simple curvature/topological proxies.</p>
