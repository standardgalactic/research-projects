opy production Î£Ì‡ is computed correctly over runtime.</div><div class="cm-line">"""</div><div class="cm-line"><br></div><div class="cm-line">import numpy as np</div><div class="cm-line">from simulation.entropy_balance import run_entropy_balance</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">def test_entropy_balance():</div><div class="cm-line">    lattice_size = 16</div><div class="cm-line">    n_steps = 50</div><div class="cm-line">    dt = 0.01</div><div class="cm-line"><br></div><div class="cm-line">    Phi = np.random.rand(lattice_size, lattice_size)</div><div class="cm-line">    V = np.random.rand(lattice_size, lattice_size, 2)</div><div class="cm-line">    S = np.random.rand(lattice_size, lattice_size)</div><div class="cm-line"><br></div><div class="cm-line">    Sigma_dot_history, S_final = run_entropy_balance(Phi, V, S, dt=dt, n_steps=n_steps)</div><div class="cm-line"><br></div><div class="cm-line">    integrated_Sigma_dot = np.sum(Sigma_dot_history) * dt</div><div class="cm-line">    # Placeholder: check that integrated Î£Ì‡ is finite and positive</div><div class="cm-line">    assert integrated_Sigma_dot &gt; 0, f"Integrated Î£Ì‡ invalid: {integrated_Sigma_dot}"</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">if __name__ == '__main__':</div><div class="cm-line">    test_entropy_balance()</div><div class="cm-line">    print('Entropy balance test passed.')</div><div class="cm-line"><br></div></div></div></div></div></div></div></div></section></section></div></div></div></div><div data-message-author-role="assistant" data-message-id="4795dc21-d352-448d-94d9-82df4cca6bed" dir="auto" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal [.text-message+&amp;]:mt-1" data-message-model-slug="gpt-5-mini" data-aria-hidden="true" aria-hidden="true"><div class="flex w-full flex-col gap-1 empty:hidden first:pt-[1px]"><div class