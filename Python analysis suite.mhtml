button class="flex items-center gap-1 py-1 ps-1.5 pe-2.5 select-none disabled:cursor-not-allowed disabled:opacity-50">Download</button></span></div><div class="hover:text-token-text-primary"><button class="btn relative btn-primary -my-1 -me-3 flex items-center gap-1 py-1 select-none"><div class="flex items-center justify-center"><span class="" data-state="closed"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="block sm:hidden"><path d="M6 14.7229V5.27708C6 4.29072 7.08894 3.69295 7.9211 4.22251L15.3428 8.94541C16.1147 9.43661 16.1147 10.5634 15.3428 11.0546L7.92109 15.7775C7.08894 16.307 6 15.7093 6 14.7229Z"></path></svg></span><span class="hidden sm:block">Run code</span></div></button></div></div></div></div><div class="relative flex min-h-0 w-full flex-1 flex-col self-end"><div class="relative flex min-h-0 flex-auto flex-col overflow-hidden border-t transition-colors border-transparent"><section class="popover flex h-full w-full flex-col bg-transparent"><section class="relative flex min-h-0 flex-auto grow flex-col overflow-hidden"><div class="block h-auto"><div class="flex justify-start h-full" style="margin: 0px 16px;"><div class="relative z-0 flex h-full max-w-full"><div id="codemirror" class="_codemirror_hsqxh_1 _preview_hsqxh_26 z-10 flex h-full w-full flex-col items-stretch" style="width: 0px;"><div class="cm-editor Í¼1 Í¼2 Í¼13 Í¼14 Í¼12"><div class="cm-announced" aria-live="polite"></div><div tabindex="-1" class="cm-scroller" data-aria-hidden="true" aria-hidden="true"><div spellcheck="false" autocorrect="off" autocapitalize="off" translate="no" contenteditable="false" style="tab-size: 4;" class="cm-content" role="textbox" aria-multiline="true" aria-readonly="true"><div class="cm-line">"""</div><div class="cm-line">Stats Utilities</div><div class="cm-line"><br></div><div class="cm-line">Provides Lyapunov proxies, Wasserstein distances, and entropy gradient computations for RSVP field analysis.</div><div class="cm-line">"""</div><div class="cm-line"><br></div><div class="cm-line">import numpy as np</div><div class="cm-line">from scipy.stats import wasserstein_distance</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">def lyapunov_proxy(field_t0, field_t1, dt=0.01):</div><div class="cm-line">    """Estimate a simple Lyapunov exponent proxy from two timesteps."""</div><div class="cm-line">    delta = np.linalg.norm(field_t1 - field_t0)</div><div class="cm-line">    return np.log(delta / (np.linalg.norm(field_t0) + 1e-8)) / dt</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">def compute_wasserstein(field1, field2):</div><div class="cm-line">    """Compute Wasserstein distance between flattened fields."""</div><div class="cm-line">    return wasserstein_distance(field1.ravel(), field2.ravel())</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">def entropy_gradient(S, axis=None):</div><div class="cm-line">    """Compute numerical gradient of entropy field S along given axis."""</div><div class="cm-line">    return np.gradient(S, axis=axis)</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">if __name__ == '__main__':</div><div class="cm-line">    # Demo usage</div><div class="cm-line">    field_a = np.random.rand(16,16)</div><div class="cm-line">    field_b = field_a + 0.01*np.random.randn(16,16)</div><div class="cm-line">    S = np.random.rand(16,16)</div><div class="cm-line"><br></div><div class="cm-line">    lyap = lyapunov_proxy(field_a, field_b)</div><div class="cm-line">    wass = compute_wasserstein(field_a, field_b)</div><div class="cm-line">    grad_S = entropy_gradient(S)</div><div class="cm-line"><br></div><div class="cm-gap" style="height: 56px;"></div></div></div></div></div></div></div></div></section></section></div></div></div></div><div data-message-author-role="assistant" data-message-id="b9eecd4b