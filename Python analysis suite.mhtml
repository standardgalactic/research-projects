<br></div><div class="cm-line">Computes entropy-production metrics and growth dynamics for simulated RSVP Tech Tree civilizations.</div><div class="cm-line">Tracks progression, collapse risk, and resource-entropy coupling.</div><div class="cm-line">"""</div><div class="cm-line"><br></div><div class="cm-line">import numpy as np</div><div class="cm-line">from utils.logging_utils import log_event</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">def initialize_civilization(size=16, seed=None):</div><div class="cm-line">    """Initialize tech/resource state matrices."""</div><div class="cm-line">    if seed is not None:</div><div class="cm-line">        np.random.seed(seed)</div><div class="cm-line">    tech_level = np.random.randint(1, 5, size=(size, size))  # arbitrary tech tiers</div><div class="cm-line">    resources = np.random.rand(size, size)  # normalized resource availability</div><div class="cm-line">    return tech_level, resources</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">def compute_entropy_production(tech_level, resources, lam=1.0):</div><div class="cm-line">    """Compute Î£Ì‡ ~ Î» * resource usage weighted by tech level."""</div><div class="cm-line">    return lam * np.sum(resources * tech_level)</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">def update_tech(tech_level, resources, growth_rate=0.1):</div><div class="cm-line">    """Simulate one timestep of civilization tech growth."""</div><div class="cm-line">    delta = growth_rate * (resources / (resources.max() + 1e-8))</div><div class="cm-line">    tech_level = tech_level + delta</div><div class="cm-line">    return np.clip(tech_level, 0, None)</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">def run_civilization_simulation(steps=50, size=16, lam=1.0, seed=None, log_file=None):</div><div class="cm-line">    tech_level, resources = initialize_civilization(size=size, seed=seed)</div><div class="cm-line">    entropy_history = []</div><div class="cm-line"><br></div><div class="cm-gap" style="height: 364px;"></div></div></div></div></div></div></div></div></section></section></div></div></div></div><div data-message-author-role="assistant" data-message-id="de05b7e6-1ee3-4922-b170-ec4b57a825a2" dir="auto" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal [.text-message+&amp;]:mt-1" data-message-model-slug="gpt-5-mini" data-aria-hidden="true" aria-hidden="true"><div class="flex w-full flex-col gap-1 empty:hidden first:pt-[1px]"><div class="markdown prose dark:prose-invert w-full break-words dark markdown-new-styling"><p data-start="0" data-end="146">âœ… Created <strong data-start="10" data-end="40"><code data-start="12" data-end="38">civilization_dynamics.py</code></strong> â€” includes tech/resource initialization, entropy production, timestep updates, logging, and a demo run.</p>
