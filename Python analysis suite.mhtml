block"><button class="flex items-center gap-1 py-1 ps-1.5 pe-2.5 select-none disabled:cursor-not-allowed disabled:opacity-50">Download</button></span></div><div class="hover:text-token-text-primary"><button class="btn relative btn-primary -my-1 -me-3 flex items-center gap-1 py-1 select-none"><div class="flex items-center justify-center"><span class="" data-state="closed"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="block sm:hidden"><path d="M6 14.7229V5.27708C6 4.29072 7.08894 3.69295 7.9211 4.22251L15.3428 8.94541C16.1147 9.43661 16.1147 10.5634 15.3428 11.0546L7.92109 15.7775C7.08894 16.307 6 15.7093 6 14.7229Z"></path></svg></span><span class="hidden sm:block">Run code</span></div></button></div></div></div></div><div class="relative flex min-h-0 w-full flex-1 flex-col self-end"><div class="relative flex min-h-0 flex-auto flex-col overflow-hidden border-t transition-colors border-transparent"><section class="popover flex h-full w-full flex-col bg-transparent"><section class="relative flex min-h-0 flex-auto grow flex-col overflow-hidden"><div class="block h-auto"><div class="flex justify-start h-full" style="margin: 0px 16px;"><div class="relative z-0 flex h-full max-w-full"><div id="codemirror" class="_codemirror_hsqxh_1 _preview_hsqxh_26 z-10 flex h-full w-full flex-col items-stretch" style="width: 0px;"><div class="cm-editor Í¼1 Í¼2 Í¼13 Í¼14 Í¼12"><div class="cm-announced" aria-live="polite"></div><div tabindex="-1" class="cm-scroller" data-aria-hidden="true" aria-hidden="true"><div spellcheck="false" autocorrect="off" autocapitalize="off" translate="no" contenteditable="false" style="tab-size: 4;" class="cm-content" role="textbox" aria-multiline="true" aria-readonly="true"><div class="cm-line">"""</div><div class="cm-line">Phase Transition Map Analysis</div><div class="cm-line"><br></div><div class="cm-line">Generates 2D/3D bifurcation plots over (Phi, S, lambda) for RSVP field simulations.</div><div class="cm-line">"""</div><div class="cm-line"><br></div><div class="cm-line">import numpy as np</div><div class="cm-line">import matplotlib.pyplot as plt</div><div class="cm-line">from mpl_toolkits.mplot3d import Axes3D</div><div class="cm-line">from utils.logging_utils import log_event</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">def generate_phase_data(phi_values, s_values, lambda_values, n_steps=50, growth_rate=0.1):</div><div class="cm-line">    """Simulate simple phase evolution for each parameter combination."""</div><div class="cm-line">    phase_data = []</div><div class="cm-line">    for lam in lambda_values:</div><div class="cm-line">        for phi in phi_values:</div><div class="cm-line">            for s in s_values:</div><div class="cm-line">                # Simple model: Phi and S evolve linearly with lambda and growth_rate</div><div class="cm-line">                phi_final = phi + growth_rate * lam * n_steps</div><div class="cm-line">                s_final = s + growth_rate * lam * n_steps / 2</div><div class="cm-line">                phase_data.append((phi, s, lam, phi_final, s_final))</div><div class="cm-line">    return np.array(phase_data)</div><div class="cm-line"><br></div><div class="cm-line"><br></div><div class="cm-line">def plot_phase_transition(phase_data, show_plot=True):</div><div class="cm-line">    """Plot 3D bifurcation map."""</div><div class="cm-line">    fig = plt.figure(figsize=(10,7))</div><div class="cm-line">    ax = fig.add_subplot(111, projection='3d')</div><div class="cm-line">    phi = phase_data[:,0]</div><div class="cm-line">    s = phase_data[:,1]</div><div class="cm-line">    lam = phase_data[:,2]</div><div class="cm-line">    phi_final = phase_data[:,3]</div><div class="cm-line"><br></div><div class="cm-line">    scatter = ax.scatter(phi, s, lam, c=phi_final, cmap='viridis')</div><div class="cm-line">    ax.set_xlabel('Phi initial')</div><div class="cm-gap" style="hei