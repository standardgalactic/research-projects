b-3! border-0 border-t sm:mx-[1px]"><div class="writing-block-editor relative px-4 sm:px-5"><div contenteditable="true" aria-disabled="false" translate="no" class="ProseMirror markdown prose dark:prose-invert w-full min-h-6 break-words focus:outline-none"><p><span>import unittest</span><br><span>import numpy as np</span><br><span>from data_viz import plot_scalar_field, plot_vector_field, plot_time_series, plot_surface</span></p><p><span>class DataVizTests(unittest.TestCase):</span><br><span>def setUp(self):</span><br><span>self.N = 16</span><br><span>x = np.linspace(0, 1, self.N)</span><br><span>self.X, self.Y = np.meshgrid(x, x, indexing='ij')</span><br><span>self.field = np.sin(2</span><em><span>np.pi</span></em><span>self.X)</span><em><span>np.cos(2</span></em><span>np.pi*self.Y)</span><br><span>self.vx = self.Y</span><br><span>self.vy = -self.X</span><br><span>self.times = np.linspace(0,1,10)</span><br><span>self.values = np.sin(self.times)</span></p><pre><code><span>def test_plot_scalar_field_runs(self):
    plot_scalar_field(self.field, show=False)

def test_plot_vector_field_runs(self):
    plot_vector_field(self.vx, self.vy, stride=2, show=False)

def test_plot_time_series_runs(self):
    plot_time_series(self.times, self.values, show=False)

def test_plot_surface_runs(self):
    plot_surface(self.field, show=False)</span></code></pre><p><span>if </span><strong><span>name</span></strong><span> == "</span><strong><span>main</span></strong><span>":</span><br><span>unittest.main()</span></p></div><div aria-hidden="true" class="pointer-events-none invisible fixed start-0 top-0 h-0 overflow-clip"><div><div role="toolbar" aria-orientation="horizontal" dir="ltr" class="bg-token-main-surface-primary m-0 flex h-9 w-fit min-w-0 shrink items-center overflow-hidden rounded-xl px-1 dark:bg-[#353535] shadow-[0_8px_12px_0_rgba(0,0,0,0.16),0_0_1px_0_rgba(0,0,0,0.60)] dark:shadow-[0_8px_16px_0_rgba(0,0,0,0.40),inset_0_0_1px_0_rgba(255,255,255,0.25),0_0_1px_0_rgba(0,0,0,0.60)] py-1" tabindex="0" data-orientation="horizontal" style="outline: none;"><button type="button" aria-label="Bold" class="flex h-full items-center rounded-lg gap-1 px-2 hover:bg-black/5 dark:hover:bg-token-interactive-bg-secondary-hover disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-transparent" tabindex="-1" data-orientation="horizontal" data-radix-collection-item=""><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="icon-sm text-token-text-primary"><path d="M4.91463 13.3C4.2134 13.3 3.80005 12.874 3.80005 12.1394V3.8533C3.80005 3.12606 4.2134 2.70001 4.91463 2.70001H8.43555C10.4359 2.70001 11.6908 3.72108 11.6908 5.3445C11.6908 6.50515 10.8197 7.47479 9.69038 7.64375V7.70252C11.1372 7.8127 12.2 8.86315 12.2 10.2662C12.2 12.1321 10.7902 13.3 8.51674 13.3H4.91463ZM6.02923 7.1075H7.63098C8.81939 7.1075 9.49847 6.58595 9.49847 5.68976C9.49847 4.83764 8.90058 4.35282 7.8598 4.35282H6.02923V7.1075ZM6.02923 11.6472H7.94838C9.23274 11.6472 9.92662 11.1036 9.92662 10.0899C9.92662 9.09822 9.2106 8.56932 7.89671 8.56932H6.02923V11.6472Z"></path></svg></button><button type="button" aria-label="Italic" class="flex h-full items-center rounded-lg gap-1 px-2 hover:bg-black/5 dark:hover:bg-token-interactive-bg-secondary-hov