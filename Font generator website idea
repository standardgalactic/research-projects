  </span><span><span class="hljs-keyword">const</span></span><span> thresh = </span><span><span class="hljs-keyword">new</span></span><span> cv.</span><span><span class="hljs-title class_">Mat</span></span><span>();
  cv.</span><span><span class="hljs-title function_">threshold</span></span><span>(gray, thresh, </span><span><span class="hljs-number">127</span></span><span>, </span><span><span class="hljs-number">255</span></span><span>, cv.</span><span><span class="hljs-property">THRESH_BINARY</span></span><span>);
  </span><span><span class="hljs-keyword">const</span></span><span> contours = </span><span><span class="hljs-keyword">new</span></span><span> cv.</span><span><span class="hljs-title class_">MatVector</span></span><span>(), hierarchy = </span><span><span class="hljs-keyword">new</span></span><span> cv.</span><span><span class="hljs-title class_">Mat</span></span><span>();
  cv.</span><span><span class="hljs-title function_">findContours</span></span><span>(thresh, contours, hierarchy, cv.</span><span><span class="hljs-property">RETR_EXTERNAL</span></span><span>, cv.</span><span><span class="hljs-property">CHAIN_APPROX_SIMPLE</span></span><span>);

  </span><span><span class="hljs-comment">// Pick 4 largest squares</span></span><span>
  </span><span><span class="hljs-keyword">const</span></span><span> corners = [];
  </span><span><span class="hljs-keyword">for</span></span><span> (</span><span><span class="hljs-keyword">let</span></span><span> i = </span><span><span class="hljs-number">0</span></span><span>; i &lt; contours.</span><span><span class="hljs-title function_">size</span></span><span>(); i++) {
