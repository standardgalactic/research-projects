    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">label</span></span></span><span>&gt;Tech Cost </span><span><span class="hljs-tag">&lt;<span class="hljs-name">input</span></span></span><span> </span><span><span class="hljs-attr">id</span></span><span>=</span><span><span class="hljs-string">"techCost"</span></span><span> </span><span><span class="hljs-attr">type</span></span><span>=</span><span><span class="hljs-string">"number"</span></span><span> </span><span><span class="hljs-attr">value</span></span><span>=</span><span><span class="hljs-string">"150"</span></span><span> </span><span><span class="hljs-attr">min</span></span><span>=</span><span><span class="hljs-string">"50"</span></span><span> </span><span><span class="hljs-attr">max</span></span><span>=</span><span><span class="hljs-string">"500"</span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">label</span></span></span><span>&gt;
