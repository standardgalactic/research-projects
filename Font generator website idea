@media(max-width:900px){ .grid2, .grid3 { grid-template-columns: 1fr; } }
&lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
  &lt;h1&gt;╔═ Xenobot Swarm Simulator — RSVP Field v2.0 (Research) ═══════════╗&lt;/h1&gt;
  &lt;div class="panel grid2"&gt;
    &lt;div&gt;
      &lt;div class="row"&gt;
