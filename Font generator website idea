def random_name(min_len=5, max_len=0):
    word = ''
    while True:
        prev = 'Start' if not word else word[-1].upper()
        nxt = pick_next(prev)
        if (not nxt and len(word) &gt;= min_len) or (max_len and len(word) &gt;= max_len):
            break
        word += nxt.lower()
        if not nxt:
            break
    return word.capitalize()

