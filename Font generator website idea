        out.append(row)
    </span><span><span class="hljs-keyword">with</span></span><span> </span><span><span class="hljs-built_in">open</span></span><span>(path, </span><span><span class="hljs-string">"w"</span></span><span>, encoding=</span><span><span class="hljs-string">"utf-8"</span></span><span>) </span><span><span class="hljs-keyword">as</span></span><span> f:
        f.write(</span><span><span class="hljs-string">"\n"</span></span><span>.join(out))
    </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">f"[<span class="hljs-subst">{datetime.now()}</span></span></span><span>] Grid written to </span><span><span class="hljs-subst">{path}</span></span><span>")

</span><span><span class="hljs-keyword">if</span></span><span> __name__ == </span><span><span class="hljs-string">"__main__"</span></span><span>:
