  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"small"</span></span><span>&gt;
    Fitness = food − λ·∫S; Evolvable: coh, sep, ali, expl, R, v_max, metab
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">canvas</span></span></span><span> </span><span><span class="hljs-attr">id</span></span><span>=</span><span><span class="hljs-string">"cv"</span></span><span> </span><span><span class="hljs-attr">width</span></span><span>=</span><span><span class="hljs-string">"960"</span></span><span> </span><span><span class="hljs-attr">height</span></span><span>=</span><span><span class="hljs-string">"540"</span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">canvas</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"stats"</span></span><span> </span><span><span class="hljs-attr">id</span></span><span>=</span><span><span class="hljs-string">"stats"</span></span><span>&gt;gen=0 t=0.0s best=0 avg=0 entropy=0</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
