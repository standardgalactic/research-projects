</span><span><span class="hljs-keyword">import</span></span><span> os, random, string
</span><span><span class="hljs-keyword">from</span></span><span> datetime </span><span><span class="hljs-keyword">import</span></span><span> datetime

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">make_grid</span></span><span>(</span><span><span class="hljs-params">path=<span class="hljs-string">"font_grid.txt"</span></span></span><span>, cols=</span><span><span class="hljs-number">16</span></span><span>, rows=</span><span><span class="hljs-number">16</span></span><span>):
