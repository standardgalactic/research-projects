    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">label</span></span></span><span>&gt;Metabolism </span><span><span class="hljs-tag">&lt;<span class="hljs-name">input</span></span></span><span> </span><span><span class="hljs-attr">id</span></span><span>=</span><span><span class="hljs-string">"metab"</span></span><span> </span><span><span class="hljs-attr">type</span></span><span>=</span><span><span class="hljs-string">"range"</span></span><span> </span><span><span class="hljs-attr">min</span></span><span>=</span><span><span class="hljs-string">"0.5"</span></span><span> </span><span><span class="hljs-attr">max</span></span><span>=</span><span><span class="hljs-string">"2"</span></span><span> </span><span><span class="hljs-attr">value</span></span><span>=</span><span><span class="hljs-string">"1"</span></span><span> </span><span><span class="hljs-attr">step</span></span><span>=</span><span><span class="hljs-string">"0.1"</span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">label</span></span></span><span>&gt;
