        a2 = </span><span><span class="hljs-number">2</span></span><span> * math.pi * (i + </span><span><span class="hljs-number">1</span></span><span>) / complexity
        r1 = r * (</span><span><span class="hljs-number">1</span></span><span> + random.uniform(-jitter, jitter))
        r2 = r * (</span><span><span class="hljs-number">1</span></span><span> + random.uniform(-jitter, jitter))
        x1, y1 = cx + r1 * math.cos(a1), cy + r1 * math.sin(a1)
        x2, y2 = cx + r2 * math.cos(a2), cy + r2 * math.sin(a2)
        </span><span><span class="hljs-keyword">if</span></span><span> i == </span><span><span class="hljs-number">0</span></span><span>:
