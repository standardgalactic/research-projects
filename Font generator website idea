        path.line_to(x2, y2)
    path.close_path()
    </span><span><span class="hljs-keyword">return</span></span><span> Glyph(name=</span><span><span class="hljs-string">f"uni<span class="hljs-subst">{<span class="hljs-built_in">ord</span></span></span></span><span>(char):04X}", unicode=</span><span><span class="hljs-built_in">ord</span></span><span>(char), advance_width=size * </span><span><span class="hljs-number">0.6</span></span><span>, path=path)

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">main</span></span><span>():
