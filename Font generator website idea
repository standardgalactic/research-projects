</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">make_random_glyph</span></span><span>(</span><span><span class="hljs-params">char, size=<span class="hljs-number">1000</span></span></span><span>, complexity=</span><span><span class="hljs-number">12</span></span><span>, jitter=</span><span><span class="hljs-number">0.2</span></span><span>):
    path = Path()
    cx, cy = size / </span><span><span class="hljs-number">2</span></span><span>, size / </span><span><span class="hljs-number">2</span></span><span>
    r = size * </span><span><span class="hljs-number">0.35</span></span><span>
    </span><span><span class="hljs-keyword">for</span></span><span> i </span><span><span class="hljs-keyword">in</span></span><span> </span><span><span class="hljs-built_in">range</span></span><span>(complexity):
