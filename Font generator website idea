</span><span><span class="hljs-keyword">async</span></span><span> </span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">autoDeskew</span></span><span>(</span><span><span class="hljs-params"></span></span><span>) {
