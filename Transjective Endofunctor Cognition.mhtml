</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">fig_vectorflow</span></span><span>():
    x = np.linspace(-</span><span><span class="hljs-number">3</span></span><span>, </span><span><span class="hljs-number">3</span></span><span>, </span><span><span class="hljs-number">200</span></span><span>)
    y = np.linspace(-</span><span><span class="hljs-number">3</span></span><span>, </span><span><span class="hljs-number">3</span></span><span>, </span><span><span class="hljs-number">200</span></span><span>)
    X, Y = np.meshgrid(x, y)
    Vx, Vy = -Y*np.exp(-(X**</span><span><span class="hljs-number">2</span></span><span>+Y**</span><span><span class="hljs-number">2</span></span><span>)/</span><span><span class="hljs-number">4</span></span><span>), X*np.exp(-(X**</span><span><span class="hljs-number">2</span></span><span>+Y**</span><span><span class="hljs-number">2</span></span><span>)/</span><span><span class="hljs-number">4</span></span><span>)
    plt.figure(figsize=(</span><span><span class="hljs-number">5</span></span><span>, </span><span><span class="hljs-number">5</span></span><span>))
    plt.streamplot(X, Y, Vx, Vy, color=np.hypot(Vx, Vy))
    plt.axis(</span><span><span class="hljs-string">"off"</span></span><span>)
    plt.tight_layout()
    plt.savefig(FIG_DIR / </span><span><span class="hljs-string">"fig_vectorflow.pdf"</span></span><span>)
    plt.close()

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">fig_entropy</span></span><span>():
    x = np.linspace(-</span><span><span class="hljs-number">2</span></span><span>, </span><span><span class="hljs-number">2</span></span><span>, </span><span><span class="hljs-number">200</span></span><span>)
    y = np.linspace(-</span><span><span class="hljs-number">2</span></span><span>, </span><span><span class="hljs-number">2</span></span><span>, </span><span><span class="hljs-number">200</span></span><span>)
    X, Y = np.meshgrid(x, y)
    S = np.log1p(np.exp(-X**</span><span><span class="hljs-number">2</span></span><span> - Y**</span><span><span class="hljs-number">2</span></span><span>))
    fig = plt.figure(figsize=(</span><span><span class="hljs-number">5</span></span><span>, </span><span><span class="hljs-number">4</span></span><span>))
    ax = fig.add_subplot(</span><span><span class="hljs-number">111</span></span><span>, projection=</span><span><span class="hljs-string">"3d"</span></span><span>)
    ax.plot_surface(X, Y, S, rstride=</span><span><span class="hljs-number">10</span></span><span>, cstride=</span><span><span class="hljs-number">10</span></span><span>, cmap=</span><span><span class="hljs-string">"viridis"</span></span><span>)
    plt.tight_layout()
    plt.savefig(FIG_DIR / </span><span><span class="hljs-string">"fig_entropy.pdf"</span></span><span>)
    plt.close()

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">fig_autogeneration</span></span><span>():
    theta = np.linspace(</span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">2</span></span><span>*np.pi, </span><span><span class="hljs-number">400</span></span><span>)
    r = </span><span><span class="hljs-number">1</span></span><span> + </span><span><span class="hljs-number">0.2</span></span><span>*np.sin(</span><span><span class="hljs-number">6</span></span><span>*theta)
    plt.figure(figsize=(</span><span><span class="hljs-number">4</span></span><span>, </span><span><span class="hljs-number">4</span></span><span>))
    plt.polar(theta, r, linewidth=</span><span><span class="hljs-number">2</span></span><span>)
    plt.tight_layout()
    plt.savefig(FIG_DIR / </span><span><span class="hljs-string">"fig_autogeneration.pdf"</span></span><span>)
    plt.close()

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">main</span></span><span>():
    </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">f"[figuregen] Writing figures to <span class="hljs-subst">{FIG_DIR}</span></span></span><span>")
    fig_vectorflow()
    fig_entropy()
    fig_autogeneration()
    </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">"[figuregen] Done."</span></span><span>)

</span><span><span class="hljs-keyword">if</span></span><span> __name__ == </span><span><span class="hljs-string">"__main__"</span></span><span>:
    main()
