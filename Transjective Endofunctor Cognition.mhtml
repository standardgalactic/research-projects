</span><span><span class="hljs-tag">&lt;<span class="hljs-name">script</span></span></span><span>&gt;<span class="language-javascript">
</span></span><span><span class="hljs-keyword">async</span></span><span> </span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">loadManifest</span></span><span>(</span><span><span class="hljs-params"></span></span><span>) {
  </span><span><span class="hljs-keyword">try</span></span><span> {
    </span><span><span class="hljs-keyword">const</span></span><span> res = </span><span><span class="hljs-keyword">await</span></span><span> </span><span><span class="hljs-title function_">fetch</span></span><span>(</span><span><span class="hljs-string">'manifest.yaml'</span></span><span>);
    </span><span><span class="hljs-keyword">const</span></span><span> txt = </span><span><span class="hljs-keyword">await</span></span><span> res.</span><span><span class="hljs-title function_">text</span></span><span>();

    </span><span><span class="hljs-comment">// very small YAML parser for simple key:value pairs</span></span><span>
    </span><span><span class="hljs-keyword">const</span></span><span> data = {};
    txt.</span><span><span class="hljs-title function_">split</span></span><span>(</span><span><span class="hljs-string">'\n'</span></span><span>).</span><span><span class="hljs-title function_">forEach</span></span><span>(</span><span><span class="hljs-function"><span class="hljs-params">line</span></span></span><span> =&gt; {
      </span><span><span class="hljs-keyword">const</span></span><span> m = line.</span><span><span class="hljs-title function_">match</span></span><span>(</span><span><span class="hljs-regexp">/^([A-Za-z0-9_]+):\s*(.+)$/</span></span><span>);
      </span><span><span class="hljs-keyword">if</span></span><span> (m) data[m[</span><span><span class="hljs-number">1</span></span><span>]] = m[</span><span><span class="hljs-number">2</span></span><span>];
    });

    </span><span><span class="hljs-keyword">const</span></span><span> info = </span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">getElementById</span></span><span>(</span><span><span class="hljs-string">'info'</span></span><span>);
    info.</span><span><span class="hljs-property">innerHTML</span></span><span> = <span class="hljs-string">`
      &lt;ul&gt;
        &lt;li&gt;&lt;strong&gt;Version:&lt;/strong&gt; </span></span><span><span class="hljs-subst">${data.version || <span class="hljs-string">'—'</span></span></span><span>}&lt;/li&gt;
        &lt;li&gt;&lt;strong&gt;Updated:&lt;/strong&gt; </span><span><span class="hljs-subst">${data.updated || <span class="hljs-string">'—'</span></span></span><span>}&lt;/li&gt;
        &lt;li&gt;&lt;strong&gt;Maintainer:&lt;/strong&gt; </span><span><span class="hljs-subst">${data.maintainer || <span class="hljs-string">'—'</span></span></span><span>}&lt;/li&gt;
      &lt;/ul&gt;`;

    </span><span><span class="hljs-keyword">const</span></span><span> list = </span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">getElementById</span></span><span>(</span><span><span class="hljs-string">'artifactList'</span></span><span>);
    list.</span><span><span class="hljs-property">innerHTML</span></span><span> = <span class="hljs-string">`
      &lt;li&gt;&lt;a href="autogenerative_thesis.pdf"&gt;📄 Download latest PDF&lt;/a&gt;&lt;/li&gt;
      &lt;li&gt;&lt;a href="manifest.yaml"&gt;📜 View manifest.yaml&lt;/a&gt;&lt;/li&gt;`</span>;
  } </span><span><span class="hljs-keyword">catch</span></span><span> (err) {
    </span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">getElementById</span></span><span>(</span><span><span class="hljs-string">'info'</span></span><span>).</span><span><span class="hljs-property">textContent</span></span><span> = </span><span><span class="hljs-string">'Manifest not found.'</span></span><span>;
  }
}
</span><span><span class="hljs-title function_">loadManifest</span></span><span>();
