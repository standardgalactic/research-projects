</span><span><span class="hljs-attr">on:</span></span><span>
  </span><span><span class="hljs-attr">push:</span></span><span>
    </span><span><span class="hljs-attr">branches:</span></span><span> [ </span><span><span class="hljs-string">main</span></span><span> ]
  </span><span><span class="hljs-attr">workflow_dispatch:</span></span><span>

</span><span><span class="hljs-attr">permissions:</span></span><span>
  </span><span><span class="hljs-attr">contents:</span></span><span> </span><span><span class="hljs-string">write</span></span><span>
  </span><span><span class="hljs-attr">pages:</span></span><span> </span><span><span class="hljs-string">write</span></span><span>
  </span><span><span class="hljs-attr">id-token:</span></span><span> </span><span><span class="hljs-string">write</span></span><span>

</span><span><span class="hljs-attr">jobs:</span></span><span>
  </span><span><span class="hljs-attr">build:</span></span><span>
    </span><span><span class="hljs-attr">runs-on:</span></span><span> </span><span><span class="hljs-string">ubuntu-latest</span></span><span>
    </span><span><span class="hljs-attr">steps:</span></span><span>
      </span><span><span class="hljs-bullet">-</span></span><span> </span><span><span class="hljs-attr">name:</span></span><span> </span><span><span class="hljs-string">Checkout</span></span><span> </span><span><span class="hljs-string">repository</span></span><span>
        </span><span><span class="hljs-attr">uses:</span></span><span> </span><span><span class="hljs-string">actions/checkout@v4</span></span><span>

      </span><span><span class="hljs-comment">#-----------------------------------------------------------</span></span><span>
      </span><span><span class="hljs-comment"># Build inside Docker for deterministic TeX environment</span></span><span>
      </span><span><span class="hljs-comment">#-----------------------------------------------------------</span></span><span>
      </span><span><span class="hljs-bullet">-</span></span><span> </span><span><span class="hljs-attr">name:</span></span><span> </span><span><span class="hljs-string">Build</span></span><span> </span><span><span class="hljs-string">thesis</span></span><span> </span><span><span class="hljs-string">PDF</span></span><span>
        </span><span><span class="hljs-attr">run:</span></span><span> <span class="hljs-string">|
          docker build -t thesis-builder .
          docker run --rm -v "$PWD":/work thesis-builder bash -c \
            "cd /work/src &amp;&amp; latexmk -lualatex -shell-escape -outdir=../build main.tex"
</span>
      </span><span><span class="hljs-comment"># Optional permanent archive of the same artifact</span></span><span>
      </span><span><span class="hljs-bullet">-</span></span><span> </span><span><span class="hljs-attr">name:</span></span><span> </span><span><span class="hljs-string">Upload</span></span><span> </span><span><span class="hljs-string">artifact</span></span><span>
        </span><span><span class="hljs-attr">uses:</span></span><span> </span><span><span class="hljs-string">actions/upload-artifact@v4</span></span><span>
        </span><span><span class="hljs-attr">with:</span></span><span>
          </span><span><span class="hljs-attr">name:</span></span><span> </span><span><span class="hljs-string">autogenerative_thesis</span></span><span>
          </span><span><span class="hljs-attr">path:</span></span><span> </span><span><span class="hljs-string">build/main.pdf</span></span><span>

      </span><span><span class="hljs-comment">#-----------------------------------------------------------</span></span><span>
      </span><span><span class="hljs-comment"># Prepare public directory for GitHub Pages</span></span><span>
      </span><span><span class="hljs-comment">#-----------------------------------------------------------</span></span><span>
      </span><span><span class="hljs-bullet">-</span></span><span> </span><span><span class="hljs-attr">name:</span></span><span> </span><span><span class="hljs-string">Prepare</span></span><span> </span><span><span class="hljs-string">public</span></span><span> </span><span><span class="hljs-string">directory</span></span><span>
        </span><span><span class="hljs-attr">run:</span></span><span> <span class="hljs-string">|
          mkdir -p public
          cp build/main.pdf public/autogenerative_thesis.pdf
          cp manifest.yaml public/
          cp index.html public/
</span>
      </span><span><span class="hljs-comment">#-----------------------------------------------------------</span></span><span>
      </span><span><span class="hljs-comment"># Deploy to gh-pages branch (permanent site)</span></span><span>
      </span><span><span class="hljs-comment">#-----------------------------------------------------------</span></span><span>
      </span><span><span class="hljs-bullet">-</span></span><span> </span><span><span class="hljs-attr">name:</span></span><span> </span><span><span class="hljs-string">Deploy</span></span><span> </span><span><span class="hljs-string">to</span></span><span> </span><span><span class="hljs-string">GitHub</span></span><span> </span><span><span class="hljs-string">Pages</span></span><span>
        </span><span><span class="hljs-attr">uses:</span></span><span> </span><span><span class="hljs-string">peaceiris/actions-gh-pages@v4</span></span><span>
        </span><span><span class="hljs-attr">with:</span></span><span>
          </span><span><span class="hljs-attr">github_token:</span></span><span> </span><span><span class="hljs-string">${{</span></span><span> </span><span><span class="hljs-string">secrets.GITHUB_TOKEN</span></span><span> </span><span><span class="hljs-string">}}</span></span><span>
          </span><span><span class="hljs-attr">publish_dir:</span></span><span> </span><span><span class="hljs-string">./public</span></span><span>
          </span><span><span class="hljs-attr">publish_branch:</span></span><span> </span><span><span class="hljs-string">gh-pages</span></span><span>
</span></span></code></div></div></pre>
