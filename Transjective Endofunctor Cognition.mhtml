.mapboxgl-ctrl-bottom-right { bottom: 0px; right: 0px; }

.mapboxgl-ctrl-bottom { bottom: 0px; left: 50%; transform: translate(-50%); }

.mapboxgl-ctrl-bottom-left { bottom: 0px; left: 0px; }

