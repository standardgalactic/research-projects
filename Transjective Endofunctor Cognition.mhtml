</span><span><span class="hljs-keyword">\title</span></span><span>{</span><span><span class="hljs-keyword">\vspace</span></span><span>{-1em}</span><span><span class="hljs-keyword">\Huge</span></span><span><span class="hljs-keyword">\textbf</span></span><span>{Aspect Relegation Theory:</span><span><span class="hljs-keyword">\\</span></span><span>[4pt]
Gradient Quenching and Transjective Closure in Cognitive Systems}}
</span><span><span class="hljs-keyword">\author</span></span><span>{</span><span><span class="hljs-keyword">\large</span></span><span> Flyxion Research Group}
