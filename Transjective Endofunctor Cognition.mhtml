@keyframes fade-in { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.teleprompter { overflow: visible; position: relative; }

.teleprompter-inner { align-content: flex-start; display: flex; flex-wrap: wrap; inset: 0px; position: absolute; }

.teleprompter-word { animation: fade-in var(--fade,.5s) cubic-bezier(.37,.55,.86,.88) forwards; opacity: 0; white-space: pre; }

@keyframes dot-fade { 
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

.animate-dot-fade { animation: 1s ease-in-out 0s infinite normal none running dot-fade; }

._frostedContainer_1rwq4_1 { overflow: hidden; position: relative; width: 100%; }

._blurStack_1rwq4_8 { height: 5rem; inset: 0px; pointer-events: none; position: absolute; z-index: 5; }

._blur_1rwq4_8 { --frost: color-mix(in srgb,var(--bg-tertiary) 60%,transparent); backdrop-filter: blur(var(--blur,0)); background: linear-gradient(to bottom,var(--frost) 0,transparent var(--gradient-end,60%)); border-top-left-radius: 8px; border-top-right-radius: 8px; height: 100%; inset: 0px 0px auto; mask-image: linear-gradient(rgb(0, 0, 0) 60%, transparent); opacity: var(--alpha,.4); position: absolute; transform: translateZ(0px); will-change: backdrop-filter, opacity; }

._layer0_1rwq4_42 { --blur: .5px; --alpha: .65; --gradient-end: 25%; }

._layer1_1rwq4_47 { --blur: 2px; --alpha: .5; --gradient-end: 35%; }

._layer2_1rwq4_52 { --blur: 6px; --alpha: .38; --gradient-end: 50%; }

