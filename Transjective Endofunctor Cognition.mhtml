<span class="hljs-string">"""
Create a distributable zip containing LaTeX, scripts, and build files.
"""</span>
</span><span><span class="hljs-keyword">import</span></span><span> os, zipfile, hashlib
</span><span><span class="hljs-keyword">from</span></span><span> datetime </span><span><span class="hljs-keyword">import</span></span><span> datetime

root = </span><span><span class="hljs-string">"autogenerative-thesis"</span></span><span>
outzip = </span><span><span class="hljs-string">f"<span class="hljs-subst">{root}</span></span></span><span>-</span><span><span class="hljs-subst">{datetime.utcnow().strftime(<span class="hljs-string">'%Y%m%dT%H%M%SZ'</span></span></span><span>)}.zip"

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">sha256</span></span><span>(</span><span><span class="hljs-params">path</span></span><span>):
    h = hashlib.sha256()
    </span><span><span class="hljs-keyword">with</span></span><span> </span><span><span class="hljs-built_in">open</span></span><span>(path,</span><span><span class="hljs-string">"rb"</span></span><span>) </span><span><span class="hljs-keyword">as</span></span><span> f:
        </span><span><span class="hljs-keyword">for</span></span><span> chunk </span><span><span class="hljs-keyword">in</span></span><span> </span><span><span class="hljs-built_in">iter</span></span><span>(</span><span><span class="hljs-keyword">lambda</span></span><span>: f.read(</span><span><span class="hljs-number">8192</span></span><span>), </span><span><span class="hljs-string">b""</span></span><span>): h.update(chunk)
    </span><span><span class="hljs-keyword">return</span></span><span> h.hexdigest()[:</span><span><span class="hljs-number">16</span></span><span>]

</span><span><span class="hljs-keyword">with</span></span><span> zipfile.ZipFile(outzip,</span><span><span class="hljs-string">"w"</span></span><span>,zipfile.ZIP_DEFLATED) </span><span><span class="hljs-keyword">as</span></span><span> z:
    </span><span><span class="hljs-keyword">for</span></span><span> folder,_,files </span><span><span class="hljs-keyword">in</span></span><span> os.walk(root):
        </span><span><span class="hljs-keyword">for</span></span><span> f </span><span><span class="hljs-keyword">in</span></span><span> files:
            path = os.path.join(folder,f)
            arc = os.path.relpath(path,root)
            z.write(path,arcname=os.path.join(root,arc))
</span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">f"[zip_builder] Created <span class="hljs-subst">{outzip}</span></span></span><span> (</span><span><span class="hljs-subst">{sha256(outzip)}</span></span><span>)")
</span></span></code></div></div></pre>
