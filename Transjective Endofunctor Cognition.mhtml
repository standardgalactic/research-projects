<span class="hljs-string">"""
plot_figures.py — generate basic analytic visualizations for the monograph.
Produces publication-quality PDFs to figures/.
"""</span>

</span><span><span class="hljs-keyword">import</span></span><span> numpy </span><span><span class="hljs-keyword">as</span></span><span> np
</span><span><span class="hljs-keyword">import</span></span><span> matplotlib.pyplot </span><span><span class="hljs-keyword">as</span></span><span> plt
</span><span><span class="hljs-keyword">from</span></span><span> pathlib </span><span><span class="hljs-keyword">import</span></span><span> Path

FIG_DIR = Path(__file__).resolve().parents[</span><span><span class="hljs-number">1</span></span><span>] / </span><span><span class="hljs-string">"figures"</span></span><span>
FIG_DIR.mkdir(exist_ok=</span><span><span class="hljs-literal">True</span></span><span>)

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">savefig</span></span><span>(</span><span><span class="hljs-params">name</span></span><span>):
    plt.tight_layout()
    plt.savefig(FIG_DIR / </span><span><span class="hljs-string">f"<span class="hljs-subst">{name}</span></span></span><span>.pdf")
    plt.close()

</span><span><span class="hljs-comment"># 1. Ergodic entropy decay</span></span><span>
t = np.linspace(</span><span><span class="hljs-number">1</span></span><span>, </span><span><span class="hljs-number">1000</span></span><span>, </span><span><span class="hljs-number">500</span></span><span>)
corr = t ** -</span><span><span class="hljs-number">0.6</span></span><span>
plt.figure(figsize=(</span><span><span class="hljs-number">5</span></span><span>,</span><span><span class="hljs-number">3</span></span><span>))
plt.loglog(t, corr)
plt.title(</span><span><span class="hljs-string">"Polynomial Mixing in Relevance Decay"</span></span><span>)
plt.xlabel(</span><span><span class="hljs-string">"Lag (t)"</span></span><span>)
plt.ylabel(</span><span><span class="hljs-string">"Correlation"</span></span><span>)
savefig(</span><span><span class="hljs-string">"fig_ergodic_entropy"</span></span><span>)

</span><span><span class="hljs-comment"># 2. Infinity-category coherence sketch</span></span><span>
theta = np.linspace(</span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">2</span></span><span>*np.pi, </span><span><span class="hljs-number">200</span></span><span>)
x = np.cos(theta); y = np.sin(theta)
plt.figure(figsize=(</span><span><span class="hljs-number">4</span></span><span>,</span><span><span class="hljs-number">4</span></span><span>))
plt.plot(x, y, </span><span><span class="hljs-string">'k--'</span></span><span>, lw=</span><span><span class="hljs-number">1</span></span><span>)
plt.plot(x*</span><span><span class="hljs-number">0.7</span></span><span>, y*</span><span><span class="hljs-number">0.7</span></span><span>, </span><span><span class="hljs-string">'b'</span></span><span>)
plt.title(</span><span><span class="hljs-string">"∞-Categorical Coherence Surface"</span></span><span>)
plt.axis(</span><span><span class="hljs-string">'equal'</span></span><span>); plt.axis(</span><span><span class="hljs-string">'off'</span></span><span>)
savefig(</span><span><span class="hljs-string">"fig_infinity_coherence"</span></span><span>)

</span><span><span class="hljs-comment"># 3. Transjective functor diagram (abstract)</span></span><span>
plt.figure(figsize=(</span><span><span class="hljs-number">5</span></span><span>,</span><span><span class="hljs-number">3</span></span><span>))
plt.arrow(</span><span><span class="hljs-number">0.1</span></span><span>, </span><span><span class="hljs-number">0.5</span></span><span>, </span><span><span class="hljs-number">0.3</span></span><span>, </span><span><span class="hljs-number">0.0</span></span><span>, head_width=</span><span><span class="hljs-number">0.05</span></span><span>)
plt.arrow(</span><span><span class="hljs-number">0.9</span></span><span>, </span><span><span class="hljs-number">0.5</span></span><span>, -</span><span><span class="hljs-number">0.3</span></span><span>, </span><span><span class="hljs-number">0.0</span></span><span>, head_width=</span><span><span class="hljs-number">0.05</span></span><span>)
plt.text(</span><span><span class="hljs-number">0.25</span></span><span>, </span><span><span class="hljs-number">0.6</span></span><span>, </span><span><span class="hljs-string">"F"</span></span><span>, fontsize=</span><span><span class="hljs-number">14</span></span><span>)
plt.text(</span><span><span class="hljs-number">0.7</span></span><span>, </span><span><span class="hljs-number">0.6</span></span><span>, </span><span><span class="hljs-string">"G"</span></span><span>, fontsize=</span><span><span class="hljs-number">14</span></span><span>)
plt.text(</span><span><span class="hljs-number">0.1</span></span><span>, </span><span><span class="hljs-number">0.4</span></span><span>, </span><span><span class="hljs-string">"C₁"</span></span><span>, fontsize=</span><span><span class="hljs-number">12</span></span><span>)
plt.text(</span><span><span class="hljs-number">0.9</span></span><span>, </span><span><span class="hljs-number">0.4</span></span><span>, </span><span><span class="hljs-string">"C₂"</span></span><span>, fontsize=</span><span><span class="hljs-number">12</span></span><span>)
plt.title(</span><span><span class="hljs-string">"Transjective Endofunctor G∘F"</span></span><span>)
plt.axis(</span><span><span class="hljs-string">"off"</span></span><span>)
savefig(</span><span><span class="hljs-string">"fig_transjective_functor"</span></span><span>)

</span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">f"[✓] Figures written to <span class="hljs-subst">{FIG_DIR}</span></span></span><span>")
</span></span></code></div></div></pre>
