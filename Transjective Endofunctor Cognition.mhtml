<p data-start="4905" data-end="5167">part1_tex = r"""<br>
%======================================================================<br>
%  PART I — FOUNDATIONS (Extended Draft)<br>
%======================================================================<br>
\part{Foundations: Autogeneration, Memory, and Geometry}</p>
<p data-start="5171" data-end="5398">\section{Autogeneration}<br>
\label{sec:autogeneration}<br>
\textbf{Abstract.} We formalize autogeneration as an intrinsic continuation operator $\mathcal{T}:X^*\to\Delta(X)$ whose parameters are determined solely by corpus geometry.</p>
<p data-start="5402" data-end="5618">\begin{definition}[Autogenerative System]\label{def:autogen}<br>
A pair $(X,\mathcal{T})$ with token space $X$ and continuation map $\mathcal{T}:X^*!\to!\Delta(X)$ learned from sequential data alone.<br>
\end{definition}</p>
<p data-start="5622" data-end="5846">\begin{proposition}[Intrinsicity]<br>
If $E:\mathcal{V}\to\mathbb{R}^d$ is a corpus-trained embedding, the log-bilinear statistics satisfy $E(v_i)!\cdot!E(v_j)\approx \log\frac{P(v_i,v_j)}{P(v_i)P(v_j)}+c$.<br>
\end{proposition}</p>
<p data-start="5850" data-end="6303">\section{Non-Markovian Autoregression}<br>
\label{sec:nonmarkov}<br>
\begin{definition}[Non-Markovianity]<br>
A process with $P(x_{t+1}\mid x_{1:t})$ that cannot be reduced to any fixed $k$-order Markov kernel.<br>
\end{definition}<br>
\begin{theorem}[No Finite Window Suffices]<br>
For language distributions with power-law mutual information, no finite $k$ attains $\epsilon$-approximation of $P(x_{t+1}!\mid!x_{1:t})$ for arbitrarily small $\epsilon$.<br>
\end{theorem}</p>
<p data-start="6307" data-end="6744">\section{Trajectory Geometry}<br>
\label{sec:trajectory}<br>
Let $\phi:X^*!\to!\mathbb{R}^m$ embed prefixes; trajectories $\gamma_t=\phi(x_{1:t})$ form paths.<br>
\begin{definition}[Energy Functional]<br>
$\mathcal{E}[\gamma]=!\int_0^T|\dot\gamma|^2_g+V(\gamma),dt$ with Fisher metric $g$ and potential $V$.<br>
\end{definition}<br>
\begin{proposition}[Geodesic Principle]<br>
Minimizers of $\mathcal{E}$ give coherent continuations.<br>
\end{proposition}</p>
<p data-start="6748" data-end="7111">\section{Information Geometry}<br>
\label{sec:ig}<br>
Let $\mathcal{M}={P_\theta}$ be the manifold of conditionals with Fisher metric $g_{ij}=\mathbb{E}[\partial_i\log P_\theta,\partial_j\log P_\theta]$.<br>
\begin{theorem}[Geodesic Continuation]<br>
Autogenerative flows follow geodesics on $(\mathcal{M},g)$ up to a potential term from corpus constraints.<br>
\end{theorem}</p>
<p data-start="7115" data-end="7519">\section{Spectral Structure and Relevance}<br>
\label{sec:spectral}<br>
\begin{definition}[Relevance Kernel]<br>
Self-attention induces a content-dependent memory kernel $\alpha_{ti}\propto e^{Q_t\cdot K_i/\sqrt{d}}$.<br>
\end{definition}<br>
\begin{proposition}[Polynomial Tail]<br>
Empirical spectra near $\lambda=1$ follow $(1-\lambda)^\beta$, implying polynomial mixing (cf. Sec.~\ref{sec:ergodic}).<br>
\end{proposition}</p>
<p data-start="7523" data-end="7909">\section{Action and Free Energy}<br>
\label{sec:action}<br>
\begin{definition}[Epistemic Action]<br>
$\mathcal{S}[\gamma]=\int(|\dot\gamma|_g^2+V- \tau \mathcal{R}),dt$ with relevance $\mathcal{R}$ and temperature $\tau$.<br>
\end{definition}<br>
\begin{theorem}[Euler–Lagrange with Memory]<br>
The stationarity of $\mathcal{S}$ yields a delay equation with kernel induced by attention.<br>
\end{theorem}</p>
<p data-start="7913" data-end="8324">\section{Transjective Endofunctor}<br>
\label{sec:transjective}<br>
\begin{definition}[Transjective Pair]<br>
Functors $F:\mathbf{C}_1!\to!\mathbf{C}_2$, $G:\mathbf{C}_2!\to!\mathbf{C}_1$, $T=G\circ F$, with $F\dashv G$ and $T^2\simeq T$.<br>
\end{definition}<br>
\begin{proposition}[Reciprocal Update]<br>
