<span class="hljs-string">"""
plot_figures.py
----------------
Generates publication-quality figures for the Autogeneration Monograph.

Each figure corresponds to a key theoretical construct:
  - fig_ergodic_entropy.pdf : correlation decay (Section 13)
  - fig_infinity_coherence.pdf : ∞-categorical coherence (Section 14)
  - fig_transjective_functor.pdf : transjective mapping (Section 8)
  - fig_relegation_curve.pdf : aspect relegation transition curve

Output: figures/*.pdf
"""</span>

</span><span><span class="hljs-keyword">import</span></span><span> numpy </span><span><span class="hljs-keyword">as</span></span><span> np
</span><span><span class="hljs-keyword">import</span></span><span> matplotlib.pyplot </span><span><span class="hljs-keyword">as</span></span><span> plt
</span><span><span class="hljs-keyword">from</span></span><span> pathlib </span><span><span class="hljs-keyword">import</span></span><span> Path

FIG_DIR = Path(__file__).resolve().parents[</span><span><span class="hljs-number">1</span></span><span>] / </span><span><span class="hljs-string">"figures"</span></span><span>
FIG_DIR.mkdir(exist_ok=</span><span><span class="hljs-literal">True</span></span><span>)

plt.rcParams.update({
    </span><span><span class="hljs-string">"text.usetex"</span></span><span>: </span><span><span class="hljs-literal">False</span></span><span>,
    </span><span><span class="hljs-string">"font.family"</span></span><span>: </span><span><span class="hljs-string">"serif"</span></span><span>,
    </span><span><span class="hljs-string">"figure.figsize"</span></span><span>: (</span><span><span class="hljs-number">5.0</span></span><span>, </span><span><span class="hljs-number">3.2</span></span><span>),
    </span><span><span class="hljs-string">"axes.spines.top"</span></span><span>: </span><span><span class="hljs-literal">False</span></span><span>,
    </span><span><span class="hljs-string">"axes.spines.right"</span></span><span>: </span><span><span class="hljs-literal">False</span></span><span>
})


</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">savefig</span></span><span>(</span><span><span class="hljs-params">name</span></span><span>):
    plt.tight_layout()
    plt.savefig(FIG_DIR / </span><span><span class="hljs-string">f"<span class="hljs-subst">{name}</span></span></span><span>.pdf", bbox_inches=</span><span><span class="hljs-string">"tight"</span></span><span>)
    plt.close()


</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># 1. Polynomial Mixing: Ergodic Entropy Decay (Section 13)</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
t = np.linspace(</span><span><span class="hljs-number">1</span></span><span>, </span><span><span class="hljs-number">1_000</span></span><span>, </span><span><span class="hljs-number">500</span></span><span>)
corr = t ** -</span><span><span class="hljs-number">0.6</span></span><span>
plt.loglog(t, corr, label=</span><span><span class="hljs-string">r"$C(t) \propto t^{-\alpha}$"</span></span><span>)
plt.xlabel(</span><span><span class="hljs-string">"Lag (t)"</span></span><span>)
plt.ylabel(</span><span><span class="hljs-string">"Correlation"</span></span><span>)
plt.title(</span><span><span class="hljs-string">"Polynomial Mixing in Relevance Decay"</span></span><span>)
plt.legend()
savefig(</span><span><span class="hljs-string">"fig_ergodic_entropy"</span></span><span>)


</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># 2. ∞-Categorical Coherence Surface (Section 14)</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
theta = np.linspace(</span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">2</span></span><span> * np.pi, </span><span><span class="hljs-number">400</span></span><span>)
x = np.cos(theta)
y = np.sin(theta)
plt.figure(figsize=(</span><span><span class="hljs-number">4</span></span><span>, </span><span><span class="hljs-number">4</span></span><span>))
plt.plot(x, y, </span><span><span class="hljs-string">"k--"</span></span><span>, lw=</span><span><span class="hljs-number">1</span></span><span>)
plt.plot(</span><span><span class="hljs-number">0.7</span></span><span> * x, </span><span><span class="hljs-number">0.7</span></span><span> * y, </span><span><span class="hljs-string">"b"</span></span><span>)
plt.fill_betweenx(y, -</span><span><span class="hljs-number">0.7</span></span><span> * x, </span><span><span class="hljs-number">0.7</span></span><span> * x, color=</span><span><span class="hljs-string">"lightblue"</span></span><span>, alpha=</span><span><span class="hljs-number">0.3</span></span><span>)
plt.title(</span><span><span class="hljs-string">"∞-Categorical Coherence Surface"</span></span><span>)
plt.axis(</span><span><span class="hljs-string">"equal"</span></span><span>)
plt.axis(</span><span><span class="hljs-string">"off"</span></span><span>)
savefig(</span><span><span class="hljs-string">"fig_infinity_coherence"</span></span><span>)


</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># 3. Transjective Endofunctor Diagram (Section 8)</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
plt.figure(figsize=(</span><span><span class="hljs-number">5</span></span><span>, </span><span><span class="hljs-number">3</span></span><span>))
plt.arrow(</span><span><span class="hljs-number">0.1</span></span><span>, </span><span><span class="hljs-number">0.5</span></span><span>, </span><span><span class="hljs-number">0.3</span></span><span>, </span><span><span class="hljs-number">0.0</span></span><span>, head_width=</span><span><span class="hljs-number">0.05</span></span><span>, color=</span><span><span class="hljs-string">"black"</span></span><span>)
plt.arrow(</span><span><span class="hljs-number">0.9</span></span><span>, </span><span><span class="hljs-number">0.5</span></span><span>, -</span><span><span class="hljs-number">0.3</span></span><span>, </span><span><span class="hljs-number">0.0</span></span><span>, head_width=</span><span><span class="hljs-number">0.05</span></span><span>, color=</span><span><span class="hljs-string">"black"</span></span><span>)
plt.text(</span><span><span class="hljs-number">0.25</span></span><span>, </span><span><span class="hljs-number">0.6</span></span><span>, </span><span><span class="hljs-string">r"$F$"</span></span><span>, fontsize=</span><span><span class="hljs-number">14</span></span><span>)
plt.text(</span><span><span class="hljs-number">0.70</span></span><span>, </span><span><span class="hljs-number">0.6</span></span><span>, </span><span><span class="hljs-string">r"$G$"</span></span><span>, fontsize=</span><span><span class="hljs-number">14</span></span><span>)
plt.text(</span><span><span class="hljs-number">0.1</span></span><span>, </span><span><span class="hljs-number">0.4</span></span><span>, </span><span><span class="hljs-string">r"$\mathbf{C}_1$"</span></span><span>, fontsize=</span><span><span class="hljs-number">12</span></span><span>)
plt.text(</span><span><span class="hljs-number">0.9</span></span><span>, </span><span><span class="hljs-number">0.4</span></span><span>, </span><span><span class="hljs-string">r"$\mathbf{C}_2$"</span></span><span>, fontsize=</span><span><span class="hljs-number">12</span></span><span>)
plt.title(</span><span><span class="hljs-string">"Transjective Endofunctor $T = G \\circ F$"</span></span><span>)
plt.axis(</span><span><span class="hljs-string">"off"</span></span><span>)
savefig(</span><span><span class="hljs-string">"fig_transjective_functor"</span></span><span>)


</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># 4. Aspect Relegation Transition Curve (Section 11)</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
x = np.linspace(</span><span><span class="hljs-number">0</span></span><span>, </span><span><span class="hljs-number">1</span></span><span>, </span><span><span class="hljs-number">200</span></span><span>)
y = </span><span><span class="hljs-number">1</span></span><span> / (</span><span><span class="hljs-number">1</span></span><span> + np.exp(-</span><span><span class="hljs-number">12</span></span><span> * (x - </span><span><span class="hljs-number">0.5</span></span><span>)))  </span><span><span class="hljs-comment"># sigmoid</span></span><span>
plt.plot(x, y, label=</span><span><span class="hljs-string">"Automation Level"</span></span><span>)
plt.plot(x, </span><span><span class="hljs-number">1</span></span><span> - y, </span><span><span class="hljs-string">"--"</span></span><span>, label=</span><span><span class="hljs-string">"Attention Level"</span></span><span>)
plt.xlabel(</span><span><span class="hljs-string">"Training Iteration (normalized)"</span></span><span>)
plt.ylabel(</span><span><span class="hljs-string">"Normalized Response"</span></span><span>)
plt.title(</span><span><span class="hljs-string">"Aspect Relegation Transition Curve"</span></span><span>)
plt.legend()
savefig(</span><span><span class="hljs-string">"fig_relegation_curve"</span></span><span>)

</span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">f"[✓] Figures generated in: <span class="hljs-subst">{FIG_DIR}</span></span></span><span>")
</span></span></code></div></div></pre>
