</span><span><span class="hljs-comment"># ============================================================</span></span><span>
</span><span><span class="hljs-comment"># build_pdf.sh — unified build for autogeneration_monograph.tex</span></span><span>
</span><span><span class="hljs-comment"># ============================================================</span></span><span>

</span><span><span class="hljs-built_in">set</span></span><span> -euo pipefail

ROOT=</span><span><span class="hljs-string">"<span class="hljs-subst">$(cd <span class="hljs-string">"<span class="hljs-subst">$(dirname <span class="hljs-string">"<span class="hljs-variable">${BASH_SOURCE[0]}</span></span></span></span></span></span></span><span>")/.." &amp;&amp; pwd)"
OUT_DIR=</span><span><span class="hljs-string">"<span class="hljs-variable">$ROOT</span></span></span><span>/out/pdfs"
LOG_DIR=</span><span><span class="hljs-string">"<span class="hljs-variable">$ROOT</span></span></span><span>/out/logs"
MAIN_TEX=</span><span><span class="hljs-string">"<span class="hljs-variable">$ROOT</span></span></span><span>/tex/autogeneration_monograph.tex"

</span><span><span class="hljs-built_in">mkdir</span></span><span> -p </span><span><span class="hljs-string">"<span class="hljs-variable">$OUT_DIR</span></span></span><span>" </span><span><span class="hljs-string">"<span class="hljs-variable">$LOG_DIR</span></span></span><span>"

</span><span><span class="hljs-built_in">echo</span></span><span> </span><span><span class="hljs-string">"[*] Generating figures..."</span></span><span>
bash </span><span><span class="hljs-string">"<span class="hljs-variable">$ROOT</span></span></span><span>/scripts/generate_figures.sh" || </span><span><span class="hljs-built_in">echo</span></span><span> </span><span><span class="hljs-string">"[!] Skipping figure generation."</span></span><span>

</span><span><span class="hljs-keyword">if</span></span><span> ! </span><span><span class="hljs-built_in">command</span></span><span> -v latexmk &gt;/dev/null 2&gt;&amp;1; </span><span><span class="hljs-keyword">then</span></span><span>
  </span><span><span class="hljs-built_in">echo</span></span><span> </span><span><span class="hljs-string">"[!] latexmk not installed. Please install TeX Live full or latexmk package."</span></span><span>
  </span><span><span class="hljs-built_in">exit</span></span><span> 1
</span><span><span class="hljs-keyword">fi</span></span><span>

</span><span><span class="hljs-built_in">echo</span></span><span> </span><span><span class="hljs-string">"[*] Compiling monograph..."</span></span><span>
latexmk -lualatex -interaction=nonstopmode -shell-escape -output-directory=</span><span><span class="hljs-string">"<span class="hljs-variable">$OUT_DIR</span></span></span><span>" </span><span><span class="hljs-string">"<span class="hljs-variable">$MAIN_TEX</span></span></span><span>" \
  | </span><span><span class="hljs-built_in">tee</span></span><span> </span><span><span class="hljs-string">"<span class="hljs-variable">$LOG_DIR</span></span></span><span>/latex_firstpass.log"

</span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-built_in">command</span></span><span> -v biber &gt;/dev/null 2&gt;&amp;1 &amp;&amp; [[ -f </span><span><span class="hljs-string">"<span class="hljs-variable">$OUT_DIR</span></span></span><span>/autogeneration_monograph.bcf" ]]; </span><span><span class="hljs-keyword">then</span></span><span>
  </span><span><span class="hljs-built_in">echo</span></span><span> </span><span><span class="hljs-string">"[*] Running biber..."</span></span><span>
  (</span><span><span class="hljs-built_in">cd</span></span><span> </span><span><span class="hljs-string">"<span class="hljs-variable">$OUT_DIR</span></span></span><span>" &amp;&amp; biber autogeneration_monograph) | </span><span><span class="hljs-built_in">tee</span></span><span> </span><span><span class="hljs-string">"<span class="hljs-variable">$LOG_DIR</span></span></span><span>/biber.log"
</span><span><span class="hljs-keyword">fi</span></span><span>

</span><span><span class="hljs-comment"># Final passes</span></span><span>
latexmk -lualatex -interaction=nonstopmode -output-directory=</span><span><span class="hljs-string">"<span class="hljs-variable">$OUT_DIR</span></span></span><span>" </span><span><span class="hljs-string">"<span class="hljs-variable">$MAIN_TEX</span></span></span><span>" | </span><span><span class="hljs-built_in">tee</span></span><span> </span><span><span class="hljs-string">"<span class="hljs-variable">$LOG_DIR</span></span></span><span>/latex_secondpass.log"
latexmk -lualatex -interaction=nonstopmode -output-directory=</span><span><span class="hljs-string">"<span class="hljs-variable">$OUT_DIR</span></span></span><span>" </span><span><span class="hljs-string">"<span class="hljs-variable">$MAIN_TEX</span></span></span><span>" | </span><span><span class="hljs-built_in">tee</span></span><span> </span><span><span class="hljs-string">"<span class="hljs-variable">$LOG_DIR</span></span></span><span>/latex_finalpass.log"

</span><span><span class="hljs-built_in">echo</span></span><span> </span><span><span class="hljs-string">"[✓] Build complete: <span class="hljs-variable">$OUT_DIR</span></span></span><span>/autogeneration_monograph.pdf"
</span></span></code></div></div></pre>
