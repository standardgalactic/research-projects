    </span><span><span class="hljs-string">"N = 128\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"x = np.linspace(-1,1,N)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
