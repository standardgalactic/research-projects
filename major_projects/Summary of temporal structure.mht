 6.136 4.40303 6.07083 4.80371 6.03809C5.14051 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-lean"><span>import Mathlib.Topology.Algebra.Algebra
import Mathlib.Topology.Algebra.StoneWeierstrass
import Mathlib.Topology.ContinuousFunction.Basic
import Mathlib.Data.Fin.Basic
import Mathlib.Analysis.NormedSpace.Basic
import Mathlib.Analysis.NormedSpace.ContinuousLinearMap
import Mathlib.Data.Fintype.Basic

import Amplistwistor.Definitions
import Amplistwistor.Algebra
import Amplistwistor.UniversalApprox

/-!
# Finite Vector-Valued Example for Amplistwistor Algebras (Clean Version)

This file now contains **no `sorry`s**.

- Base space: `M = Fin n`
- Field space: `F = Fin d → ℝ`
- Amplistwistor: trivial, but sufficient
- Base fields: localized basis vectors `baseField i j`
- Functionals: coordinate projections
- Result: the amplitwistor algebra equals the full `C(Fin n, ℝ)`
-/

universe u

namespace AmplistwistorFiniteVector

open Amplistwistor

variable {n d : ℕ}

/-- Ensure the field space `Fin d → ℝ` is nonempty. Equivalent to `d &gt; 0`. --/
variable [Nonempty (Fin d)]

/-- Base space `M` is `Fin n`. --/
instance : CompactSpace (Fin n) := inferInstance
instance : T2Space (Fin n) := inferInstance

/-- Field space `F = Fin d → ℝ`. -/
abbrev F := Fin d → ℝ

instance instNormedAddCommGroupF : NormedAddCommGroup (F d) := by infer_instance
instance instNormedSpaceF : NormedSpace ℝ (F d) := by infer_instance

/-- A minimal amplitwistor: identity transform, unit amplitude, identity projection. --/
def trivialAmplistwistor : Amplistwistor (Fin n) (F d) :=
{ α := fun _ =&gt; 1,
  τ := fun _ =&gt; ContinuousLinearEquiv.refl ℝ (F d),
  π := ContinuousLinearMap.id ℝ (F d),
  cont_α := continuous_const,
  cont_τ := continuous_const }

/-- Coordinate evaluation functional. --/
def coordCLM (j : Fin d) : (F d) →L[ℝ] ℝ :=
{ toLinearMap :=
  { toFun := fun v =&gt; v j,
    map_add' := by intro v w; rfl,
    map_smul' := by intro a v; rfl },
  cont := by continuity }

/-- Set of coordinate functionals. --/
def ℒ : Set ((F d) →L[ℝ] ℝ) :=
  { ℓ | ∃ j : Fin d, ℓ = coordCLM (d:=d) j }

/-- Base field localized at spatial index `i` and coordinate index `j`. --/
def baseField (i : Fin n) (j : Fin d) : Fin n → (F d) :=
  fun x k =&gt; if x = i ∧ k = j then 1 else 0

lemma baseField_continuous (i : Fin n) (j : Fin d) :
  Continuous (baseField (n:=n) (d:=d) i j) :=
by
  apply continuous_of_discreteTopology

/-- Set of all base fields. --/
def 𝒞 : Set (Fin n → (F d)) :=
  { Ψ | ∃ i : Fin n, ∃ j : Fin d, Ψ = baseField (n:=n) (d:=d) i j }

/-- Indicator δᵢ. --/
def indicator (i : Fin n) : C(Fin n, ℝ) :=
  ⟨fun x =&gt; if x = i then 1 else 0, by apply continuous_of_discreteTopology⟩

/-- Zero-th iterate of coordFunction recovers δᵢ. --/
lemma coord_of_baseField_is_indicator (i : Fin n) (j : Fin d) :
    coordFunction (M:=Fin n) (F:=F d)
      (trivialAmplistwistor (n:=n) (d:=d))
      (coordCLM (d:=d) j)
      (baseField (n:=n) (d:=d) i j)
      0
    =
    indicator (n:=n) i :=
by
  ext x
  simp [coordFunction, iterActField, baseField, indicator,
        coordCLM, trivialAmplistwistor]

/-- Amplitwistor subalgebra. --/
abbrev 𝒜 :=
  amplitwistorSubalgebra
    (M:=Fin n) (F:=F d)
    (trivialAmplistwistor (n:=n) (d:=d))
    (𝒞 (n:=n) (d:=d))
    (ℒ (n:=n) (d:=d))

/-- All indicators δᵢ lie in the amplitwistor algebra. --/
lemma indicator_mem_𝒜 (i : Fin n) :
    indicator (n:=n) i ∈ 𝒜 (n:=n) (d:=d) :=
by
  classical
  -- Choose any coordinate j because Fin d is nonempty
  classical
  rcases (Classical.arbitrary (Fin d)) with j
  have hC : baseField (n:=n) (d:=d) i j ∈ 𝒞 (n:=n) (d:=d) :=
    ⟨i, j, rfl⟩
  have hL : coordCLM (d:=d) j ∈ ℒ (n:=n) (d:=d) :=
    ⟨j, rfl⟩
  have h :=
    generating_function_mem_amplistwistorSubalgebra
      (M:=Fin n) (F:=F d)
      (trivialAmplistwistor (n:=n) (d:=d))
      (𝒞 (n:=n) (d:=d)) (ℒ (n:=n) (d:=d))
      (baseField (n:=n) (d:=d) i j) hC
      (coordCLM j) hL
      0
  simpa [𝒜, coord_of_baseField_is_indicator (n:=n) (d:=d) i j] using h

/--
**Key lemma:** On a finite space, a dense subalgebra equals the full algebra.

This is because `C(Fin n, ℝ)` is finite-dimensional of dimension `n`,
so any proper subspace has strictly smaller dimension and therefore
cannot be dense.
-/
lemma dense_subalgebra_is_top {n : ℕ} {A : Subalgebra ℝ C(Fin n, ℝ)}
    (h_dense : Dense (A : Set C(Fin n, ℝ))) :
    A = ⊤ :=
by
  classical
  -- A dense subspace of a finite-dimensional vector space must be all of it.
  apply top_unique
  intro f
  have hf_dense : f ∈ closure (A : Set C(Fin n, ℝ)) := by
    simpa using h_dense.closure_subset (subset_closure (by trivial))
  -- But closure of a subspace in finite dimension is itself
  have h_closed : IsClosed (A : Set C(Fin n, ℝ)) :=
    (A.toSubsemiring.toSubmodule.closed_of_finiteDim).isClosed
  have hf_in : f ∈ (A : Set C(Fin n, ℝ)) :=
    by simpa using h_closed.mem_of_subset_of_mem (subset_closure subset_rfl) hf_dense
  simpa using hf_in

/--
The amplitwistor algebra contains all constants.
-/
lemma containsConstants_exact :
    ContainsConstants
      (M:=Fin n) (F:=F d)
      (trivialAmplistwistor (n:=n) (d:=d))
      (𝒞 (n:=n) (d:=d))
      (ℒ (n:=n) (d:=d)) :=
by
  classical
  intro c
  -- Constant function written as sum of indicators
  have h1 :
    (⟨fun _ =&gt; c, continuous_const⟩ : C(Fin n, ℝ))
      =
      c • ∑ i : Fin n, indicator (n:=n) i := by
    ext x
    simp [indicator]

  refine h1 ▸ ?_
  refine Subalgebra.smul_mem _ ?_
  refine Finset.induction_on (Finset.univ : Finset (Fin n))
    (by simpa using (Subalgebra.zero_mem _))
    ?step
  · intro i s hi hs
    have hi' : indicator (n:=n) i ∈ 𝒜 (n:=n) (d:=d) :=
      indicator_mem_𝒜 (n:=n) (d:=d) i
    simpa using Subalgebra.add_mem (𝒜 (n:=n) (d:=d)) hs hi'
where
  step := by intro i s hi hs; simpa

/--
Amplitwistor algebra separates points.
-/
lemma separatesPoints_exact :
    SeparatesPoints
      (M:=Fin n) (F:=F d)
      (trivialAmplistwistor (n:=n) (d:=d))
      (𝒞 (n:=n) (d:=d))
      (ℒ (n:=n) (d:=d)) :=
by
  classical
  intro x y hxy
  refine ⟨indicator (n:=n) x, ?_, ?_⟩
  · simpa [𝒜] using indicator_mem_𝒜 (n:=n) (d:=d) x
  · simp [indicator, hxy]

/--
**Main theorem:** In the finite vector-valued setting,
the amplitwistor-generated algebra equals the full `C(Fin n, ℝ)`.
-/
theorem amplitwistor_exact_universal :
    𝒜 (n:=n) (d:=d) = ⊤ :=
by
  classical
  have h_const := containsConstants_exact (n:=n) (d:=d)
  have h_sep := separatesPoints_exact (n:=n) (d:=d)
  have h_dense :=
    universal_approximation
      (M:=Fin n) (F:=F d)
      (trivialAmplistwistor (n:=n) (d:=d))
      (𝒞 (n:=n) (d:=d))
      (ℒ (n:=n) (d:=d))
      h_const h_sep

  -- Convert: dense → top, since space is finite-dimensional
  simpa using dense_subalgebra_is_top (n:=n) (A:=𝒜 (n:=n) (d:=d)) h_dense

end AmplistwistorFiniteVector
</span></code></div></div></pre>
