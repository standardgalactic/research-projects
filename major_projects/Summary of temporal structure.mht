   </span><span><span class="hljs-attr">"cell_type"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-string">"code"</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"execution_count"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-literal"><span class="hljs-keyword">null</span></span></span><span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"metadata"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">{</span></span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"outputs"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span><span class="hljs-punctuation">]</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"source"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span>
    </span><span><span class="hljs-string">"def window_width(corr_vec, lags, frac=0.5):\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    idx_max = np.argmax(corr_vec)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    peak = corr_vec[idx_max]\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    thresh = frac * peak\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    # find left crossing\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    left = idx_max\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    while left &gt; 0 and corr_vec[left] &gt; thresh:\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"        left -= 1\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    right = idx_max\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    n = len(corr_vec)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    while right &lt; n-1 and corr_vec[right] &gt; thresh:\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"        right += 1\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    return lags[right] - lags[left]\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"widths = {r: np.zeros(n_layers) for r in regions}\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"for r in regions:\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    for li in range(n_layers):\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
