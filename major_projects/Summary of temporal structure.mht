7 6.136 4.40303 6.07083 4.80371 6.03809C5.14051 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-lean"><span>import Mathlib.Analysis.NormedSpace.Basic
import Mathlib.Analysis.NormedSpace.ContinuousLinearMap
import Mathlib.Topology.Algebra.Module
import Mathlib.Data.Real.Basic

/-!
# Amplistwistors: Basic Definitions

This file defines the notion of an amplitwistor operator acting on a normed
vector space of field values. An amplitwistor at a point combines an
amplitude scalar, an orthogonal linear isomorphism (a "twist"), and a
projection-like continuous linear map.
-/

universe u v

namespace Amplistwistor

open scoped BigOperators

/--
An `Amplistwistor` over a base space `M` with fiber `F` is a triple of:
* a scalar amplitude field `α : M → ℝ`,
* a family of linear isometries `τ : M → F ≃L[ℝ] F` (the twist),
* a continuous linear map `π : F →L[ℝ] F` (the projection).

Here `F` is typically a finite-dimensional real normed space representing
local field values (for instance a scalar–vector–entropy triple).
-/
structure Amplistwistor (M : Type u) (F : Type v)
    [TopologicalSpace M]
    [NormedAddCommGroup F] [NormedSpace ℝ F] where
  α : M → ℝ
  τ : M → F ≃L[ℝ] F
  π : F →L[ℝ] F

variable {M : Type u} {F : Type v}
variable [TopologicalSpace M] [NormedAddCommGroup F] [NormedSpace ℝ F]

/--
The action of an amplitwistor `A` at a point `x : M` on a field value `ψ : F`.

Geometrically, this corresponds to:
1. scaling by the local amplitude `α x`,
2. applying an orthogonal twist `τ x`,
3. then projecting via `π`.
-/
def act (A : Amplistwistor M F) (x : M) (ψ : F) : F :=
  A.π (A.α x • (A.τ x ψ))

notation:80 A "[" x "]⋆" ψ =&gt; act A x ψ

/--
The pointwise action of an amplitwistor on a continuous field `Ψ : M → F`.
-/
def actField (A : Amplistwistor M F) (Ψ : M → F) : M → F :=
  fun x =&gt; A[x]⋆(Ψ x)

end Amplistwistor
</span></code></div></div></pre>
