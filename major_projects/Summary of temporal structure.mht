4237 6.136 4.40303 6.07083 4.80371 6.03809C5.14051 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-Makefile"><span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># Makefile for LuaLaTeX + Biber + latexmk</span></span><span>
</span><span><span class="hljs-comment"># Project: Cortical Columns as Amplitwistor Cascades</span></span><span>
</span><span><span class="hljs-comment"># Author: Flyxion</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>

TARGET = main

LATEXMK = latexmk
LATEXMK_OPTS = -lualatex -halt-on-error -interaction=nonstopmode
BIBER = biber

GREEN  = \033[0;32m
YELLOW = \033[1;33m
RED    = \033[0;31m
RESET  = \033[0m


</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># Default target — full latexmk build (recommended)</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-section">all:</span></span><span>
	@echo </span><span><span class="hljs-string">"<span class="hljs-variable">$(YELLOW)</span></span></span><span>Building with latexmk...</span><span><span class="hljs-variable">$(RESET)</span></span><span>"
	@</span><span><span class="hljs-variable">$(LATEXMK)</span></span><span> </span><span><span class="hljs-variable">$(LATEXMK_OPTS)</span></span><span> </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.tex
	@echo </span><span><span class="hljs-string">"<span class="hljs-variable">$(GREEN)</span></span></span><span>PDF READY: </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.pdf</span><span><span class="hljs-variable">$(RESET)</span></span><span>"


</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># Manual pipeline (LuaLaTeX + Biber chain)</span></span><span>
</span><span><span class="hljs-comment"># Useful if latexmk misbehaves or debugging is needed</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-section">manual:</span></span><span>
	@echo </span><span><span class="hljs-string">"<span class="hljs-variable">$(YELLOW)</span></span></span><span>Running LuaLaTeX (1/3)...</span><span><span class="hljs-variable">$(RESET)</span></span><span>"
	@lualatex -halt-on-error -interaction=nonstopmode </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.tex

	@echo </span><span><span class="hljs-string">"<span class="hljs-variable">$(YELLOW)</span></span></span><span>Running Biber (2/3)...</span><span><span class="hljs-variable">$(RESET)</span></span><span>"
	@</span><span><span class="hljs-variable">$(BIBER)</span></span><span> </span><span><span class="hljs-variable">$(TARGET)</span></span><span>

	@echo </span><span><span class="hljs-string">"<span class="hljs-variable">$(YELLOW)</span></span></span><span>Running LuaLaTeX twice (3/3)...</span><span><span class="hljs-variable">$(RESET)</span></span><span>"
	@lualatex -halt-on-error -interaction=nonstopmode </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.tex
	@lualatex -halt-on-error -interaction=nonstopmode </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.tex

	@echo </span><span><span class="hljs-string">"<span class="hljs-variable">$(GREEN)</span></span></span><span>PDF READY: </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.pdf</span><span><span class="hljs-variable">$(RESET)</span></span><span>"


</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># Watch mode — continuous building on file changes</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-section">watch:</span></span><span>
	@echo </span><span><span class="hljs-string">"<span class="hljs-variable">$(YELLOW)</span></span></span><span>Watching for changes... (Ctrl+C to stop)</span><span><span class="hljs-variable">$(RESET)</span></span><span>"
	@</span><span><span class="hljs-variable">$(LATEXMK)</span></span><span> </span><span><span class="hljs-variable">$(LATEXMK_OPTS)</span></span><span> -pvc </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.tex


</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># Clean auxiliary files but keep the PDF</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-section">clean:</span></span><span>
	@echo </span><span><span class="hljs-string">"<span class="hljs-variable">$(YELLOW)</span></span></span><span>Cleaning temporary files...</span><span><span class="hljs-variable">$(RESET)</span></span><span>"
	@</span><span><span class="hljs-variable">$(LATEXMK)</span></span><span> -c
	@rm -f </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.bbl </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.run.xml


</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># Remove absolutely everything (including PDF)</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-section">cleanall:</span></span><span>
	@echo </span><span><span class="hljs-string">"<span class="hljs-variable">$(RED)</span></span></span><span>Removing ALL generated files...</span><span><span class="hljs-variable">$(RESET)</span></span><span>"
	@</span><span><span class="hljs-variable">$(LATEXMK)</span></span><span> -C
	@echo </span><span><span class="hljs-string">"<span class="hljs-variable">$(GREEN)</span></span></span><span>All cleaned.</span><span><span class="hljs-variable">$(RESET)</span></span><span>"


</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># TikZ externalization (optional)</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-section">tikz:</span></span><span>
	@echo </span><span><span class="hljs-string">"<span class="hljs-variable">$(YELLOW)</span></span></span><span>Externalizing TikZ figures...</span><span><span class="hljs-variable">$(RESET)</span></span><span>"
	@</span><span><span class="hljs-variable">$(LATEXMK)</span></span><span> </span><span><span class="hljs-variable">$(LATEXMK_OPTS)</span></span><span> \
		-pdflatex=</span><span><span class="hljs-string">"lualatex -shell-escape"</span></span><span> </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.tex


</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-meta"><span class="hljs-keyword">.PHONY</span></span></span><span>: all manual watch clean cleanall tikz
</span></span></code></div></div></pre>
<hr data-start="3272" data-end="3275">
<h1 data-start="3277" data-end="3299">❇️ What You Now Have</h1>
<h3 data-start="3301" data-end="3320">1. <strong data-start="3308" data-end="3318"><code data-start="3310" data-end="3316">make</code></strong></h3>
<p data-start="3321" data-end="3340">Runs latexmk → PDF.</p>
<h3 data-start="3342" data-end="3368">2. <strong data-start="3349" data-end="3366"><code data-start="3351" data-end="3364">make manual</code></strong></h3>
<p data-start="3369" data-end="3432">Runs the explicit LuaLaTeX → Biber → LuaLaTeX → LuaLaTeX chain.</p>
<h3 data-start="3434" data-end="3459">3. <strong data-start="3441" data-end="3457"><code data-start="3443" data-end="3455">make watch</code></strong></h3>
<p data-start="3460" data-end="3523">Auto-recompiles on file changes — absolutely ideal for writing.</p>
<h3 data-start="3525" data-end="3549">4. <strong data-start="3532" data-end="3547"><code data-start="3534" data-end="3545">make tikz</code></strong></h3>
<p data-start="3550" data-end="3611">Runs LuaLaTeX with <code data-start="3569" data-end="3585">--shell-escape</code> for TikZ externalization.</p>
<h3 data-start="3613" data-end="3656">5. <strong data-start="3620" data-end="3654"><code data-start="3622" data-end="3634">make clean</code> / <code data-start="3637" data-end="3652">make cleanall</code></strong></h3>
<p data-start="3657" data-end="3689">Deletes aux files or everything.</p>
