7 6.136 4.40303 6.07083 4.80371 6.03809C5.14051 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-lean"><span>import Mathlib.Topology.Algebra.Algebra
import Mathlib.Topology.Algebra.StoneWeierstrass
import Mathlib.Topology.ContinuousFunction.Basic
import Amplistwistor.Definitions
import Amplistwistor.Algebra

/-!
# Universal Approximation for Amplistwistor-Generated Algebras

This file states a Stone–Weierstrass-style universal approximation theorem
for the amplitwistor-generated subalgebra of `C(M, ℝ)`.

The full proof will require verifying that the amplitwistor algebra:
* contains the constant functions,
* separates points of the compact Hausdorff space `M`,
* and is closed under taking the pointwise maximum of pairs of functions
  or, in the complexified setting, closed under complex conjugation.

Those hypotheses are encapsulated here as abstract conditions to be
supplied in future work.
-/

universe u v

namespace Amplistwistor

open scoped BigOperators

variable {M : Type u} [TopologicalSpace M]
variable [CompactSpace M] [T2Space M]
variable [Nonempty M]
variable {F : Type v} [NormedAddCommGroup F] [NormedSpace ℝ F]

/--
A convenience notation for the real algebra of continuous functions on `M`
generated by amplitwistor actions applied to a family of base fields and
tested against a family of continuous linear functionals.
-/
abbrev 𝒜
    (A : Amplistwistor M F)
    (𝒞 : Set (M → F))
    (ℒ : Set (F →L[ℝ] ℝ)) :
    Subalgebra ℝ C(M, ℝ) :=
  amplitwistorSubalgebra A 𝒞 ℒ

/--
Hypothesis asserting that the amplitwistor-generated algebra `𝒜 A 𝒞 ℒ`
contains all constant functions. In practice this would be proved by
including at least one constant field in `𝒞` and a nonzero functional in
`ℒ`, or by other structural arguments.
-/
def ContainsConstants
    (A : Amplistwistor M F)
    (𝒞 : Set (M → F))
    (ℒ : Set (F →L[ℝ] ℝ)) : Prop :=
  ∀ c : ℝ, (⟨fun _ =&gt; c, continuous_const⟩ : C(M, ℝ)) ∈ 𝒜 A 𝒞 ℒ

/--
Hypothesis asserting that the amplitwistor-generated algebra `𝒜 A 𝒞 ℒ`
separates points of `M` in the sense of the Stone–Weierstrass theorem.
-/
def SeparatesPoints
    (A : Amplistwistor M F)
    (𝒞 : Set (M → F))
    (ℒ : Set (F →L[ℝ] ℝ)) : Prop :=
  ∀ {x y : M}, x ≠ y →
    ∃ f ∈ 𝒜 A 𝒞 ℒ, f x ≠ f y

/--
Universal approximation theorem for amplitwistor cascades, stated in a form
amenable to the Stone–Weierstrass theorem. Under the hypotheses that the
amplistwistor algebra contains constants and separates points, it is dense
in `C(M, ℝ)` with respect to the uniform topology.

The proof is left as a `sorry` and should be implemented by invoking
mathlib's Stone–Weierstrass theorem once the necessary algebraic properties
have been verified for `𝒜 A 𝒞 ℒ`.
-/
theorem universal_approximation
    (A : Amplistwistor M F)
    (𝒞 : Set (M → F))
    (ℒ : Set (F →L[ℝ] ℝ))
    (h_const : ContainsConstants A 𝒞 ℒ)
    (h_sep : SeparatesPoints A 𝒞 ℒ)
    :
    DenseRange fun f : 𝒜 A 𝒞 ℒ =&gt; (f : C(M, ℝ)) :=
by
  -- Sketch of the intended proof:
  -- 1. View `𝒜 A 𝒞 ℒ` as a real subalgebra of `C(M, ℝ)`.
  -- 2. Show that it is a self-adjoint subalgebra (automatic over `ℝ`).
  -- 3. Apply the real Stone–Weierstrass theorem using `h_const` and `h_sep`.
  -- The actual Lean proof will mirror the standard mathlib proof for
  -- polynomial algebras and other Stone–Weierstrass instances.
  sorry

end Amplistwistor
</span></code></div></div></pre>
<p data-start="9042" data-end="9143">Now the amplitwistor algebra is no longer a mysterious <code data-start="9097" data-end="9100">⊥</code>; it is a real subalgebra parameterized by:</p>
<ul data-start="9145" data-end="9261">
<li data-start="9145" data-end="9177">
<p data-start="9147" data-end="9177">the amplitwistor family <code data-start="9171" data-end="9174">A</code>,</p>
</li>
<li data-start="9178" data-end="9211">
<p data-start="9180" data-end="9211">a base family of fields <code data-start="9204" data-end="9208">𝒞</code>,</p>
</li>
<li data-start="9212" data-end="9261">
<p data-start="9214" data-end="9261">and a set of continuous linear functionals <code data-start="9257" data-end="9260">ℒ</code>.</p>
</li>
</ul>
<p data-start="9263" data-end="9327">The universal approximation theorem has clear, named hypotheses:</p>
<ul data-start="9329" data-end="9386">
<li data-start="9329" data-end="9359">
<p data-start="9331" data-end="9359"><code data-start="9331" data-end="9357">ContainsConstants A 𝒞 ℒ</code></p>
</li>
<li data-start="9360" data-end="9386">
<p data-start="9362" data-end="9386"><code data-start="9362" data-end="9386">SeparatesPoints A 𝒞 ℒ</code></p>
</li>
</ul>
<p data-start="9388" data-end="9517">This is exactly the shape of theorem you would cite in the LaTeX paper as “Theorem 10.x (Amplistwistor universal approximation).”</p>
<p data-start="9519" data-end="9566">From here, the next deepening step would be to:</p>
<ul data-start="9568" data-end="9856">
<li data-start="9568" data-end="9856">
<p data-start="9570" data-end="9691">actually show that <code data-start="9589" data-end="9608">ContainsConstants</code> and <code data-start="9613" data-end="9630">SeparatesPoints</code> hold for specific choices of <code data-start="9660" data-end="9664">𝒞</code> and <code data-start="9669" data-end="9672">ℒ</code>, for example when:</p>
<ul data-start="9694" data-end="9856">
<li data-start="9694" data-end="9724">
<p data-start="9696" data-end="9724"><code data-start="9696" data-end="9699">M</code> is a compact manifold,</p>
</li>
<li data-start="9727" data-end="9757">
<p data-start="9729" data-end="9757"><code data-start="9729" data-end="9732">F</code> is finite-dimensional,</p>
</li>
<li data-start="9760" data-end="9810">
<p data-start="9762" data-end="9810"><code data-start="9762" data-end="9766">𝒞</code> contains enough “coordinate bump” fields,</p>
</li>
<li data-start="9813" data-end="9856">
<p data-start="9815" data-end="9856"><code data-start="9815" data-end="9818">ℒ</code> contains a basis of dual functionals.</p>
</li>
</ul>
</li>
</ul>
<p data-start="9858" data-end="10104" data-is-last-node="" data-is-only-node="">If you want, I can next sketch a concrete example module, say <code data-start="9920" data-end="9949">Amplistwistor/Examples.lean</code>, where we instantiate this algebra for <code data-start="9989" data-end="9992">M</code> a finite discrete space or <code data-start="10020" data-end="10027">M = ℝ</code> compactified, just to have a fully proved toy case that compiles end-to-end.</p></div></div></div></div><div class="z-0 flex min-h-[46px] justify-start"><div class="touch:-me-2 touch:-ms-3.5 -ms-2.5 -me-1 flex flex-wrap items-center gap-y-4 p-1 select-none touch:w-[calc(100%+--spacing(3.5))] -mt-1 w-[calc(100%+--spacing(2.5))] duration-[1.5s] focus-within:transition-none hover:transition-none touch:pointer-events-auto pointer-events-none [mask-image:linear-gradient(to_right,black_33%,transparent_66%)] [mask-size:300%_100%] [mask-position:100%_0%] motion-safe:transition-[mask-position] group-hover/turn-messages:pointer-events-auto group-hover/turn-messages:[mask-position:0_0] group-focus-within/turn-messages:pointer-events-auto group-focus-within/turn-messages:[mask-position:0_0] has-data-[state=open]:pointer-events-auto has-data-[state=open]:[mask-position:0_0]" style="mask-position: 0% 0%;"><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Copy" aria-pressed="false" data-testid="copy-turn-action-button" data-state="closed"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="icon"><path d="M12.668 10.667C12.668 9.95614 12.668 9.46258 12.6367 9.0791C12.6137 8.79732 12.5758 8.60761 12.5244 8.46387L12.4688 8.33399C12.3148 8.03193 12.0803 7.77885 11.793 7.60254L11.666 7.53125C11.508 7.45087 11.2963 7.39395 10.9209 7.36328C10.5374 7.33197 10.0439 7.33203 9.33301 7.33203H6.5C5.78896 7.33203 5.29563 7.33195 4.91211 7.36328C4.6301