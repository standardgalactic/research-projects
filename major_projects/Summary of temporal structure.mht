   </span><span><span class="hljs-attr">"source"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span>
    </span><span><span class="hljs-string">"n_layers = 24   # synthetic model depth\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"emb_dim = 32\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"# word_embeddings[layer, word, dim]\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"word_embeddings = np.random.normal(0, 1, size=(n_layers, n_words, emb_dim))\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"# Optionally smooth deeper layers to mimic \"longer horizon\" features\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
