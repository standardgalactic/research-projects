237 6.136 4.40303 6.07083 4.80371 6.03809C5.14051 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-python"><span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">gaussian_window</span></span><span>(</span><span><span class="hljs-params">L, sigma</span></span><span>):
    </span><span><span class="hljs-string">"""Simple 1D Gaussian window of length L."""</span></span><span>
    t = np.arange(L)
    center = (L - </span><span><span class="hljs-number">1</span></span><span>) / </span><span><span class="hljs-number">2.0</span></span><span>
    g = np.exp(-</span><span><span class="hljs-number">0.5</span></span><span> * ((t - center) / sigma)**</span><span><span class="hljs-number">2</span></span><span>)
    </span><span><span class="hljs-keyword">return</span></span><span> g / (g.</span><span><span class="hljs-built_in">sum</span></span><span>() + </span><span><span class="hljs-number">1e-9</span></span><span>)

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">amplistwistor_1d</span></span><span>(</span><span><span class="hljs-params">ts, k=<span class="hljs-number">0.3</span></span></span><span>, theta=</span><span><span class="hljs-number">0.5</span></span><span>, sigma_env=</span><span><span class="hljs-number">5</span></span><span>):
    <span class="hljs-string">"""
    1D amplistwistor transform of a temporal regressor.

    Steps:
    1. Envelope: smooth squared amplitude.
    2. Amplitude modulation: exp(k * envelope).
    3. Twist: phase rotation in Fourier domain.
    4. Projection: tanh nonlinearity.
    """</span>
    ts = np.asarray(ts, dtype=</span><span><span class="hljs-built_in">float</span></span><span>)

    </span><span><span class="hljs-comment"># 1. Envelope via smoothed energy</span></span><span>
    L = </span><span><span class="hljs-built_in">min</span></span><span>(</span><span><span class="hljs-built_in">len</span></span><span>(ts), </span><span><span class="hljs-number">4</span></span><span> * sigma_env + </span><span><span class="hljs-number">1</span></span><span>)
    g = gaussian_window(L, sigma_env)
    env = np.convolve(ts**</span><span><span class="hljs-number">2</span></span><span>, g, mode=</span><span><span class="hljs-string">'same'</span></span><span>)

    </span><span><span class="hljs-comment"># 2. Amplitude modulation</span></span><span>
    amp = np.exp(k * env)

    </span><span><span class="hljs-comment"># 3. Phase twist in Fourier domain</span></span><span>
    fft = np.fft.rfft(ts)
    freqs = np.linspace(</span><span><span class="hljs-number">0.0</span></span><span>, </span><span><span class="hljs-number">1.0</span></span><span>, </span><span><span class="hljs-built_in">len</span></span><span>(fft))
    rot = np.exp(</span><span><span class="hljs-number">1j</span></span><span> * theta * freqs)
    twisted = np.fft.irfft(fft * rot, n=</span><span><span class="hljs-built_in">len</span></span><span>(ts))

    </span><span><span class="hljs-comment"># 4. Projection (saturating nonlinearity)</span></span><span>
    proj = np.tanh(twisted)

    </span><span><span class="hljs-keyword">return</span></span><span> amp * proj
</span></span></code></div></div></pre>
