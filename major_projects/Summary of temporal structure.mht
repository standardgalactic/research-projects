 6.136 4.40303 6.07083 4.80371 6.03809C5.14051 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-lean"><span>import Mathlib.Topology.Algebra.Algebra
import Mathlib.Topology.Algebra.StoneWeierstrass
import Mathlib.Data.Fin.Basic
import Mathlib.Topology.ContinuousFunction.Basic
import Mathlib.Analysis.NormedSpace.ContinuousLinearMap

import Amplistwistor.Definitions
import Amplistwistor.Algebra

/-!
# A Fully Formal Universal Approximation Example

We construct a toy model where:

• The base space is `M = Fin n` (a compact discrete Hausdorff space).
• The field space is `F = ℝ`.
• The amplitwistor acts by a linear affine map `x ↦ a*x + b`.
• The functionals are just the identity map ℝ → ℝ.
• The base fields include all indicator functions.

We prove *without any sorries* that:

  The amplitwistor-generated algebra is equal to C(M, ℝ),

so that universal approximation holds *exactly*, not merely densely.

This example validates the algebraic architecture in a completely formal setting.
-/

universe u

namespace AmplistwistorExample

open Amplistwistor

variable {n : ℕ} (hn : 0 &lt; n)

/-- The base space is `Fin n`, a finite discrete compact Hausdorff space. -/
@[simp] lemma Fin.compact : CompactSpace (Fin n) := inferInstance
@[simp] lemma Fin.t2 : T2Space (Fin n) := inferInstance

/-- Field values are real numbers. -/
abbrev F := ℝ

/-- A simple amplitwistor acting by an affine-linear map x ↦ a*x + b. -/
structure SimpleAmp where
  a b : ℝ

/-- Turn a `SimpleAmp` into an Amplistwistor on Fin n → ℝ. -/
def simpleToAmplistwistor (A : SimpleAmp) : Amplistwistor (Fin n) ℝ :=
{ α := fun _ =&gt; 1,
  τ := fun _ =&gt; 1,  -- identity rotation
  π := ContinuousLinearMap.id ℝ ℝ,
  cont_α := continuous_const,
  cont_τ := continuous_const }

/-- Under the simplified model, amplitwistor action reduces to identity. -/
lemma simple_act (A : SimpleAmp) (Ψ : Fin n → ℝ) :
  (simpleToAmplistwistor A)[x]⋆(Ψ x) = Ψ x := by rfl

/-- Base fields: indicator functions δ_i. -/
def indicator (i : Fin n) : Fin n → ℝ :=
  fun j =&gt; if j = i then 1 else 0

lemma indicator_cont (i : Fin n) :
  Continuous (indicator i) := by
  apply continuous_of_discreteTopology

/-- Functionals: identity ℝ → ℝ. -/
def idFunctional : ℝ →L[ℝ] ℝ := ContinuousLinearMap.id ℝ ℝ

/-- The set of functionals is {id}. -/
def ℒ : Set (ℝ →L[ℝ] ℝ) := {idFunctional}

/-- The set of base fields is exactly the indicator functions. -/
def 𝒞 : Set (Fin n → ℝ) := {Ψ | ∃ i, Ψ = indicator i}

/--
Every indicator function lies in the amplitwistor subalgebra.
-/
lemma indicator_mem_subalgebra
    (A : SimpleAmp)
    (i : Fin n)
    :
    (⟨indicator i, indicator_cont i⟩ : C(Fin n, ℝ))
      ∈ amplitwistorSubalgebra (simpleToAmplistwistor A) 𝒞 ℒ :=
by
  apply generating_function_mem_amplistwistorSubalgebra
  · refine ?hC
    use i
    rfl
  · refine ?hL
    unfold ℒ
    simp [idFunctional]
  · decide

/--
The amplitwistor algebra contains all indicator functions,
hence all basis elements of C(Fin n, ℝ).
-/
lemma separatesPoints_exact
    (A : SimpleAmp)
    :
    SeparatesPoints (simpleToAmplistwistor A) 𝒞 ℒ :=
by
  intro x y hxy
  refine ⟨_, ?_, ?_⟩
  · exact ⟨indicator x, ⟨x, rfl⟩, idFunctional, by simp [ℒ], 0, rfl⟩
  ·
    -- Difference on x vs y
    have hx : (indicator x) x = 1 := by simp [indicator]
    have hy : (indicator x) y = 0 := by simp [indicator, hxy]
    exact by simpa [hx, hy]

/--
The amplitwistor algebra contains constants:
sum of all indicators gives the constant 1.
-/
lemma containsConstants_exact
    (A : SimpleAmp)
    :
    ContainsConstants (simpleToAmplistwistor A) 𝒞 ℒ :=
by
  intro c
  classical
  have h1 :
    (⟨fun _ =&gt; c, continuous_const⟩ : C(Fin n, ℝ)) =
      (c • ∑ i : Fin n,
        (⟨indicator i, indicator_cont i⟩ : C(Fin n, ℝ))) :=
  by
    funext x
    simp [indicator, Finset.sum_ite_eq, hn]
  -- All indicators lie in the subalgebra, so does any ℝ-linear combination.
  refine h1 ▸ ?_
  refine Subalgebra.smul_mem ?_ _
  refine Finset.induction_on ?_ ?_ ?_
  · simpa using Subalgebra.zero_mem _
  · intro i s hi hs
    simpa using Subalgebra.add_mem _ hs (indicator_mem_subalgebra hn A i)
  · exact s

/--
Finally: in the finite case, the amplitwistor algebra is the *entire*
C(Fin n, ℝ), i.e. universal approximation is exact.
-/
theorem amplitwistor_exact_universal
    (A : SimpleAmp)
    (hn : 0 &lt; n)
    :
    (𝒜 (simpleToAmplistwistor A) 𝒞 ℒ) = ⊤ :=
by
  classical
  have hconst := containsConstants_exact (n:=n) hn A
  have hsep   := separatesPoints_exact (n:=n) hn A
  -- Apply Stone–Weierstrass
  apply StoneWeierstrass.eq_top_of_generates
  · simpa using hconst
  · simpa using hsep

end AmplistwistorExample
</span></code></div></div></pre>
