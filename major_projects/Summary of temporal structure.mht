7 6.136 4.40303 6.07083 4.80371 6.03809C5.14051 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-lean"><span>import Mathlib.Topology.Basic
import Mathlib.Geometry.Manifold.Basic
import Mathlib.Geometry.Manifold.Instances.Real

/-!
# Cortical Surface Manifold

This file provides a minimal abstraction for a cortical surface `M`, modeled
as a finite-dimensional smooth manifold over `ℝ`, which will serve as the
base space for amplitwistor fields and RSVP-style dynamics.
-/

universe u

namespace Geometry

open scoped Manifold

/-- 
A `CorticalSurface` is a type `M` equipped with the structure of a smooth
finite-dimensional manifold over `ℝ`. In practice, one may instantiate this
with a 2D manifold embedded in `ℝ³` representing the cortex, but the
definition is deliberately abstract.
-/
class CorticalSurface (M : Type u) [TopologicalSpace M] extends
    ChartedSpace ℝ M, SmoothManifoldWithCorners (𝓡 1) M : Prop where
  -- At this level we do not impose further geometric conditions (curvature
  -- bounds, injectivity radius, etc.), though these can be added later as
  -- separate typeclasses.
  closedBall_compact :
    ∀ (x : M) (r : ℝ), r ≥ 0 → IsCompact { y : M | dist y x ≤ r }

end Geometry
</span></code></div></div></pre>
<p data-start="2367" data-end="2490">This is intentionally slightly idealized. You can refine the <code data-start="2428" data-end="2445">CorticalSurface</code> class with more realistic assumptions later.</p>
<hr data-start="2492" data-end="2495">
<p data-start="2497" data-end="2587">Next, define the amplitwistor object itself. Put this at <code data-start="2554" data-end="2586">Amplistwistor/Definitions.lean</code>.</p>
