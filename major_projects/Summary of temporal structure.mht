import Mathlib.Topology.ContinuousFunction.Basic
import Mathlib.Analysis.NormedSpace.ContinuousLinearMap
import Amplistwistor.Definitions

/-!
# Amplistwistor-Generated Function Algebras

This file develops the algebraic structure induced by amplitwistors on the
space of real-valued continuous functions on a compact base space `M`.

We fix a real normed space `F` for field values and a collection of
continuous fields `Ψ : M → F` (the base fields). For each amplitwistor `A`
and continuous linear functional `ℓ : F →L[ℝ] ℝ`, we obtain a real-valued
function on `M` by evaluating `ℓ` on iterated amplitwistor actions applied
to the base fields.

The `amplistwistorSubalgebra` is then defined as the smallest real
subalgebra of `C(M, ℝ)` containing all such functions. This provides the
concrete object to which Stone–Weierstrass will later be applied.
-/

universe u v

namespace Amplistwistor

open scoped BigOperators

variable {M : Type u} [TopologicalSpace M]
variable {F : Type v} [NormedAddCommGroup F] [NormedSpace ℝ F]

/--
An `Amplistwistor` is recalled here for convenience: it is a triple
`(α, τ, π)` where `α` is a scalar amplitude field, `τ` is a family of
linear isometries, and `π` is a continuous linear map.
-/
-- We reuse the structure from `Definitions.lean`.
-- structure Amplistwistor (M : Type u) (F : Type v) ...

/--
A single step of amplitwistor action on a continuous field `Ψ : M → F`,
producing a new field `M → F`.
-/
def actField (A : Amplistwistor M F) (Ψ : M → F) : M → F :=
  fun x =&gt; A[x]⋆(Ψ x)

/--
The `n`-fold iterated amplitwistor action on a field `Ψ`. For `n = 0`, we
obtain `Ψ` itself; for `n+1`, we apply `actField` one more time.
-/
def iterActField (A : Amplistwistor M F) (n : ℕ) (Ψ : M → F) : M → F :=
  Nat.recOn n Ψ (fun _ Ψ' =&gt; actField A Ψ')

/--
Given a continuous field `Ψ : M → F`, a continuous linear functional
`ℓ : F →L[ℝ] ℝ`, and a natural number `n`, we obtain a real-valued
continuous function on `M` by applying `ℓ` pointwise to the `n`-fold
amplistwistor iterate of `Ψ`.
-/
def coordFunction
    (A : Amplistwistor M F)
    (ℓ : F →L[ℝ] ℝ)
    (Ψ : M → F)
    (n : ℕ)
    : C(M, ℝ) :=
  ⟨
    fun x =&gt; ℓ (iterActField A n Ψ x),
    by
      -- Continuity follows from continuity of `Ψ`, of `A`, and of `ℓ`.
      -- In a fully developed version, one would spell out continuity
      -- of `α`, `τ`, and `π`, and thus of `actField`. Here we use a
      -- placeholder `sorry` to keep the algebraic skeleton readable.
      have : Continuous fun x =&gt; iterActField A n Ψ x := by
        -- This is where the inductive continuity proof would go.
        sorry
      simpa using this
  ⟩

/--
The raw generating set of real-valued continuous functions obtained from:
* an amplitwistor `A`,
* a set `𝒞` of base fields `Ψ : M → F`,
* and a set `ℒ` of continuous linear functionals `ℓ : F →L[ℝ] ℝ`.

For each triple `(Ψ, ℓ, n)` we include the corresponding coordinate
function `coordFunction A ℓ Ψ n` in the generating set.
-/
def generatingSet
    (A : Amplistwistor M F)
    (𝒞 : Set (M → F))
    (ℒ : Set (F →L[ℝ] ℝ))
    : Set C(M, ℝ) :=
  { f | ∃ (Ψ : M → F) (hΨ : Ψ ∈ 𝒞)
         (ℓ : F →L[ℝ] ℝ) (hℓ : ℓ ∈ ℒ)
         (n : ℕ),
      f = coordFunction A ℓ Ψ n }

/--
The amplitwistor-generated real subalgebra of `C(M, ℝ)` obtained by taking
the algebraic closure (via `Subalgebra.closure`) of the `generatingSet`.
-/
def amplitwistorSubalgebra
    (A : Amplistwistor M F)
    (𝒞 : Set (M → F))
    (ℒ : Set (F →L[ℝ] ℝ))
    : Subalgebra ℝ C(M, ℝ) :=
  Subalgebra.closure
    { f | ∃ (Ψ : M → F) (hΨ : Ψ ∈ 𝒞)
           (ℓ : F →L[ℝ] ℝ) (hℓ : ℓ ∈ ℒ)
           (n : ℕ),
        f = coordFunction A ℓ Ψ n }

/--
A simple lemma stating that each basic coordinate function generated from
`A`, a base field `Ψ ∈ 𝒞`, a functional `ℓ ∈ ℒ`, and an iterate `n`,
lies in the amplitwistor subalgebra.
-/
lemma generating_function_mem_amplistwistorSubalgebra
    (A : Amplistwistor M F)
    (𝒞 : Set (M → F))
    (ℒ : Set (F →L[ℝ] ℝ))
    (Ψ : M → F) (hΨ : Ψ ∈ 𝒞)
    (ℓ : F →L[ℝ] ℝ) (hℓ : ℓ ∈ ℒ)
    (n : ℕ)
    :
    (coordFunction A ℓ Ψ n) ∈ amplitwistorSubalgebra A 𝒞 ℒ :=
by
  -- By definition, the subalgebra is the closure of the generating set.
  -- Therefore, any element of the generating set lies in the closure.
  refine Subsemiring.subset_closure ?h
  refine ?h
  use Ψ, hΨ, ℓ, hℓ, n
  rfl

end Amplistwistor
</span></code></div></div></pre>
<p data-start="5260" data-end="5549">The key structural move is that <code data-start="5292" data-end="5317">amplistwistorSubalgebra</code> is now a genuine <code data-start="5335" data-end="5357">Subalgebra ℝ C(M, ℝ)</code> built from three knobs: the amplitwistor <code data-start="5399" data-end="5402">A</code>, a set of base fields <code data-start="5425" data-end="5429">𝒞</code>, and a set of functionals <code data-start="5456" data-end="5459">ℒ</code>. The continuity proof is still a <code data-start="5493" data-end="5500">sorry</code>, but logically it is exactly where it should be.</p>
<hr data-start="5551" data-end="5554">
<p data-start="5556" data-end="5762">With that algebra in place, we can now make the universal approximation file more concrete. Here is an updated <code data-start="5667" data-end="5703">Amplistwistor/UniversalApprox.lean</code> that talks precisely about this <code data-start="5736" data-end="5761">amplistwistorSubalgebra</code>.</p>
