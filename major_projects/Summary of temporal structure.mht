    "</span>            if j &gt; </span><span><span class="hljs-number">0</span></span><span><span class="hljs-punctuation">:</span></span><span>\n<span class="hljs-string">",
    "</span>                L</span><span><span class="hljs-punctuation">[</span></span><span>k</span><span><span class="hljs-punctuation">,</span></span><span> idx(i</span><span><span class="hljs-punctuation">,</span></span><span> j</span><span><span class="hljs-number">-1</span></span><span>)</span><span><span class="hljs-punctuation">]</span></span><span> = </span><span><span class="hljs-number">1.0</span></span><span>\n<span class="hljs-string">",
    "</span>            if j &lt; N</span><span><span class="hljs-number">-1</span></span><span><span class="hljs-punctuation">:</span></span><span>\n<span class="hljs-string">",
    "</span>                L</span><span><span class="hljs-punctuation">[</span></span><span>k</span><span><span class="hljs-punctuation">,</span></span><span> idx(i</span><span><span class="hljs-punctuation">,</span></span><span> j+</span><span><span class="hljs-number">1</span></span><span>)</span><span><span class="hljs-punctuation">]</span></span><span> = </span><span><span class="hljs-number">1.0</span></span><span>\n<span class="hljs-string">",
