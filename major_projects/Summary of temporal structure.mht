   </span><span><span class="hljs-attr">"source"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span>
    </span><span><span class="hljs-string">"# RSVP Field Simulation in PyTorch (CPU/GPU)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"This notebook implements a simplified RSVP field dynamical system using\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"PyTorch tensors so that it can run on a GPU when available.\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"We evolve three fields on a 2D grid:\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"- Scalar field: $\\Phi(x, y, t)$\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"- Vector field: $v(x, y, t) = (v_x, v_y)$\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"- Entropy field: $S(x, y, t)$\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"with RSVP-style couplings and visualize their evolution. The code automatically\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"selects `cuda` if available, otherwise falls back to CPU."</span></span><span>
   </span><span><span class="hljs-punctuation">]</span></span><span>
  </span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
  </span><span><span class="hljs-punctuation">{</span></span><span>
   </span><span><span class="hljs-attr">"cell_type"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-string">"code"</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"execution_count"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-literal"><span class="hljs-keyword">null</span></span></span><span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"metadata"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">{</span></span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"outputs"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span><span class="hljs-punctuation">]</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"source"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span>
    </span><span><span class="hljs-string">"import torch\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"import numpy as np\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"import matplotlib.pyplot as plt\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"plt.rcParams['figure.figsize'] = (7, 6)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"print('Using device:', device)"</span></span><span>
   </span><span><span class="hljs-punctuation">]</span></span><span>
  </span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
  </span><span><span class="hljs-punctuation">{</span></span><span>
   </span><span><span class="hljs-attr">"cell_type"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-string">"markdown"</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"metadata"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">{</span></span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"source"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span>
    </span><span><span class="hljs-string">"## 1. Grid and Finite Difference Operators\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"We create a square grid and define discrete Laplacian, divergence, and curl\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"operators in terms of PyTorch tensor shifts. These are fully vectorized and\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"work on GPU without explicit Python loops over spatial indices."</span></span><span>
   </span><span><span class="hljs-punctuation">]</span></span><span>
  </span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
  </span><span><span class="hljs-punctuation">{</span></span><span>
   </span><span><span class="hljs-attr">"cell_type"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-string">"code"</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"execution_count"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-literal"><span class="hljs-keyword">null</span></span></span><span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"metadata"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">{</span></span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"outputs"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span><span class="hljs-punctuation">]</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"source"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span>
    </span><span><span class="hljs-string">"N = 128\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"x = torch.linspace(-1.0, 1.0, N, device=device)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"y = torch.linspace(-1.0, 1.0, N, device=device)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"X, Y = torch.meshgrid(x, y, indexing='ij')\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"dx = x[1] - x[0]\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"dy = y[1] - y[0]\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"def laplacian(f):\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    \"\"\"2D Laplacian with reflective boundaries.\"\"\"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    # pad by one in each direction with reflect\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    f_pad = torch.nn.functional.pad(f.unsqueeze(0).unsqueeze(0),\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"                                    (1, 1, 1, 1), mode='reflect')[0, 0]\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    # central differences\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    f_xx = (f_pad[2:, 1:-1] - 2*f_pad[1:-1, 1:-1] + f_pad[:-2, 1:-1]) / dx**2\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    f_yy = (f_pad[1:-1, 2:] - 2*f_pad[1:-1, 1:-1] + f_pad[1:-1, :-2]) / dy**2\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    return f_xx + f_yy\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"def grad(f):\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    \"\"\"Gradient (df/dx, df/dy) with reflective boundaries.\"\"\"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    f_pad = torch.nn.functional.pad(f.unsqueeze(0).unsqueeze(0),\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"                                    (1, 1, 1, 1), mode='reflect')[0, 0]\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    df_dx = (f_pad[1:-1, 2:] - f_pad[1:-1, :-2]) / (2*dx)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    df_dy = (f_pad[2:, 1:-1] - f_pad[:-2, 1:-1]) / (2*dy)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    return df_dx, df_dy\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"def divergence(vx, vy):\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    dvx_dx, _ = grad(vx)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    _, dvy_dy = grad(vy)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    return dvx_dx + dvy_dy\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"def curl(vx, vy):\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    \"\"\"2D scalar curl: dvy/dx - dvx/dy.\"\"\"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    dvy_dx, _ = grad(vy)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    _, dvx_dy = grad(vx)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    return dvy_dx - dvx_dy"</span></span><span>
   </span><span><span class="hljs-punctuation">]</span></span><span>
  </span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
  </span><span><span class="hljs-punctuation">{</span></span><span>
   </span><span><span class="hljs-attr">"cell_type"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-string">"markdown"</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"metadata"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">{</span></span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"source"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span>
    </span><span><span class="hljs-string">"## 2. RSVP Parameters and Initial Conditions\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"We choose a set of coefficients for the RSVP-style evolution and define\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"initial fields. These are easy to change for different regimes or experiments."</span></span><span>
   </span><span><span class="hljs-punctuation">]</span></span><span>
  </span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
  </span><span><span class="hljs-punctuation">{</span></span><span>
   </span><span><span class="hljs-attr">"cell_type"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-string">"code"</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"execution_count"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-literal"><span class="hljs-keyword">null</span></span></span><span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"metadata"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">{</span></span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"outputs"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span><span class="hljs-punctuation">]</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"source"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span>
    </span><span><span class="hljs-string">"c1, c2, c3 = 0.4, 0.8, 0.25\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"c4, c5, c6 = 1.0, 0.3, 0.4\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"c7, c8, c9 = 0.3, 0.4, 0.2\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"k_in = 0.0  # no external drive in this notebook; can be raised later\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"# Gaussian bump for Φ, zero velocity, small positive entropy\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"Phi = 0.4 * torch.exp(-4.0 * (X**2 + Y**2))\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"vx = torch.zeros_like(Phi)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"vy = torch.zeros_like(Phi)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"S  = 0.1 * torch.ones_like(Phi)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"Phi = Phi.to(device)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"vx = vx.to(device)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"vy = vy.to(device)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"S  = S.to(device)"</span></span><span>
   </span><span><span class="hljs-punctuation">]</span></span><span>
  </span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
  </span><span><span class="hljs-punctuation">{</span></span><span>
   </span><span><span class="hljs-attr">"cell_type"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-string">"markdown"</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"metadata"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">{</span></span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"source"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span>
    </span><span><span class="hljs-string">"## 3. RSVP Time Step in PyTorch\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"We now implement a single forward-Euler step of RSVP dynamics using PyTorch.\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"The code is fully differentiable, so it can eventually be embedded in\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"optimization or learning loops if desired."</span></span><span>
   </span><span><span class="hljs-punctuation">]</span></span><span>
  </span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
  </span><span><span class="hljs-punctuation">{</span></span><span>
   </span><span><span class="hljs-attr">"cell_type"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-string">"code"</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"execution_count"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-literal"><span class="hljs-keyword">null</span></span></span><span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"metadata"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">{</span></span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"outputs"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span><span class="hljs-punctuation">]</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"source"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span>
    </span><span><span class="hljs-string">"def rsvp_step_torch(Phi, vx, vy, S, I_xy=None, dt=0.002):\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    if I_xy is None:\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"        I_xy = torch.zeros_like(Phi)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    lapPhi = laplacian(Phi)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    omega  = curl(vx, vy)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    divv   = divergence(vx, vy)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    dPhi = c1 * lapPhi + c2 * (Phi * omega) - c3 * (S * Phi) + k_in * I_xy\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    dPhi = torch.nan_to_num(dPhi)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    dPhi_dx, dPhi_dy = grad(Phi)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    domega_dx, domega_dy = grad(omega)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    dvx = c4 * dPhi_dx + c5 * domega_dx - c6 * (S * vx)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    dvy = c4 * dPhi_dy + c5 * domega_dy - c6 * (S * vy)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    dvx = torch.nan_to_num(dvx)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    dvy = torch.nan_to_num(dvy)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    dS = c7 * torch.abs(divv) + c8 * (Phi**2) - c9 * S\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    dS = torch.nan_to_num(dS)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    Phi_new = Phi + dt * dPhi\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    vx_new  = vx + dt * dvx\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    vy_new  = vy + dt * dvy\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    S_new   = S  + dt * dS\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    return Phi_new, vx_new, vy_new, S_new"</span></span><span>
   </span><span><span class="hljs-punctuation">]</span></span><span>
  </span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
  </span><span><span class="hljs-punctuation">{</span></span><span>
   </span><span><span class="hljs-attr">"cell_type"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-string">"markdown"</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"metadata"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">{</span></span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"source"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span>
    </span><span><span class="hljs-string">"## 4. Run a Short Simulation and Visualize Snapshots\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"We now integrate the system for a number of time steps and store a few\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"snapshots of the scalar field $\\Phi$ to visualize on the CPU with matplotlib.\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"This provides a basic test that everything is behaving reasonably and that\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"the GPU is being used when available."</span></span><span>
   </span><span><span class="hljs-punctuation">]</span></span><span>
  </span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
  </span><span><span class="hljs-punctuation">{</span></span><span>
   </span><span><span class="hljs-attr">"cell_type"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-string">"code"</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"execution_count"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-literal"><span class="hljs-keyword">null</span></span></span><span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"metadata"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">{</span></span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"outputs"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span><span class="hljs-punctuation">]</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"source"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span>
    </span><span><span class="hljs-string">"n_steps = 1000\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"dt = 0.001\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"snap_indices = torch.linspace(0, n_steps-1, 6, dtype=torch.long)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"snapshots = []\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"Phi_curr = Phi.clone()\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"vx_curr = vx.clone()\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"vy_curr = vy.clone()\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"S_curr  = S.clone()\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"for k in range(n_steps):\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    Phi_curr, vx_curr, vy_curr, S_curr = rsvp_step_torch(Phi_curr, vx_curr, vy_curr, S_curr, dt=dt)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    if k in snap_indices:\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"        snapshots.append((k, Phi_curr.detach().cpu().numpy()))\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"fig, axes = plt.subplots(2, 3, figsize=(11, 6))\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"for ax, (k, snap) in zip(axes.ravel(), snapshots):\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    im = ax.imshow(snap, extent=(-1, 1, -1, 1), cmap='viridis')\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    ax.set_title(f'Step {k}')\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    ax.axis('off')\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"fig.colorbar(im, ax=axes.ravel().tolist(), shrink=0.7)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"plt.suptitle('Φ(x, y, t) Snapshots (PyTorch Simulation)')\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"plt.tight_layout()\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"plt.show()"</span></span><span>
   </span><span><span class="hljs-punctuation">]</span></span><span>
  </span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
  </span><span><span class="hljs-punctuation">{</span></span><span>
   </span><span><span class="hljs-attr">"cell_type"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-string">"markdown"</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"metadata"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">{</span></span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"source"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span>
    </span><span><span class="hljs-string">"## 5. Measuring Simple Summary Statistics Over Time\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"As a sanity check, we can track global quantities such as the spatial mean\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"of $\\Phi$ and $S$, and the kinetic energy of the vector field $v$. These\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"statistics can reveal whether the system is stable, exploding, or drifting\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"to trivial states for a given parameter choice.\n"</span></span><span>
   </span><span><span class="hljs-punctuation">]</span></span><span>
  </span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
  </span><span><span class="hljs-punctuation">{</span></span><span>
   </span><span><span class="hljs-attr">"cell_type"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-string">"code"</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"execution_count"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-literal"><span class="hljs-keyword">null</span></span></span><span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"metadata"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">{</span></span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"outputs"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span><span class="hljs-punctuation">]</span></span><span><span class="hljs-punctuation">,</span></span><span>
   </span><span><span class="hljs-attr">"source"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span>
    </span><span><span class="hljs-string">"n_steps_stats = 2000\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"dt_stats = 0.001\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"Phi_curr = Phi.clone()\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"vx_curr = vx.clone()\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"vy_curr = vy.clone()\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"S_curr  = S.clone()\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"Phi_mean = []\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"S_mean   = []\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"kinetic  = []\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"for k in range(n_steps_stats):\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    Phi_curr, vx_curr, vy_curr, S_curr = rsvp_step_torch(Phi_curr, vx_curr, vy_curr, S_curr, dt=dt_stats)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    Phi_mean.append(Phi_curr.mean().item())\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
