    </span><span><span class="hljs-string">"    word_embeddings[l] = alpha * word_embeddings[l] + (1-alpha) * word_embeddings[l-1]\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"word_embeddings.shape"</span></span><span>
