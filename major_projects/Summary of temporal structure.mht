</span><span><span class="hljs-comment"># Makefile for LuaLaTeX + Biber document compilation</span></span><span>
</span><span><span class="hljs-comment"># Project: Cortical Columns as Amplitwistor Cascades</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>

</span><span><span class="hljs-comment"># Main document name (no .tex extension)</span></span><span>
TARGET = main

</span><span><span class="hljs-comment"># LuaLaTeX and Biber executables</span></span><span>
LATEX = lualatex
BIBER = biber

</span><span><span class="hljs-comment"># Options</span></span><span>
LATEX_OPTS = -interaction=nonstopmode -halt-on-error

</span><span><span class="hljs-comment"># Output colors (for pretty terminal messages)</span></span><span>
GREEN  = \033[0;32m
YELLOW = \033[1;33m
RED    = \033[0;31m
RESET  = \033[0m


</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># Default target — compile document fully</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-section">all: <span class="hljs-variable">$(TARGET)</span></span></span><span>.pdf

</span><span><span class="hljs-variable">$(TARGET)</span></span><span>.pdf: </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.tex sections/*.tex appendices/*.tex references.bib
	@echo </span><span><span class="hljs-string">"<span class="hljs-variable">$(YELLOW)</span></span></span><span>Running LuaLaTeX (1/3)...</span><span><span class="hljs-variable">$(RESET)</span></span><span>"
	@</span><span><span class="hljs-variable">$(LATEX)</span></span><span> </span><span><span class="hljs-variable">$(LATEX_OPTS)</span></span><span> </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.tex

	@echo </span><span><span class="hljs-string">"<span class="hljs-variable">$(YELLOW)</span></span></span><span>Running Biber (2/3)...</span><span><span class="hljs-variable">$(RESET)</span></span><span>"
	@</span><span><span class="hljs-variable">$(BIBER)</span></span><span> </span><span><span class="hljs-variable">$(TARGET)</span></span><span>

	@echo </span><span><span class="hljs-string">"<span class="hljs-variable">$(YELLOW)</span></span></span><span>Running LuaLaTeX twice more (3/3)...</span><span><span class="hljs-variable">$(RESET)</span></span><span>"
	@</span><span><span class="hljs-variable">$(LATEX)</span></span><span> </span><span><span class="hljs-variable">$(LATEX_OPTS)</span></span><span> </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.tex
	@</span><span><span class="hljs-variable">$(LATEX)</span></span><span> </span><span><span class="hljs-variable">$(LATEX_OPTS)</span></span><span> </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.tex

	@echo </span><span><span class="hljs-string">"<span class="hljs-variable">$(GREEN)</span></span></span><span>Compilation complete: </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.pdf</span><span><span class="hljs-variable">$(RESET)</span></span><span>"


</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># Convenience target: just run LuaLaTeX once</span></span><span>
</span><span><span class="hljs-comment"># Useful for quick iteration when editing sections.</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-section">quick:</span></span><span>
	@echo </span><span><span class="hljs-string">"<span class="hljs-variable">$(YELLOW)</span></span></span><span>Quick-compile with LuaLaTeX...</span><span><span class="hljs-variable">$(RESET)</span></span><span>"
	@</span><span><span class="hljs-variable">$(LATEX)</span></span><span> </span><span><span class="hljs-variable">$(LATEX_OPTS)</span></span><span> </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.tex


</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># Clean auxiliary files, but keep the PDF</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-section">clean:</span></span><span>
	@echo </span><span><span class="hljs-string">"<span class="hljs-variable">$(YELLOW)</span></span></span><span>Removing auxiliary files...</span><span><span class="hljs-variable">$(RESET)</span></span><span>"
	@rm -f \
		</span><span><span class="hljs-variable">$(TARGET)</span></span><span>.aux </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.log </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.out \
		</span><span><span class="hljs-variable">$(TARGET)</span></span><span>.bbl </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.bcf </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.blg \
		</span><span><span class="hljs-variable">$(TARGET)</span></span><span>.run.xml \
		</span><span><span class="hljs-variable">$(TARGET)</span></span><span>.toc </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.lof </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.lot \
		</span><span><span class="hljs-variable">$(TARGET)</span></span><span>.fls </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.fdb_latexmk
	@echo </span><span><span class="hljs-string">"<span class="hljs-variable">$(GREEN)</span></span></span><span>Cleanup complete.</span><span><span class="hljs-variable">$(RESET)</span></span><span>"


</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># Clean everything, including the PDF</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-section">cleanall: clean</span></span><span>
	@echo </span><span><span class="hljs-string">"<span class="hljs-variable">$(RED)</span></span></span><span>Removing output PDF...</span><span><span class="hljs-variable">$(RESET)</span></span><span>"
	@rm -f </span><span><span class="hljs-variable">$(TARGET)</span></span><span>.pdf
	@echo </span><span><span class="hljs-string">"<span class="hljs-variable">$(GREEN)</span></span></span><span>All build artifacts removed.</span><span><span class="hljs-variable">$(RESET)</span></span><span>"


</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># Phony targets</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-meta"><span class="hljs-keyword">.PHONY</span></span></span><span>: all quick clean cleanall
</span></span></code></div></div></pre>
<hr data-start="2919" data-end="2922">
<h1 data-start="2924" data-end="2944">✔ Features You Get</h1>
<h3 data-start="2946" data-end="2976"><strong data-start="2950" data-end="2976">Full compile (default)</strong></h3>
<p data-start="2977" data-end="2982">Runs:</p>
<ol data-start="2984" data-end="3028">
<li data-start="2984" data-end="2997">
<p data-start="2987" data-end="2997">LuaLaTeX</p>
</li>
<li data-start="2998" data-end="3008">
<p data-start="3001" data-end="3008">Biber</p>
</li>
<li data-start="3009" data-end="3028">
<p data-start="3012" data-end="3028">LuaLaTeX twice</p>
</li>
</ol>
<p data-start="3030" data-end="3085">Ensures resolved citations, ToC, cross-references, etc.</p>
<h3 data-start="3087" data-end="3107"><strong data-start="3091" data-end="3107"><code data-start="3093" data-end="3105">make quick</code></strong></h3>
<p data-start="3108" data-end="3261">Runs only a single pass of LuaLaTeX — perfect for fast iteration when you’re editing only text and don’t need bibliography or cross-reference resolution.</p>
<h3 data-start="3263" data-end="3283"><strong data-start="3267" data-end="3283"><code data-start="3269" data-end="3281">make clean</code></strong></h3>
<p data-start="3284" data-end="3330">Removes temporary files but <strong data-start="3312" data-end="3329">keeps the PDF</strong>.</p>
<h3 data-start="3332" data-end="3355"><strong data-start="3336" data-end="3355"><code data-start="3338" data-end="3353">make cleanall</code></strong></h3>
<p data-start="3356" data-end="3398">Removes <strong data-start="3364" data-end="3378">everything</strong>, including the PDF.</p>
<h3 data-start="3400" data-end="3438"><strong data-start="3404" data-end="3438">Automatically recompiles when:</strong></h3>
<ul data-start="3439" data-end="3555">
<li data-start="3439" data-end="3481">
<p data-start="3441" data-end="3481">Any <code data-start="3445" data-end="3451">.tex</code> file in <code data-start="3460" data-end="3471">sections/</code> changes</p>
</li>
<li data-start="3482" data-end="3526">
<p data-start="3484" data-end="3526">Any <code data-start="3488" data-end="3494">.tex</code> file in <code data-start="3503" data-end="3516">appendices/</code> changes</p>
</li>
<li data-start="3527" data-end="3555">
<p data-start="3529" data-end="3555"><code data-start="3529" data-end="3545">references.bib</code> changes</p>
</li>
</ul>
<hr data-start="3557" data-end="3560">
<h1 data-start="3562" data-end="3588">✔ If you want even more:</h1>
<p data-start="3590" data-end="3631">I can generate an enhanced Makefile with:</p>
<ul data-start="3633" data-end="3884">
<li data-start="3633" data-end="3660">
<p data-start="3635" data-end="3660"><strong data-start="3635" data-end="3658">latexmk integration</strong></p>
</li>
<li data-start="3661" data-end="3702">
<p data-start="3663" data-end="3702"><strong data-start="3663" data-end="3700">automatic watching (<code data-start="3685" data-end="3697">make watch</code>)</strong></p>
</li>
<li data-start="3703" data-end="3741">
<p data-start="3705" data-end="3741"><strong data-start="3705" data-end="3739">continuous preview compilation</strong></p>
</li>
<li data-start="3742" data-end="3779">
<p data-start="3744" data-end="3779"><strong data-start="3744" data-end="3777">parallel TikZ externalization</strong></p>
</li>
<li data-start="3780" data-end="3827">
<p data-start="3782" data-end="3827"><strong data-start="3782" data-end="3825">automatic indexing or glossary building</strong></p>
</li>
<li data-start="3828" data-end="3884">
<p data-start="3830" data-end="3884"><strong data-start="3830" data-end="3882">Nix/Conda reproducible environment specification</strong></p>
</li>
</ul>
<p data-start="3886" data-end="3899">Just tell me:</p>
<p data-start="3901" data-end="4023">➡️ <em data-start="3904" data-end="3927">“Add latexmk support”</em><br data-start="3927" data-end="3930">
➡️ <em data-start="3933" data-end="3953">“Add a watch mode”</em><br data-start="3953" data-end="3956">
➡️ <em data-start="3959" data-end="3987">“Add TikZ externalization”</em><br data-start="3987" data-end="3990">
➡️ <em data-start="3993" data-end="4023">“Add environment management”</em></p>
<p data-start="4025" data-end="4085">I can also generate a fully reproducible build system via:</p>
<ul data-start="4087" data-end="4153">
<li data-start="4087" data-end="4105">
<p data-start="4089" data-end="4105"><strong data-start="4089" data-end="4103">Dockerfile</strong></p>
</li>
<li data-start="4106" data-end="4127">
<p data-start="4108" data-end="4127"><strong data-start="4108" data-end="4125">Make + Docker</strong></p>
</li>
<li data-start="4128" data-end="4153">
<p data-start="4130" data-end="4153"><strong data-start="4130" data-end="4151">GitHub Actions CI</strong></p>
</li>
</ul>
<p data-start="4155" data-end="4239" data-is-last-node="" data-is-only-node="">If you want the project zipped into a downloadable archive, I can generate that too.</p></div></div></div></div><div class="z-0 flex min-h-[46px] justify-start"><div class="touch:-me-2 touch:-ms-3.5 -ms-2.5 -me-1 flex flex-wrap items-center gap-y-4 p-1 select-none touch:w-[calc(100%+--spacing(3.5))] -mt-1 w-[calc(100%+--spacing(2.5))] duration-[1.5s] focus-within:transition-none hover:transition-none touch:pointer-events-auto pointer-events-none [mask-image:linear-gradient(to_right,black_33%,transparent_66%)] [mask-size:300%_100%] [mask-position:100%_0%] motion-safe:transition-[mask-position] group-hover/turn-messages:pointer-events-auto group-hover/turn-messages:[mask-position:0_0] group-focus-within/turn-messages:pointer-events-auto group-focus-within/turn-messages:[mask-position:0_0] has-data-[state=open]:pointer-events-auto has-data-[state=open]:[mask-position:0_0]" style="mask-position: 0% 0%;"><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Copy" aria-pressed="false" data-testid="copy-turn-action-button" data-state="closed"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="icon"><path d="M12.668 10.667C12.668 9.95614 12.668 9.46258 12.6367 9.0791C12.6137 8.79732 12.5758 8.60761 12.5244 8.46387L12.4688 8.33399C12.3148 8.03193 12.0803 7.77885 11.793 7.60254L11.666 7.53125C11.508 7.45087 11.2963 7.39395 10.9209 7.36328C10.5374 7.33197 10.0439 7.33203 9.33301 7.33203H6.5C5.78896 7.33203 5.29563 7.33195 4.91211 7.36328C4.63016 7.38632 4.44065 7.42413 4.29688 7.47559L4.16699 7.53125C3.86488 7.68518 3.61186 7.9196 3.43555 8.20703L3.36524 8.33399C3.28478 8.49198 3.22795 8.70352 3.19727 9.0791C3.16595 9.46259 3.16504 9.95611 3.16504 10.667V13.5C3.16504 14.211 3.16593 14.7044 3.19727 15.0879C3.22797 15.4636 3.28473 15.675 3.