7 6.136 4.40303 6.07083 4.80371 6.03809C5.14051 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-lean"><span>import Mathlib.Topology.Algebra.Algebra
import Mathlib.Topology.Algebra.StoneWeierstrass
import Mathlib.Topology.ContinuousFunction.Basic
import Mathlib.Analysis.NormedSpace.Basic
import Mathlib.Topology.Manifold.Instances
import Mathlib.Geometry.Manifold.ContMDiff

import Amplistwistor.Definitions
import Amplistwistor.Algebra
import Amplistwistor.UniversalApprox

/-!
# Amplistwistors on Compact Manifolds: Abstract Universal Approximation

This file lifts the amplitwistor universal approximation framework to a
general compact smooth manifold. The key idea is that the geometry of the
manifold enters through the richness of a family of base fields and
continuous linear functionals, while the universal approximation result
itself is purely topological (Stone–Weierstrass).

We therefore:

* Assume `M` is a compact Hausdorff manifold modelled on a normed space `H`.
* Assume `F` is a finite-dimensional real normed space.
* Fix an amplitwistor `A` on fields `M → F`.
* Fix a family `𝒞` of base fields and a family `ℒ` of continuous linear
  functionals on `F`.

We then package the manifold-style richness assumptions (local chart
support, point separation, constants) into a `ManifoldSetup` structure,
and show that under these hypotheses the amplitwistor-generated algebra
is dense in `C(M, ℝ)`.

This is the abstract manifold counterpart of the fully explicit finite
examples developed elsewhere.
-/

universe u v w

namespace AmplistwistorManifold

open Amplistwistor

/-- Model space for the manifold. -/
variable (H : Type u) [NormedAddCommGroup H] [NormedSpace ℝ H]

/-- Base space `M` is a compact smooth manifold modelled on `H`. -/
variable (M : Type v)
variable [TopologicalSpace M]
variable [ChartedSpace H M]
variable [SmoothManifoldWithCorners (𝓘(ℝ, H)) M]
variable [CompactSpace M]
variable [T2Space M]
variable [Nonempty M]

/-- Field values live in a finite-dimensional real normed space `F`. -/
variable (F : Type w)
variable [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]

/-!
## 1. Manifold-Level Setup for Amplistwistors

We now bundle the geometric and algebraic ingredients needed to state
a manifold-level universal approximation result.
-/

/--
A manifold-level amplitwistor setup bundles:

* the base manifold `M` and field space `F`,
* a fixed amplitwistor `A`,
* a family `𝒞` of base fields `M → F`,
* a family `ℒ` of continuous linear functionals `F →L[ℝ] ℝ`,
* and manifold-style richness hypotheses:

  1. `containsConstants` – the amplitwistor algebra contains all constant
     real-valued functions on `M`.

  2. `separatesPoints` – the amplitwistor algebra separates points of `M`
     in the Stone–Weierstrass sense.

In concrete applications, `𝒞` will typically be constructed from fields
supported in coordinate charts (using partitions of unity), and `ℒ` from
a basis of the dual space `F →L[ℝ] ℝ`. Here we keep these as abstract
parameters with explicit axioms.
-/
structure ManifoldSetup where
  /-- The amplitwistor acting on fields `M → F`. -/
  A : Amplistwistor M F
  /-- Base family of continuous fields. -/
  𝒞 : Set (M → F)
  /-- Family of continuous linear functionals on `F`. -/
  ℒ : Set (F →L[ℝ] ℝ)
  /-- All base fields are continuous. -/
  cont_𝒞 : ∀ {Ψ : M → F}, Ψ ∈ 𝒞 → Continuous Ψ
  /-- Manifold-style hypothesis: the amplitwistor algebra contains constants. -/
  containsConstants :
    ContainsConstants A 𝒞 ℒ
  /-- Manifold-style hypothesis: the amplitwistor algebra separates points. -/
  separatesPoints :
    SeparatesPoints A 𝒞 ℒ

namespace ManifoldSetup

variable {H M F}
variable (S : ManifoldSetup (H:=H) (M:=M) (F:=F))

/--
The amplitwistor-generated algebra in the manifold setup.
-/
abbrev algebra : Subalgebra ℝ C(M, ℝ) :=
  amplitwistorSubalgebra S.A S.𝒞 S.ℒ

/--
Reformulation: in the manifold setup, the amplitwistor-generated algebra
contains all constant functions `M → ℝ`.
-/
lemma containsConstants' :
  ContainsConstants S.A S.𝒞 S.ℒ :=
  S.containsConstants

/--
Reformulation: in the manifold setup, the amplitwistor-generated algebra
separates points of the manifold `M`.
-/
lemma separatesPoints' :
  SeparatesPoints S.A S.𝒞 S.ℒ :=
  S.separatesPoints

/--
**Manifold-level universal approximation theorem.**

Under the manifold setup hypotheses, the amplitwistor-generated algebra
is dense in `C(M, ℝ)` with respect to the uniform topology.

In words: amplitwistor cascades built from the base fields `𝒞` and
functionals `ℒ` approximate any continuous real-valued function on the
compact manifold arbitrarily well.
-/
theorem denseRange :
  DenseRange fun f : algebra (S:=S) =&gt; (f : C(M, ℝ)) :=
by
  -- This is exactly the abstract universal approximation theorem specialized
  -- to the manifold setup, using the Stone–Weierstrass framework in
  -- `Amplistwistor.UniversalApprox`.
  simpa [algebra] using
    universal_approximation
      (M:=M) (F:=F)
      S.A S.𝒞 S.ℒ
      S.containsConstants
      S.separatesPoints

end ManifoldSetup

/-!
## 2. Discussion

The `ManifoldSetup` record is intentionally abstract. In a concrete
cortical application, one would instantiate it as follows:

* `M` is a 2- or 3-dimensional compact smooth manifold modelling the
  cortical sheet or folded cortex.

* `F ≃ ℝ^d` is a finite-dimensional feature space of local field values
  (e.g., semantic channels, laminar activations, population codes).

* `A` is a biologically grounded amplitwistor whose `α`, `τ`, and `π`
  components encode local gain modulation, orientation of feature axes,
  and projection to downstream populations.

* `𝒞` is obtained from bump fields supported in coordinate charts, often
  built via smooth partitions of unity subordinate to an atlas. Such
  fields can be chosen to approximate local basis vectors in `F` at each
  point.

* `ℒ` is chosen as a finite generating set for the dual space
  `F →L[ℝ] ℝ`, for example coordinate projections in a fixed basis.

Verifying the `containsConstants` and `separatesPoints` hypotheses then
amounts to showing that:

1. Constants can be written as finite linear combinations of amplitwistor
   iterates of base fields tested against the functionals in `ℒ`.

2. For any distinct points `x ≠ y` in `M`, there exists a field in the
   amplitwistor algebra whose real-valued readout distinguishes them.

In the presence of sufficiently rich charts and partitions of unity, and
a dual basis of functionals on `F`, these conditions are natural and
mirror the finite examples developed elsewhere.

The actual geometry of `M` (curvature, metric, Laplace–Beltrami operator)
enters in more refined questions about PDE flows, eigenmode expansions,
and spectral localization; the present file isolates the purely
approximation-theoretic content.
-/

end AmplistwistorManifold
</span></code></div></div></pre>
<hr data-start="7819" data-end="7822">
<h2 data-start="7824" data-end="7853">How this fits conceptually</h2>
<ul data-start="7855" data-end="8196">
<li data-start="7855" data-end="8129">
<p data-start="7857" data-end="7965">This doesn’t try to reprove deep manifold theorems inside Lean; instead, it gives you a <strong data-start="7945" data-end="7964">clean interface</strong>:</p>
<ul data-start="7968" data-end="8129">
<li data-start="7968" data-end="8129">
<p data-start="7970" data-end="8129">If you can construct <code data-start="7991" data-end="7995">𝒞</code> and <code data-start="8000" data-end="8003">ℒ</code> for your cortical manifold so that <code data-start="8039" data-end="8058">containsConstants</code> and <code data-start="8063" data-end="8080">separatesPoints</code> hold, then universal approximation is immediate.</p>
</li>
</ul>
</li>
<li data-start="8130" data-end="8196">
<p data-start="8132" data-end="8196">In the LaTeX world, this corresponds directly to a theorem like:</p>
</li>
</ul>
<blockquote data-start="8198" data-end="8687">
<p data-start="8200" data-end="8687">Theorem (Manifold Amplistwistor Universal Approximation).<br data-start="8257" data-end="8260">
