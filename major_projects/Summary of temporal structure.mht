6.136 4.40303 6.07083 4.80371 6.03809C5.14051 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-cfg"><span># ------------------------------------------------------------
# ChkTeX configuration for academic LaTeX projects
# Author: Flyxion
# ------------------------------------------------------------

# Disable warnings that trigger excessively in academic prose:

# 1: Missing space after command (often false positives in math)
Warn1  = 0

# 8: Wrong length of dash (em-dash/en-dash); stylistic, not structural
Warn8  = 0

# 9: Missing item indent; noisy for custom environments
Warn9  = 0

# 13: Inter-sentence spacing (not needed in modern LaTeX)
Warn13 = 0

# 15: Italic correction advice (rarely relevant)
Warn15 = 0

# 17: Missing $ for math (false triggers in macros)
Warn17 = 0

# 36: \\ in math mode; allowed in align, cases, etc.
Warn36 = 0

# 38: Font selection warning; irrelevant for academic documents
Warn38 = 0

# 46: Suspicious use of ? or ! (often incorrect in technical writing)
Warn46 = 0

# 50: Use of $$; many math packages still allow it; suppress
Warn50 = 0


# ------------------------------------------------------------
# Keep important structural warnings:

# 2: Unbalanced braces
Warn2 = 1

# 5: Unknown command (helps detect typos)
Warn5 = 1

# 6: Missing braces around arguments
Warn6 = 1

# 18: Math-mode punctuation issues
Warn18 = 1

# 24: Spacing after periods (only warns when likely an error)
Warn24 = 1

# 25: Space before punctuation
Warn25 = 1

# 27: Unescaped underscores (important for URLs and text mode)
Warn27 = 1


# ------------------------------------------------------------
# Settings for file inclusion and parsing:

# Maximum input line length
MaxLen = 2048

# Allow inclusion of other .tex files
InputEncoding = utf8
Macrocode = 1
VerbEnvironments = verbatim lstlisting minted Verbatim

# Ignore warnings in environments where they are not useful
IgnoreEnv = tikzpicture
IgnoreEnv = align
IgnoreEnv = equation
IgnoreEnv = displaymath
IgnoreEnv = cases
IgnoreEnv = array
IgnoreEnv = matrix
IgnoreEnv = pmatrix
IgnoreEnv = bmatrix
IgnoreEnv = vmatrix

# Ignore bibliography environment (handled by biber)
IgnoreEnv = thebibliography

# Allow percent signs at end of lines
EndMatch = 0

# ------------------------------------------------------------
# END OF FILE
# ------------------------------------------------------------
</span></code></div></div></pre>
