</span><span><span class="hljs-keyword">\mathcal</span></span><span>{A}(</span><span><span class="hljs-keyword">\Psi</span></span><span>)(x)=u,</span><span><span class="hljs-keyword">\qquad</span></span><span>
</span><span><span class="hljs-keyword">\mathcal</span></span><span>{A}(</span><span><span class="hljs-keyword">\Psi</span></span><span>)(y)=v.
