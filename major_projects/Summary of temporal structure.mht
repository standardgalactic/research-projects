    </span><span><span class="hljs-string">"test_lags = np.arange(-200, 801, 20)  # in ms\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"lag_corr = {r: np.zeros((n_layers, len(test_lags))) for r in regions}\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
