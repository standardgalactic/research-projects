import Mathlib.Topology.ContinuousFunction.Basic
import Mathlib.Analysis.NormedSpace.Basic
import Mathlib.Data.Fintype.Basic

import Amplistwistor.Definitions
import Amplistwistor.Algebra
import Amplistwistor.UniversalApprox
import AmplistwistorFiniteVector  -- the finite-vector example file

/-!
# Amplistwistors on Finite Graphs (Discrete Cortical Surfaces)

This file lifts the finite vector-valued amplitwistor universal approximation
result to the setting of a finite graph, which can be viewed as a discrete
cortical surface or mesh.

The key observation is that universal approximation in `C(V, ℝ)` depends only
on the finite, compact, Hausdorff nature of the vertex set `V`, not on the
specific adjacency relation. The graph structure becomes crucial when one
introduces Laplacians, diffusion, and eigenmodes, but the Stone–Weierstrass
argument is purely topological.

We therefore:

* Take vertices `V := Fin n` for some `n ≥ 1`.
* Equip `V` with a graph structure (undirected, simple, etc.).
* Reuse the finite-vector amplitwistor construction to obtain an algebra
  `𝒜` of real-valued functions on `V`.
* Invoke the theorem `amplistwistor_exact_universal` to conclude that
  `𝒜 = C(V, ℝ)` in this discrete setting.
-/

universe u

namespace AmplistwistorGraph

open Amplistwistor
open AmplistwistorFiniteVector

/--
A simple undirected graph structure on a vertex type `V`.

We keep only the adjacency relation; further structure (weights, directions)
could be added as needed for spectral graph theory or diffusion models.
-/
structure Graph (V : Type u) where
  adj : V → V → Prop
  symm_adj : Symmetric adj
  loopless : ∀ v, ¬ adj v v

namespace Graph

variable {n d : ℕ}

/-- Vertex set is `Fin n`. -/
abbrev Vert := Fin n

/-- A graph on `Fin n` vertices. -/
abbrev FinGraph := Graph (Vert (n:=n))

/--
Field space attached to each vertex: `Fin d → ℝ`, a finite-dimensional
feature vector space. This is the same `F d` used in the finite-vector
example.
-/
abbrev Field := F d

/--
The amplitwistor algebra associated to a given graph on `Fin n` is defined
purely on the vertex set; the adjacency does not enter the definition of the
amplistwistor algebra itself, but will be relevant for spectral and dynamical
constructions (e.g., graph Laplacians, diffusion, and eigenmodes).

We simply reuse the finite-vector amplitwistor algebra `𝒜` from the
`AmplistwistorFiniteVector` module.
-/
abbrev algebra (G : FinGraph (n:=n)) : Subalgebra ℝ C(Vert (n:=n), ℝ) :=
  𝒜 (n:=n) (d:=d)

/--
**Graph-level universal approximation theorem.**

For any finite graph `G` on vertex set `Fin n`, and any feature dimension `d`
with `Fin d` nonempty, the amplitwistor-generated algebra on the vertex set
is the entire real function algebra `C(Fin n, ℝ)`.

In other words, amplitwistor cascades built from localized base fields and
coordinate functionals are capable of representing *every* real-valued signal
on the graph exactly (not just densely) in this finite setting.
-/
theorem amplitwistor_exact_universal_on_graph
    (G : FinGraph (n:=n))
    [Nonempty (Fin d)] :
    algebra (n:=n) (d:=d) G = ⊤ :=
by
  -- This is a direct consequence of the finite-vector universal
  -- approximation theorem proved in `AmplistwistorFiniteVector`.
  simpa [algebra] using
    AmplistwistorFiniteVector.amplistwistor_exact_universal
      (n:=n) (d:=d)

end Graph

/-!
## Discussion

In this discrete graph setting, the amplitwistor algebra is defined over
the vertex set `V = Fin n` and does not depend on the adjacency relation
of `G` for the universal approximation property. What the adjacency does
control is the geometry and dynamics of signals on the graph, for example:

* the definition of a graph Laplacian `L`,
* the eigenmodes of `L`, which can be interpreted as discrete analogues of
  cortical resonant modes,
* diffusion and wave equations on the graph,
* and the structure of propagating activity patterns.

The present file isolates the approximation-theoretic content: it shows
that amplitwistor cascades, combined with a sufficiently rich family of
base fields and coordinate functionals, can express *any* real-valued
function on the vertex set of a finite graph. This is the discrete
counterpart of the manifold-level Stone–Weierstrass result established
elsewhere.

One natural next step would be to define a graph Laplacian and relate its
eigenvectors to the amplitwistor-generated basis functions, thereby tying
the algebraic representation power of amplitwistors to the spectral
properties of the underlying cortical mesh.
-/

end AmplistwistorGraph
</span></code></div></div></pre>
<p data-start="5576" data-end="5699">This gives you a clean, conceptually correct graph-level formalization that plugs directly into the amplitwistor narrative:</p>
<ul data-start="5701" data-end="5913">
<li data-start="5701" data-end="5754">
<p data-start="5703" data-end="5754">Finite cortical meshes → finite graphs over <code data-start="5747" data-end="5754">Fin n</code></p>
</li>
<li data-start="5755" data-end="5799">
<p data-start="5757" data-end="5799">Fields on vertices → <code data-start="5778" data-end="5799">Fin n → (Fin d → ℝ)</code></p>
</li>
<li data-start="5800" data-end="5860">
<p data-start="5802" data-end="5860">Amplistwistors → local nonlinear operators on those fields</p>
</li>
<li data-start="5861" data-end="5913">
<p data-start="5863" data-end="5913">Result → universal expressivity for vertex signals</p>
</li>
</ul>
