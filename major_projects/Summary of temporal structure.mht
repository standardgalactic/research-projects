   "</span>metadata<span class="hljs-string">": {},
   "</span>outputs<span class="hljs-string">": [],
   "</span>source<span class="hljs-string">": [
    "</span>lags = np.arange(</span><span><span class="hljs-number">-500</span></span><span><span class="hljs-punctuation">,</span></span><span> </span><span><span class="hljs-number">1000</span></span><span><span class="hljs-punctuation">,</span></span><span> dt)  # lags from </span><span><span class="hljs-number">-500</span></span><span> to +</span><span><span class="hljs-number">1000</span></span><span> ms\n<span class="hljs-string">",
    "</span>\n<span class="hljs-string">",
    "</span>def gaussian_kernel(lags</span><span><span class="hljs-punctuation">,</span></span><span> mu</span><span><span class="hljs-punctuation">,</span></span><span> sigma)</span><span><span class="hljs-punctuation">:</span></span><span>\n<span class="hljs-string">",
    "</span>    k = np.exp(</span><span><span class="hljs-number">-0.5</span></span><span> * ((lags - mu)/sigma)**</span><span><span class="hljs-number">2</span></span><span>)\n<span class="hljs-string">",
    "</span>    return k / (k.sum() + </span><span><span class="hljs-number">1e-9</span></span><span>)\n<span class="hljs-string">",
    "</span>\n<span class="hljs-string">",
    "</span>kernels = </span><span><span class="hljs-punctuation">{</span></span><span>\n<span class="hljs-string">",
    "</span>    'mSTG'</span><span><span class="hljs-punctuation">:</span></span><span> gaussian_kernel(lags</span><span><span class="hljs-punctuation">,</span></span><span> mu=</span><span><span class="hljs-number">50</span></span><span><span class="hljs-punctuation">,</span></span><span>  sigma=</span><span><span class="hljs-number">40</span></span><span>)</span><span><span class="hljs-punctuation">,</span></span><span>\n<span class="hljs-string">",
    "</span>    'aSTG'</span><span><span class="hljs-punctuation">:</span></span><span> gaussian_kernel(lags</span><span><span class="hljs-punctuation">,</span></span><span> mu=</span><span><span class="hljs-number">150</span></span><span><span class="hljs-punctuation">,</span></span><span> sigma=</span><span><span class="hljs-number">80</span></span><span>)</span><span><span class="hljs-punctuation">,</span></span><span>\n<span class="hljs-string">",
    "</span>    'IFG'</span><span><span class="hljs-punctuation">:</span></span><span>  gaussian_kernel(lags</span><span><span class="hljs-punctuation">,</span></span><span> mu=</span><span><span class="hljs-number">300</span></span><span><span class="hljs-punctuation">,</span></span><span> sigma=</span><span><span class="hljs-number">120</span></span><span>)</span><span><span class="hljs-punctuation">,</span></span><span>\n<span class="hljs-string">",
    "</span>    'TP'</span><span><span class="hljs-punctuation">:</span></span><span>   gaussian_kernel(lags</span><span><span class="hljs-punctuation">,</span></span><span> mu=</span><span><span class="hljs-number">450</span></span><span><span class="hljs-punctuation">,</span></span><span> sigma=</span><span><span class="hljs-number">160</span></span><span>)\n<span class="hljs-string">",
    "</span></span><span><span class="hljs-punctuation">}</span></span><span>\n<span class="hljs-string">",
    "</span>\n<span class="hljs-string">",
    "</span>for region</span><span><span class="hljs-punctuation">,</span></span><span> k in kernels.items()</span><span><span class="hljs-punctuation">:</span></span><span>\n<span class="hljs-string">",
    "</span>    plt.plot(lags</span><span><span class="hljs-punctuation">,</span></span><span> k</span><span><span class="hljs-punctuation">,</span></span><span> label=region)\n<span class="hljs-string">",
    "</span>\n<span class="hljs-string">",
    "</span>plt.axvline(</span><span><span class="hljs-number">0</span></span><span><span class="hljs-punctuation">,</span></span><span> color='k'</span><span><span class="hljs-punctuation">,</span></span><span> linestyle='--'</span><span><span class="hljs-punctuation">,</span></span><span> linewidth=</span><span><span class="hljs-number">0.7</span></span><span>)\n<span class="hljs-string">",
    "</span>plt.xlabel('Lag (ms)')\n<span class="hljs-string">",
    "</span>plt.ylabel('Kernel weight')\n<span class="hljs-string">",
    "</span>plt.title('Region-Specific Temporal Kernels')\n<span class="hljs-string">",
    "</span>plt.legend()\n<span class="hljs-string">",
