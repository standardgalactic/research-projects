</span><span><span class="hljs-keyword">\subsection</span></span><span>{Preservation of Smoothness}

</span><span><span class="hljs-keyword">\begin</span></span><span>{proposition}
If </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Psi</span></span><span> </span><span><span class="hljs-keyword">\in</span></span><span> H</span><span><span class="hljs-built_in">^</span></span><span>k(</span><span><span class="hljs-keyword">\mathcal</span></span><span>{M})</span><span><span class="hljs-built_in">$</span></span><span>, then </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\mathcal</span></span><span>{A}(</span><span><span class="hljs-keyword">\Psi</span></span><span>) </span><span><span class="hljs-keyword">\in</span></span><span> H</span><span><span class="hljs-built_in">^</span></span><span>k(</span><span><span class="hljs-keyword">\mathcal</span></span><span>{M})</span><span><span class="hljs-built_in">$</span></span><span>
