</span><span><span class="hljs-keyword">\|</span></span><span><span class="hljs-keyword">\mathcal</span></span><span>{A}(</span><span><span class="hljs-keyword">\Psi</span></span><span><span class="hljs-built_in">_</span></span><span>1)-</span><span><span class="hljs-keyword">\mathcal</span></span><span>{A}(</span><span><span class="hljs-keyword">\Psi</span></span><span><span class="hljs-built_in">_</span></span><span>2)</span><span><span class="hljs-keyword">\|</span></span><span><span class="hljs-built_in">_</span></span><span>{L</span><span><span class="hljs-built_in">^</span></span><span>2}
</span><span><span class="hljs-keyword">\le</span></span><span>
</span><span><span class="hljs-keyword">\rho</span></span><span><span class="hljs-keyword">\|</span></span><span><span class="hljs-keyword">\Psi</span></span><span><span class="hljs-built_in">_</span></span><span>1-</span><span><span class="hljs-keyword">\Psi</span></span><span><span class="hljs-built_in">_</span></span><span>2</span><span><span class="hljs-keyword">\|</span></span><span><span class="hljs-built_in">_</span></span><span>{L</span><span><span class="hljs-built_in">^</span></span><span>2},
</span><span><span class="hljs-keyword">\qquad</span></span><span>
</span><span><span class="hljs-keyword">\rho</span></span><span> &lt; 1.
