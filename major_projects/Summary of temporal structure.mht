    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"def laplacian(f):\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    \"\"\"Discrete Laplacian using scipy.ndimage\"\"\"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    return laplace(f, mode='reflect')"</span></span><span>
