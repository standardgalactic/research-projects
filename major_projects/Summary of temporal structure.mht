    "</span>            k = idx(i</span><span><span class="hljs-punctuation">,</span></span><span> j)\n<span class="hljs-string">",
    "</span>            L</span><span><span class="hljs-punctuation">[</span></span><span>k</span><span><span class="hljs-punctuation">,</span></span><span> k</span><span><span class="hljs-punctuation">]</span></span><span> = </span><span><span class="hljs-number">-4.0</span></span><span>\n<span class="hljs-string">",
    "</span>            if i &gt; </span><span><span class="hljs-number">0</span></span><span><span class="hljs-punctuation">:</span></span><span>\n<span class="hljs-string">",
