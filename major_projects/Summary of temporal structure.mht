    </span><span><span class="hljs-string">"# initial conditions\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"Phi0 = 0.2 * np.exp(-4*(X**2 + Y**2))\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"vx0 = np.zeros_like(Phi0)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"vy0 = np.zeros_like(Phi0)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"S0  = 0.1 * np.ones_like(Phi0)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"def divergence(vx, vy):\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    dvx_dx = np.gradient(vx, x, axis=1)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    dvy_dy = np.gradient(vy, y, axis=0)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    return dvx_dx + dvy_dy\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"def curl(vx, vy):\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    dvy_dx = np.gradient(vy, x, axis=1)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    dvx_dy = np.gradient(vx, y, axis=0)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    return dvy_dx - dvx_dy\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"def rsvp_step(Phi, vx, vy, S, I_xy, dt=0.005):\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    lapPhi = laplacian_2d(Phi)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    omega  = curl(vx, vy)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    divv   = divergence(vx, vy)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    dPhi = c1 * lapPhi + c2 * (Phi * omega) - c3 * (S * Phi) + k_in * I_xy\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    dvx  = c4 * np.gradient(Phi, x, axis=1) + c5 * np.gradient(omega, x, axis=1) - c6 * (S * vx)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    dvy  = c4 * np.gradient(Phi, y, axis=0) + c5 * np.gradient(omega, y, axis=0) - c6 * (S * vy)\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    dS   = c7 * np.abs(divv) + c8 * (Phi**2) - c9 * S\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    Phi_new = Phi + dt * dPhi\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    vx_new  = vx + dt * dvx\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    vy_new  = vy + dt * dvy\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    S_new   = S + dt * dS\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    return Phi_new, vx_new, vy_new, S_new"</span></span><span>
   </span><span><span class="hljs-punctuation">]</span></span><span>
  </span><span><span class="hljs-punctuation">}</span></span><span><span class="hljs-punctuation">,</span></span><span>
