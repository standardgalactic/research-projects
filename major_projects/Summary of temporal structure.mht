7 6.136 4.40303 6.07083 4.80371 6.03809C5.14051 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-lean"><span>import Mathlib.Topology.Algebra.Algebra
import Mathlib.Topology.ContinuousFunction.Basic
import Amplistwistor.Definitions

/-!
# Algebras Generated by Amplistwistors

This file develops the algebraic structure induced by amplitwistors on the
space of continuous fields `M → F`. We will use this later as the basis for
universal approximation results via Stone–Weierstrass.
-/

universe u v

namespace Amplistwistor

open scoped BigOperators

variable {M : Type u} {F : Type v}
variable [TopologicalSpace M] [NormedAddCommGroup F] [NormedSpace ℝ F]

/--
A continuous field `Ψ : M → F` is `A`-generated if it can be written as a
finite linear combination of iterated amplitwistor actions applied to some
base fields. This is a deliberately coarse notion; the precise combinatorial
closure will be formalized via a subalgebra below.
-/
def generatedBy (A : Amplistwistor M F) (𝒞 : Set (M → F)) : Set (M → F) :=
  { Ψ | ∃ n : ℕ, ∃ (Ψ₀ : M → F),
      Ψ₀ ∈ 𝒞 ∧ Ψ = (Nat.rec Ψ₀ (fun _ Ψ' =&gt; actField A Ψ') n) }

/--
The amplitwistor algebra `𝒜(A)` is defined as the smallest subalgebra of
`C(M, ℝ)` containing all real-valued coordinate projections of `A`-generated
fields. For the purposes of this skeleton, we treat it as an abstract
subalgebra; concrete constructions will be supplied later in dedicated files.
-/
structure AmplistwistorAlgebra (M : Type u) [TopologicalSpace M] where
  carrier : Subsemiring C(M, ℝ)

end Amplistwistor
</span></code></div></div></pre>
<p data-start="5911" data-end="6094">This is intentionally slightly schematic. The real work will be to pin down exactly which continuous functions you regard as generated by amplitwistors, but the structure is in place.</p>
<hr data-start="6096" data-end="6099">
