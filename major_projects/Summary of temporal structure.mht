   </span><span><span class="hljs-attr">"source"</span></span><span><span class="hljs-punctuation">:</span></span><span> </span><span><span class="hljs-punctuation">[</span></span><span>
    </span><span><span class="hljs-string">"# RSVP parameters\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"c1, c2, c3 = 0.4, 0.8, 0.25\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"c4, c5, c6 = 1.0, 0.3, 0.4\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
