    </span><span><span class="hljs-string">"def build_laplacian_matrix(N):\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    \"\"\"Constructs a discrete 2D Laplacian matrix.\"\"\"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    L = np.zeros((N*N, N*N))\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    def idx(i,j): return i*N + j\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"    for i in range(N):\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
    </span><span><span class="hljs-string">"        for j in range(N):\n"</span></span><span><span class="hljs-punctuation">,</span></span><span>
