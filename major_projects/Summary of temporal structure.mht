</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># Project Initialization Script</span></span><span>
</span><span><span class="hljs-comment"># Creates full LaTeX directory structure for the manuscript:</span></span><span>
</span><span><span class="hljs-comment">#   "Cortical Columns as Amplitwistor Cascades"</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>

PROJECT_NAME=</span><span><span class="hljs-string">"amplistwistor_cortical_columns"</span></span><span>
ROOT_DIR=</span><span><span class="hljs-string">"<span class="hljs-variable">${PROJECT_NAME}</span></span></span><span>"

</span><span><span class="hljs-built_in">echo</span></span><span> </span><span><span class="hljs-string">"Initializing LaTeX project: <span class="hljs-variable">${PROJECT_NAME}</span></span></span><span>"
</span><span><span class="hljs-built_in">echo</span></span><span> </span><span><span class="hljs-string">""</span></span><span>

</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># Create root directory</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-keyword">if</span></span><span> [ ! -d </span><span><span class="hljs-string">"<span class="hljs-variable">$ROOT_DIR</span></span></span><span>" ]; </span><span><span class="hljs-keyword">then</span></span><span>
    </span><span><span class="hljs-built_in">mkdir</span></span><span> </span><span><span class="hljs-string">"<span class="hljs-variable">$ROOT_DIR</span></span></span><span>"
    </span><span><span class="hljs-built_in">echo</span></span><span> </span><span><span class="hljs-string">"Created project directory: <span class="hljs-variable">$ROOT_DIR</span></span></span><span>"
</span><span><span class="hljs-keyword">else</span></span><span>
    </span><span><span class="hljs-built_in">echo</span></span><span> </span><span><span class="hljs-string">"Directory '<span class="hljs-variable">$ROOT_DIR</span></span></span><span>' already exists."
</span><span><span class="hljs-keyword">fi</span></span><span>

</span><span><span class="hljs-built_in">cd</span></span><span> </span><span><span class="hljs-string">"<span class="hljs-variable">$ROOT_DIR</span></span></span><span>" || </span><span><span class="hljs-built_in">exit</span></span><span> 1

</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
</span><span><span class="hljs-comment"># Create subdirectories</span></span><span>
</span><span><span class="hljs-comment"># ------------------------------------------------------------</span></span><span>
