# Editor / IDE state
# ------------------------------------------------------------

.vscode/
.idea/

*.code-workspace

.project
.classpath
.settings/

.history/

Session.vim
.netrwhist


# ------------------------------------------------------------
# macOS
# ------------------------------------------------------------

.DS_Store
.AppleDouble
.LSOverride

._*

.Spotlight-V100
.Trashes
.fseventsd


# ------------------------------------------------------------
# Windows
# ------------------------------------------------------------

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

Desktop.ini
$RECYCLE.BIN/

# Exported NTFS alternate-stream metadata
*:Zone.Identifier
*.Zone.Identifier


# ------------------------------------------------------------
# Linux filesystem debris
# ------------------------------------------------------------

.directory
.Trash-*
.nfs*


# ------------------------------------------------------------
# Temporary audio/video processing
#
# Final MP3/WAV/MP4/etc. remain tracked.
# ------------------------------------------------------------

compressed_*.mp3
temp_*.mp3
tmp_*.mp3

*.tmp.mp3
*.tmp.wav
*.tmp.mp4

ffmpeg2pass-*
*.ffindex

*.part
*.partial


# ------------------------------------------------------------
# Database runtime files
# Keep the actual database; ignore transient journal state.
# ------------------------------------------------------------

*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

*.db-journal
*.db-wal
*.db-shm


# ------------------------------------------------------------
# Generated documentation
# ------------------------------------------------------------

docs/_build/


# ------------------------------------------------------------
# Archives
#
# Usually redundant packaging. Remove these rules if archives
# themselves form part of the research record.
# ------------------------------------------------------------

*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tbz2
*.tar.xz
*.txz
*.zip
*.7z
*.rar


# ------------------------------------------------------------
# Explicitly retain important research artifacts
# ------------------------------------------------------------

!*.tex
!*.bib
!*.pdf

!*.md
!*.txt

!*.html
!*.htm
!*.mht
!*.mhtml

!*.py
!*.rs
!*.lean
!*.ipynb

!*.csv

!*.png
!*.jpg
!*.jpeg
!*.webp
!*.svg

!*.mp3
!*.wav
!*.flac
!*.ogg
!*.opus
!*.mp4
!*.webm

!*.vtt
