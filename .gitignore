# ============================================================
# research-projects
#
# Keep primary research artifacts, especially:
#   .tex .bib .pdf .md .txt
#   figures and final media
#
# Exclude generated metadata, build products, caches,
# temporary processing files, and local machine state.
# ============================================================


# ------------------------------------------------------------
# Existing repository-specific exclusions
# ------------------------------------------------------------

*.vector

*.tsv
*.srt
*.json

.reflog
icepick_snapshot.txt

.env


# ------------------------------------------------------------
# LaTeX
# Keep *.tex, *.bib and *.pdf
# ------------------------------------------------------------

*.aux
*.bbl
*.bcf
*.blg
*.brf
*.dvi
*.fdb_latexmk
*.fls
*.fmt
*.fot
*.lof
*.lol
*.lot
*.log
*.nav
*.out
*.run.xml
*.snm
*.synctex
*.synctex.gz
*.synctex.gz(busy)
*.tdo
*.toc
*.vrb
*.xdv


# Glossaries / indexes / nomenclature
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.glsdefs
*.idx
*.ilg
*.ind
*.ist
*.loa
*.maf
*.mtc
*.mtc0
*.nlo
*.nls
*.slg
*.slo
*.sls

# minted / Pygments
_minted-*/
minted-*/
*.pyg
*.pygtex
*.pygstyle

# Beamer / miscellaneous TeX intermediates
*.head
*.pre
*.latexmain
*.figlist


