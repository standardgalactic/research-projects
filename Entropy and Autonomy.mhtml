<span class="line"><span style="color: rgb(220, 220, 170);">\date</span><span style="color: rgb(230, 230, 230);">{November 7, 2025}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(106, 153, 85);">% ===========================================</span></span>
