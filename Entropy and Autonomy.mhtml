<span class="line"><span style="color: rgb(230, 230, 230);">Huxley </span><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(230, 230, 230);"> Pacification </span><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(230, 230, 230);"> Assumes a coherent hedonistic equilibrium </span><span style="color: rgb(197, 134, 192);">\\</span></span>
