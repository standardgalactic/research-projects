ex-mono); line-height: 1.5em; background-color: hsl(var(--surface-inset)); color: var(--fg-primary); display: block; overflow: auto;"><pre class="shiki slack-dark" tabindex="0" style="background-color: rgb(34, 34, 34); color: rgb(230, 230, 230);"><code><span class="line"><span style="color: rgb(220, 220, 170);">\section</span><span style="color: rgb(230, 230, 230);">{Field Equations, Failure Modes, and How to Reopen the Future}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">If Parts 2--3 diagnose the disease, Part 4 is the immune system blueprint.</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">We now formalize:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">enumerate</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(230, 230, 230);"> The differential equations of entropic authoritarianism</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(230, 230, 230);"> Its phase transition point</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(230, 230, 230);"> The operators that restore agency</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(230, 230, 230);"> The final result: a conservation law for cognitive possibility</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">enumerate</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\subsection</span><span style="color: rgb(230, 230, 230);">{Field Equations of Behavioral Capture}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Recall the two fundamental RSVP fields:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">itemize</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(230, 230, 230);"> Scalar potential: </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> ‚Äî semantic possibility, or ``uncommitted meaning-space'' </span><span style="color: rgb(197, 134, 192);">\cite</span><span style="color: rgb(230, 230, 230);">{jaynes1957information}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(230, 230, 230);"> Vector flow: </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">\vec{v}</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> ‚Äî directed agency, intention, propagation of choice </span><span style="color: rgb(197, 134, 192);">\cite</span><span style="color: rgb(230, 230, 230);">{bateson1972ecology}</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">itemize</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">We define behavioral capture intensity </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\beta</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> as a damping field that deforms both:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">align</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\frac{</span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);">}{</span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(78, 201, 176);"> t} </span><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(78, 201, 176);">= D_</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(86, 156, 214);"> \nabla</span><span style="color: rgb(78, 201, 176);">^</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);"> - </span><span style="color: rgb(86, 156, 214);">\beta</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);"> + </span><span style="color: rgb(86, 156, 214);">\eta</span><span style="color: rgb(78, 201, 176);">_</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(197, 134, 192);"> \label</span><span style="color: rgb(78, 201, 176);">{</span><span style="color: rgb(156, 220, 254);">eq:phi_capture</span><span style="color: rgb(78, 201, 176);">} </span><span style="color: rgb(197, 134, 192);">\\</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\frac{</span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(78, 201, 176);"> \vec{v}}{</span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(78, 201, 176);"> t} </span><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(78, 201, 176);">= D_v </span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(78, 201, 176);">^</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(78, 201, 176);"> \vec{v} - </span><span style="color: rgb(86, 156, 214);">\beta</span><span style="color: rgb(78, 201, 176);"> \vec{v} + </span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);"> + </span><span style="color: rgb(86, 156, 214);">\eta</span><span style="color: rgb(78, 201, 176);">_v </span><span style="color: rgb(197, 134, 192);">\label</span><span style="color: rgb(78, 201, 176);">{</span><span style="color: rgb(156, 220, 254);">eq:v_capture</span><span style="color: rgb(78, 201, 176);">}</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">align</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Where:</span></span>
<span class="line"></span>
