<span class="line"><span style="color: rgb(78, 201, 176);">    =</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">    \begin</span><span style="color: rgb(78, 201, 176);">{</span><span style="color: rgb(156, 220, 254);">pmatrix</span><span style="color: rgb(78, 201, 176);">}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">        \Phi</span><span style="color: rgb(78, 201, 176);"> + </span><span style="color: rgb(86, 156, 214);">\eta</span><span style="color: rgb(86, 156, 214);"> \nabla</span><span style="color: rgb(78, 201, 176);">^</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);"> - </span><span style="color: rgb(86, 156, 214);">\alpha</span><span style="color: rgb(78, 201, 176);"> R(</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">) </span><span style="color: rgb(197, 134, 192);">\\</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">        \mathbf{v} - </span><span style="color: rgb(86, 156, 214);">\mu</span><span style="color: rgb(86, 156, 214);"> \nabla</span><span style="color: rgb(78, 201, 176);">(</span><span style="color: rgb(86, 156, 214);">\nabla\cdot</span><span style="color: rgb(78, 201, 176);">\mathbf{v}) + </span><span style="color: rgb(86, 156, 214);">\nu</span><span style="color: rgb(86, 156, 214);"> \nabla</span><span style="color: rgb(86, 156, 214);"> \times</span><span style="color: rgb(78, 201, 176);"> \mathbf{v}</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">    \end</span><span style="color: rgb(78, 201, 176);">{</span><span style="color: rgb(156, 220, 254);">pmatrix</span><span style="color: rgb(78, 201, 176);">}</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">equation</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">with:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">- </span><span style="color: rgb(78, 201, 176);">\(</span><span style="color: rgb(86, 156, 214);">\eta</span><span style="color: rgb(78, 201, 176);"> &gt; </span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);">\)</span><span style="color: rgb(230, 230, 230);">: semantic diffusion (re-spreads distinct possibilities),</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">- </span><span style="color: rgb(78, 201, 176);">\(</span><span style="color: rgb(86, 156, 214);">\alpha</span><span style="color: rgb(78, 201, 176);"> &gt; </span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);">\)</span><span style="color: rgb(230, 230, 230);">: entropic pruning of dominant attractors,</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">- </span><span style="color: rgb(78, 201, 176);">\(</span><span style="color: rgb(86, 156, 214);">\mu</span><span style="color: rgb(78, 201, 176);"> &gt; </span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);">\)</span><span style="color: rgb(230, 230, 230);">: agency divergence damping,</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">- </span><span style="color: rgb(78, 201, 176);">\(</span><span style="color: rgb(86, 156, 214);">\nu</span><span style="color: rgb(78, 201, 176);"> &gt; </span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);">\)</span><span style="color: rgb(230, 230, 230);">: reintroduction of rotational agency (non-funneling degrees of freedom),</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">- </span><span style="color: rgb(78, 201, 176);">\(</span><span style="color: rgb(78, 201, 176);">R(</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">)</span><span style="color: rgb(78, 201, 176);">\)</span><span style="color: rgb(230, 230, 230);">: nonlinear renormalization potential restoring curvature to flat </span><span style="color: rgb(78, 201, 176);">\(</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">\)</span><span style="color: rgb(230, 230, 230);"> basins.</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">A canonical choice for </span><span style="color: rgb(78, 201, 176);">\(</span><span style="color: rgb(78, 201, 176);">R(</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">)</span><span style="color: rgb(78, 201, 176);">\)</span><span style="color: rgb(230, 230, 230);"> is:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">equation</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">    R(</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">) = </span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);"> - </span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">_</span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);"> - </span><span style="color: rgb(86, 156, 214);">\beta</span><span style="color: rgb(78, 201, 176);"> (</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);"> - </span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">_</span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);">)^</span><span style="color: rgb(181, 206, 168);">3</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">equation</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">which pushes flattened regions toward a target variance </span><span style="color: rgb(78, 201, 176);">\(</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">_</span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);">\)</span><span style="color: rgb(230, 230, 230);"> while preventing runaway instability.</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\section</span><span style="color: rgb(230, 230, 230);">{Restoration is the Dual of Capture}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Capture dynamics drive:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(215, 186, 125);">\|</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(215, 186, 125);">\|</span><span style="color: rgb(78, 201, 176);"> \to </span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);">, \quad </span><span style="color: rgb(215, 186, 125);">\|</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \cdot</span><span style="color: rgb(78, 201, 176);"> \mathbf{v}</span><span style="color: rgb(215, 186, 125);">\|</span><span style="color: rgb(78, 201, 176);"> \to </span><span style="color: rgb(86, 156, 214);">\infty</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Restoration dynamics enforce the opposite:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(215, 186, 125);">\|</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(215, 186, 125);">\|</span><span style="color: rgb(78, 201, 176);"> \to \text{nonzero}, \quad </span><span style="color: rgb(215, 186, 125);">\|</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \cdot</span><span style="color: rgb(78, 201, 176);"> \mathbf{v}</span><span style="color: rgb(215, 186, 125);">\|</span><span style="color: rgb(78, 201, 176);"> \to </span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);">, \quad </span><span style="color: rgb(215, 186, 125);">\|</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \times</span><span style="color: rgb(78, 201, 176);"> \mathbf{v}</span><span style="color: rgb(215, 186, 125);">\|</span><span style="color: rgb(78, 201, 176);"> &gt; </span><span style="color: rgb(181, 206, 168);">0</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
