<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Three restoration operators:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">align</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\text{Diversification}: </span><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(78, 201, 176);"> \quad </span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(78, 201, 176);">^</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(86, 156, 214);"> \rightarrow</span><span style="color: rgb(78, 201, 176);"> + </span><span style="color: rgb(197, 134, 192);">\\</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\text{Decentralization}: </span><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(78, 201, 176);"> \quad </span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \cdot</span><span style="color: rgb(78, 201, 176);"> \vec{v} </span><span style="color: rgb(86, 156, 214);">\rightarrow</span><span style="color: rgb(181, 206, 168);"> 0</span><span style="color: rgb(197, 134, 192);"> \\</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\text{Re-entropization}: </span><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(78, 201, 176);"> \quad S </span><span style="color: rgb(86, 156, 214);">\rightarrow</span><span style="color: rgb(78, 201, 176);"> S + </span><span style="color: rgb(86, 156, 214);">\epsilon</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">align</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">A resilient civilization maximizes:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\mathcal{L} = </span><span style="color: rgb(86, 156, 214);">\int</span><span style="color: rgb(78, 201, 176);"> \left( |</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);">|^</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(78, 201, 176);"> - |</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \cdot</span><span style="color: rgb(78, 201, 176);"> \vec{v}|^</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(78, 201, 176);"> + </span><span style="color: rgb(86, 156, 214);">\alpha</span><span style="color: rgb(78, 201, 176);"> S \right) dV</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
