<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\section</span><span style="color: rgb(230, 230, 230);">{Nash Equilibria of Competing Capture Agents}</span></span>
<span class="line"></span>
