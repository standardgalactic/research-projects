<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\frac{</span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(78, 201, 176);"> V_i}{</span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);">} + </span><span style="color: rgb(86, 156, 214);">\sum</span><span style="color: rgb(78, 201, 176);">_{j </span><span style="color: rgb(86, 156, 214);">\neq</span><span style="color: rgb(78, 201, 176);"> i} \frac{</span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(78, 201, 176);"> V_j}{</span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);">} = </span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);"> \quad </span><span style="color: rgb(86, 156, 214);">\forall</span><span style="color: rgb(78, 201, 176);"> i</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
