<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\section</span><span style="color: rgb(230, 230, 230);">{Core Fields and Their Interpretation}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">definition</span><span style="color: rgb(230, 230, 230);">}[Semantic Possibility Field]</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">A differentiable manifold field </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);"> : \mathcal{M} </span><span style="color: rgb(86, 156, 214);">\rightarrow</span><span style="color: rgb(78, 201, 176);"> \mathbb{R}</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> representing the local density of</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">viable meaning trajectories. Large </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">|</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);">|</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> implies novelty, recombination, and interpretive expansion.</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Small </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">|</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);">|</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> implies semantic exhaustion or behavioral freezing </span><span style="color: rgb(197, 134, 192);">\cite</span><span style="color: rgb(230, 230, 230);">{shannon1948mathematical}.</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">definition</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">definition</span><span style="color: rgb(230, 230, 230);">}[Agency Flow Field]</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">A vector field </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">\mathbf{v} : \mathcal{M} </span><span style="color: rgb(86, 156, 214);">\rightarrow</span><span style="color: rgb(78, 201, 176);"> T\mathcal{M}</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> encoding the directional propagation of</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">attention, choice, influence, and intent. Healthy systems approximate local incompressibility</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">(</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \cdot</span><span style="color: rgb(78, 201, 176);"> \mathbf{v} </span><span style="color: rgb(86, 156, 214);">\approx</span><span style="color: rgb(181, 206, 168);"> 0</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);">), indicating reciprocal agency instead of directional extraction </span><span style="color: rgb(197, 134, 192);">\cite</span><span style="color: rgb(230, 230, 230);">{bateson1972ecology}.</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">definition</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">definition</span><span style="color: rgb(230, 230, 230);">}[Behavioral Capture Pressure]</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">A scalar coefficient </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\beta</span><span style="color: rgb(78, 201, 176);"> &gt; </span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> encoding optimization pressure toward predictability, personalization,</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">and behavioral regularization enforced by digital inference systems </span><span style="color: rgb(197, 134, 192);">\cite</span><span style="color: rgb(230, 230, 230);">{friston2010freeenergy}.</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">definition</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\section</span><span style="color: rgb(230, 230, 230);">{Governing Dynamics}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">The minimal coupled system is:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">align</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\frac{</span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);">}{</span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(78, 201, 176);"> t} </span><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(78, 201, 176);">= D_</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(86, 156, 214);"> \nabla</span><span style="color: rgb(78, 201, 176);">^</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);"> - </span><span style="color: rgb(86, 156, 214);">\beta</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);"> + </span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \cdot</span><span style="color: rgb(78, 201, 176);"> \mathbf{v} </span><span style="color: rgb(197, 134, 192);">\label</span><span style="color: rgb(78, 201, 176);">{</span><span style="color: rgb(156, 220, 254);">eq:phi</span><span style="color: rgb(78, 201, 176);">} </span><span style="color: rgb(197, 134, 192);">\\</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\frac{</span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(78, 201, 176);"> \mathbf{v}}{</span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(78, 201, 176);"> t} </span><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(78, 201, 176);">= D_v </span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(78, 201, 176);">^</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(78, 201, 176);"> \mathbf{v} - </span><span style="color: rgb(86, 156, 214);">\beta</span><span style="color: rgb(78, 201, 176);"> \mathbf{v} + </span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(197, 134, 192);"> \label</span><span style="color: rgb(78, 201, 176);">{</span><span style="color: rgb(156, 220, 254);">eq:v</span><span style="color: rgb(78, 201, 176);">}</span></span>
