% CHAPTER 18: Boundary Conditions and Semantic Manifold Embeddings
% ===========================================</p>
<p dir="auto" class="break-words" style="white-space: pre-wrap;">\chapter{Boundary Conditions and Semantic Manifold Embeddings}</p>
<p dir="auto" class="break-words" style="white-space: pre-wrap;">\epigraph{``A mind has edges even when it denies them.''}{H. Weyl (misattributed)}</p>
<p dir="auto" class="break-words" style="white-space: pre-wrap;">Boundary conditions determine the global topology of cognitive possibility. Three classes are central:</p>
<p dir="auto" class="break-words" style="white-space: pre-wrap;">\section{Closed Semantic Worlds}</p>
<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi mathvariant="normal">Œ¶</mi><msub><mi mathvariant="normal">‚à£</mi><mrow><mi mathvariant="normal">‚àÇ</mi><mi mathvariant="script">M</mi></mrow></msub><mo>=</mo><mo>+</mo><mi mathvariant="normal">‚àû</mi><mspace width="1em"></mspace><mo>‚áí</mo><mspace width="1em"></mspace><mtext>reflective&nbsp;boundary,&nbsp;no&nbsp;semantic&nbsp;escape</mtext></mrow><annotation encoding="application/x-tex">\Phi|_{\partial \mathcal{M}} = +\infty \quad \Rightarrow \quad \text{reflective boundary, no semantic escape}</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mord">Œ¶</span><span class="mord"><span class="mord">‚à£</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3361em;"><span style="top: -2.55em; margin-left: 0em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mtight" style="margin-right: 0.05556em;">‚àÇ</span><span class="mord mathcal mtight">M</span></span></span></span></span><span class="vlist-s">‚Äã</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span></span></span></span></span></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6667em; vertical-align: -0.0833em;"></span><span class="mord">+</span><span class="mord">‚àû</span><span class="mspace" style="margin-right: 1em;"></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">‚áí</span><span class="mspace" style="margin-right: 1em;"></span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.8889em; vertical-align: -0.1944em;"></span><span class="mord text"><span class="mord">reflective&nbsp;boundary,&nbsp;no&nbsp;semantic&nbsp;escape</span></span></span></span></span></span>
<p dir="auto" class="break-words" style="white-space: pre-wrap;">\section{Open Semantic Exchange}</p>
<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><msub><mi mathvariant="normal">‚àÇ</mi><mi>n</mi></msub><mi mathvariant="normal">Œ¶</mi><msub><mi mathvariant="normal">‚à£</mi><mrow><mi mathvariant="normal">‚àÇ</mi><mi mathvariant="script">M</mi></mrow></msub><mo>=</mo><mn>0</mn><mspace width="1em"></mspace><mo>‚áí</mo><mspace width="1em"></mspace><mtext>no&nbsp;semantic&nbsp;flux&nbsp;loss</mtext></mrow><annotation encoding="application/x-tex">\partial_n \Phi|_{\partial \mathcal{M}} = 0 \quad \Rightarrow \quad \text{no semantic flux loss}</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mord"><span class="mord" style="margin-right: 0.05556em;">‚àÇ</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.1514em;"><span style="top: -2.55em; margin-left: -0.0556em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mathnormal mtight">n</span></span></span></span><span class="vlist-s">‚Äã</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span></span></span></span></span></span></span><span class="mord">Œ¶</span><span class="mord"><span class="mord">‚à£</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3361em;"><span style="top: -2.55em; margin-left: 0em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mtight" style="margin-right: 0.05556em;">‚àÇ</span><span class="mord mathcal mtight">M</span></span></span></span></span><span class="vlist-s">‚Äã</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span></span></span></span></span></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6444em;"></span><span class="mord">0</span><span class="mspace" style="margin-right: 1em;"></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">‚áí</span><span class="mspace" style="margin-right: 1em;"></span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6944em;"></span><span class="mord text"><span class="mord">no&nbsp;semantic&nbsp;flux&nbsp;loss</span></span></span></span></span></span>
<p dir="auto" class="break-words" style="white-space: pre-wrap;">\section{Absorbing Institutional Boundaries}</p>
<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi mathvariant="normal">Œ¶</mi><msub><mi mathvariant="normal">‚à£</mi><mrow><mi mathvariant="normal">‚àÇ</mi><mi mathvariant="script">M</mi></mrow></msub><mo>=</mo><mn>0</mn><mspace width="1em"></mspace><mo>‚áí</mo><mspace width="1em"></mspace><mtext>semantic&nbsp;collapse&nbsp;at&nbsp;boundary</mtext></mrow><annotation encoding="application/x-tex">\Phi|_{\partial \mathcal{M}} = 0 \quad \Rightarrow \quad \text{semantic collapse at boundary}</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mord">Œ¶</span><span class="mord"><span class="mord">‚à£</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3361em;"><span style="top: -2.55em; margin-left: 0em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mtight" style="margin-right: 0.05556em;">‚àÇ</span><span class="mord mathcal mtight">M</span></span></span></span></span><span class="vlist-s">‚Äã</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span></span></span></span></span></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6444em;"></span><span class="mord">0</span><span class="mspace" style="margin-right: 1em;"></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">‚áí</span><span class="mspace" style="margin-right: 1em;"></span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.8889em; vertical-align: -0.1944em;"></span><span class="mord text"><span class="mord">semantic&nbsp;collapse&nbsp;at&nbsp;boundary</span></span></span></span></span></span>
<p dir="auto" class="break-words" style="white-space: pre-wrap;">\begin{theorem}[Boundary Collapse Criterion]
\begin{boxed}
If any nonzero measure subset of <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi mathvariant="normal">‚àÇ</mi><mi mathvariant="script">M</mi></mrow><annotation encoding="application/x-tex">\partial \mathcal{M}</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.6944em;"></span><span class="mord" style="margin-right: 0.05556em;">‚àÇ</span><span class="mord mathcal">M</span></span></span></span> obeys <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi mathvariant="normal">Œ¶</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Phi=0</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.6833em;"></span><span class="mord">Œ¶</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6444em;"></span><span class="mord">0</span></span></span></span>, then in finite time:</p>
<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><munder><mrow><mi>min</mi><mo>‚Å°</mo></mrow><mrow><mi>x</mi><mo>‚àà</mo><mi mathvariant="script">M</mi></mrow></munder><mi mathvariant="normal">Œ¶</mi><mo stretchy="false">(</mo><mi>x</mi><mo separator="true">,</mo><mi>t</mi><mo stretchy="false">)</mo><mo>‚Üí</mo><mn>0.</mn></mrow><annotation encoding="application/x-tex">\min_{x \in \mathcal{M}} \Phi(x,t) \to 0.</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 1.5217em; vertical-align: -0.7717em;"></span><span class="mop op-limits"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.6679em;"><span style="top: -2.3557em; margin-left: 0em;"><span class="pstrut" style="height: 3em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mathnormal mtight">x</span><span class="mrel mtight">‚àà</span><span class="mord mathcal mtight">M</span></span></span></span><span style="top: -3em;"><span class="pstrut" style="height: 3em;"></span><span><span class="mop">min</span></span></span></span><span class="vlist-s">‚Äã</span></span><span class="vlist-r"><span class="vlist" style="height: 0.7717em;"><span></span></span></span></span></span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="mord">Œ¶</span><span class="mopen">(</span><span class="mord mathnormal">x</span><span class="mpunct">,</span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="mord mathnormal">t</span><span class="mclose">)</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">‚Üí</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6444em;"></span><span class="mord">0.</span></span></span></span></span>
<p dir="auto" class="break-words" style="white-space: pre-wrap;">\end{boxed}
\end{theorem}</p>
<p dir="auto" class="break-words" style="white-space: pre-wrap;">\begin{proof}
The Laplacian enforces diffusion. A Dirichlet zero boundary introduces a sink. Comparison principles for parabolic PDEs ensure monotonic lowering of the global infimum.
\end{proof}</p>
