<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">theorem</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\section</span><span style="color: rgb(230, 230, 230);">{Restoration Equilibria}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">A restorative institution adds:</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">V_{\text{rest}} = + </span><span style="color: rgb(86, 156, 214);">\kappa</span><span style="color: rgb(215, 186, 125);"> \|</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(215, 186, 125);">\|</span><span style="color: rgb(78, 201, 176);">^</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(78, 201, 176);"> - </span><span style="color: rgb(86, 156, 214);">\mu</span><span style="color: rgb(78, 201, 176);"> (</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \cdot</span><span style="color: rgb(78, 201, 176);"> \mathbf{v})^</span><span style="color: rgb(181, 206, 168);">2</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Stability requires:</span></span>
