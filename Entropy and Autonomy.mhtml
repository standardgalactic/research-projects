<span class="line"><span style="color: rgb(86, 156, 214);">\lambda</span><span style="color: rgb(78, 201, 176);"> &gt; </span><span style="color: rgb(86, 156, 214);">\lambda</span><span style="color: rgb(78, 201, 176);">_c = \frac{D_S </span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(78, 201, 176);">^</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(78, 201, 176);"> S}{|</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \cdot</span><span style="color: rgb(78, 201, 176);"> \vec{v}|}</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">equation</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Empirical simulations suggest </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\lambda</span><span style="color: rgb(78, 201, 176);">_c </span><span style="color: rgb(86, 156, 214);">\approx</span><span style="color: rgb(181, 206, 168);"> 0.42</span><span style="color: rgb(86, 156, 214);"> \pm</span><span style="color: rgb(181, 206, 168);"> 0.03</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> in normalized sociocognitive units.</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(106, 153, 85);">% ------------------------------------------------------------</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\chapter</span><span style="color: rgb(230, 230, 230);">{Behavioral Capture as Energy Landscape Collapse}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Given a decision-manifold </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">\mathcal{M}</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> with local degrees of freedom </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">x_i</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);">:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">H = </span><span style="color: rgb(86, 156, 214);">\int</span><span style="color: rgb(78, 201, 176);">_{\mathcal{M}} \left( \frac{</span><span style="color: rgb(181, 206, 168);">1</span><span style="color: rgb(78, 201, 176);">}{</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(78, 201, 176);">} |</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);">|^</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(78, 201, 176);"> + V(S) - \vec{v} </span><span style="color: rgb(86, 156, 214);">\cdot</span><span style="color: rgb(86, 156, 214);"> \nabla</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);"> \right) dV</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">with potential:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">V(S) = \frac{</span><span style="color: rgb(181, 206, 168);">1</span><span style="color: rgb(78, 201, 176);">}{</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(78, 201, 176);">} k S^</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(78, 201, 176);"> - </span><span style="color: rgb(86, 156, 214);">\kappa</span><span style="color: rgb(78, 201, 176);"> S^</span><span style="color: rgb(181, 206, 168);">3</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Behavioral capture imposes a non-linear cubic well, producing three regimes:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">itemize</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(230, 230, 230);"> Stable agency (diverse choices, shallow minima)</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(230, 230, 230);"> Competing narratives (multi-minima metastability)</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(230, 230, 230);"> Collapse to a capture well (authoritarian attractor)</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">itemize</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">When AI platforms reinforce choices proportional to predicted engagement </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">E</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);">:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">P(\text{choice}) </span><span style="color: rgb(86, 156, 214);">\propto</span><span style="color: rgb(78, 201, 176);"> e^{</span><span style="color: rgb(86, 156, 214);">\beta</span><span style="color: rgb(78, 201, 176);"> E}</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">the landscape loses convexity, guaranteeing path-dependent lock-in.</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(106, 153, 85);">% ------------------------------------------------------------</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\chapter</span><span style="color: rgb(230, 230, 230);">{Topology of Moral Vortices}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">A moral-vortex is defined as a closed circulation in the agency field:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\oint</span><span style="color: rgb(78, 201, 176);">_{</span><span style="color: rgb(86, 156, 214);">\Gamma</span><span style="color: rgb(78, 201, 176);">} \vec{v} </span><span style="color: rgb(86, 156, 214);">\cdot</span><span style="color: rgb(78, 201, 176);"> d</span><span style="color: rgb(86, 156, 214);">\ell</span><span style="color: rgb(86, 156, 214);"> \neq</span><span style="color: rgb(181, 206, 168);"> 0</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Its stability is determined by its vorticity magnitude:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\Omega</span><span style="color: rgb(78, 201, 176);"> = </span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \times</span><span style="color: rgb(78, 201, 176);"> \vec{v}</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Toxic affect loops form when:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\frac{</span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(86, 156, 214);"> \Omega</span><span style="color: rgb(78, 201, 176);">}{</span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(78, 201, 176);"> t} &gt; </span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);"> \quad \text{and} \quad </span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \cdot</span><span style="color: rgb(78, 201, 176);"> \vec{v} &lt; </span><span style="color: rgb(181, 206, 168);">0</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">meaning agency spirals inward without semantic propagation.</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">The maximal polarization state corresponds to:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">equation</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">|</span><span style="color: rgb(86, 156, 214);">\Omega</span><span style="color: rgb(78, 201, 176);">| </span><span style="color: rgb(86, 156, 214);">\rightarrow</span><span style="color: rgb(181, 206, 168);"> 1</span><span style="color: rgb(78, 201, 176);">,\quad </span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(78, 201, 176);"> S </span><span style="color: rgb(86, 156, 214);">\rightarrow</span><span style="color: rgb(181, 206, 168);"> 0</span><span style="color: rgb(78, 201, 176);"> \quad \text{(static, cyclic outrage state)}</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">equation</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(106, 153, 85);">% ------------------------------------------------------------</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\chapter</span><span style="color: rgb(230, 230, 230);">{Information Monopoles and Field Centralization}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">An information monopole is defined by field flux imbalance:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">_{\text{out}} = </span><span style="color: rgb(86, 156, 214);">\oint</span><span style="color: rgb(78, 201, 176);">_S \vec{v} </span><span style="color: rgb(86, 156, 214);">\cdot</span><span style="color: rgb(78, 201, 176);"> d\vec{A}</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">For a decentralized system:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\sum</span><span style="color: rgb(78, 201, 176);">_i </span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">_{\text{out},i} = </span><span style="color: rgb(181, 206, 168);">0</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">For platform monopolization:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">|</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">_{\text{out,major}}| </span><span style="color: rgb(86, 156, 214);">\gg</span><span style="color: rgb(78, 201, 176);"> |</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">_{\text{out,others}}|</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Field collapse occurs when the entropy gradient aligns with the vector potential:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(78, 201, 176);"> S </span><span style="color: rgb(86, 156, 214);">\parallel</span><span style="color: rgb(78, 201, 176);"> \vec{v}</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">This eliminates degrees of freedom orthogonal to platform-incentive directions.</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(106, 153, 85);">% ------------------------------------------------------------</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\chapter</span><span style="color: rgb(230, 230, 230);">{LLMs as Low-Curvature Semantic Surfaces}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Semantic curvature is defined as:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\mathcal{K} = \det(</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(78, 201, 176);">^</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);">)</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Human discourse exhibits mixed curvature (</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">\mathcal{K} &gt; </span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> generative regions, </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">\mathcal{K} &lt; </span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> exploratory regions).</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">LLMs exhibit:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\mathcal{K}_{LLM} </span><span style="color: rgb(86, 156, 214);">\approx</span><span style="color: rgb(181, 206, 168);"> 0</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">indicating </span><span style="color: rgb(220, 220, 170);">\textit</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(230, 230, 230); font-style: italic;">flat generativity</span><span style="color: rgb(230, 230, 230);">}: high-volume continuation, low semantic acceleration.</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">The key pathology:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">itemize</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(230, 230, 230);"> High </span><span style="color: rgb(220, 220, 170);">\emph</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(230, 230, 230); font-style: italic;">token entropy</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(230, 230, 230);"> Low </span><span style="color: rgb(220, 220, 170);">\emph</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(230, 230, 230); font-style: italic;">agency entropy</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(230, 230, 230);"> Minimal effective curvature</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">itemize</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Thus:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\text{LLM output} </span><span style="color: rgb(86, 156, 214);">\equiv</span><span style="color: rgb(78, 201, 176);"> \text{semantic foam without gradient}</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(106, 153, 85);">% ------------------------------------------------------------</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\chapter</span><span style="color: rgb(230, 230, 230);">{Ethical Gradient Flow and Legal Counterforces}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Healthy systems preserve scalar variance by:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\frac{d}{dt} </span><span style="color: rgb(86, 156, 214);">\int</span><span style="color: rgb(78, 201, 176);"> S </span><span style="color: rgb(220, 220, 170);">\,</span><span style="color: rgb(78, 201, 176);"> dV &gt; </span><span style="color: rgb(181, 206, 168);">0</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Legal interventions act as boundary constraints:</span></span>
<span class="line"></span>
