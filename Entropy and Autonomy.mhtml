<span class="line"><span style="color: rgb(220, 220, 170);">\chapter</span><span style="color: rgb(230, 230, 230);">{Design Criteria for Anti-Capture AI}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">An AI system is anti-capture aligned if it satisfies:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">table</span><span style="color: rgb(230, 230, 230);">}[htbp]</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\centering</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">tabular</span><span style="color: rgb(230, 230, 230);">}{l l l}</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\toprule</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\textbf</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(86, 156, 214); font-weight: bold;">Requirement</span><span style="color: rgb(230, 230, 230);">} </span><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(220, 220, 170);"> \textbf</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(86, 156, 214); font-weight: bold;">Formal condition</span><span style="color: rgb(230, 230, 230);">} </span><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(220, 220, 170);"> \textbf</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(86, 156, 214); font-weight: bold;">Meaning</span><span style="color: rgb(230, 230, 230);">} </span><span style="color: rgb(197, 134, 192);">\\</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\midrule</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Increases possibility </span><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(230, 230, 230);"> maximize </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\int</span><span style="color: rgb(78, 201, 176);"> |</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);">| </span><span style="color: rgb(220, 220, 170);">\,</span><span style="color: rgb(78, 201, 176);"> d</span><span style="color: rgb(86, 156, 214);">\mu</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(197, 134, 192);"> &amp;</span><span style="color: rgb(197, 134, 192);"> \cite</span><span style="color: rgb(230, 230, 230);">{jaynes1957information} </span><span style="color: rgb(197, 134, 192);">\\</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Preserves agency loops </span><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(78, 201, 176);"> $</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \cdot</span><span style="color: rgb(78, 201, 176);"> \vec{v} </span><span style="color: rgb(86, 156, 214);">\approx</span><span style="color: rgb(181, 206, 168);"> 0</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);">, no creation of dependency sinks </span><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(197, 134, 192);"> \cite</span><span style="color: rgb(230, 230, 230);">{bateson1972ecology} </span><span style="color: rgb(197, 134, 192);">\\</span></span>
