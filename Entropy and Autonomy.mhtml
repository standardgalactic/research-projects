<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(230, 230, 230);"> Fit </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> using entropy density of next-token distributions</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(230, 230, 230);"> Estimate </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">G(t)</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> via spectral norm of embedding Jacobians</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(230, 230, 230);"> Fit </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">\mathbf{v}</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> from sequential semantic embeddings</span></span>
