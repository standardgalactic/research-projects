<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(220, 220, 170);"> \texttt</span><span style="color: rgb(230, 230, 230);">{semantic_variance = var(Œ¶)}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(220, 220, 170);"> \texttt</span><span style="color: rgb(230, 230, 230);">{agency_energy     = mean(|v|^2)}</span></span>
