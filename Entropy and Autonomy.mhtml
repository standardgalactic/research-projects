<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(78, 201, 176);"> S </span><span style="color: rgb(86, 156, 214);">\parallel</span><span style="color: rgb(78, 201, 176);"> \vec{v}</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">This eliminates degrees of freedom orthogonal to platform-incentive directions.</span></span>
