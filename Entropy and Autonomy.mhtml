<span class="line"><span style="color: rgb(86, 156, 214);">\kappa</span><span style="color: rgb(78, 201, 176);"> &gt; </span><span style="color: rgb(86, 156, 214);">\sum</span><span style="color: rgb(78, 201, 176);">_i r_i, \quad </span><span style="color: rgb(86, 156, 214);">\mu</span><span style="color: rgb(78, 201, 176);"> &gt; </span><span style="color: rgb(86, 156, 214);">\sum</span><span style="color: rgb(78, 201, 176);">_i p_i</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
