<span class="line"><span style="color: rgb(220, 220, 170);">\midrule</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">I. Open Field </span><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(230, 230, 230);"> High </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);">, low </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(78, 201, 176);"> S</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(197, 134, 192);"> &amp;</span><span style="color: rgb(230, 230, 230);"> Innovation </span><span style="color: rgb(197, 134, 192);">\\</span></span>
