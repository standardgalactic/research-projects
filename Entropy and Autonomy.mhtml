<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Intuitively:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">itemize</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(230, 230, 230);"> meaning diffuses (</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">D_</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(86, 156, 214);"> \nabla</span><span style="color: rgb(78, 201, 176);">^</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);">) </span><span style="color: rgb(197, 134, 192);">\cite</span><span style="color: rgb(230, 230, 230);">{prigogine1984order}</span></span>
