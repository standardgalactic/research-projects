<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Transition point when:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\frac{</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(78, 201, 176);"> S}{</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);">} &gt; </span><span style="color: rgb(181, 206, 168);">1.2</span><span style="color: rgb(86, 156, 214);"> \rightarrow</span><span style="color: rgb(181, 206, 168);"> 1.5</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(106, 153, 85);">% ------------------------------------------------------------</span></span>
