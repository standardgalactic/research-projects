<p dir="auto" class="break-words" style="white-space: pre-wrap;">with adaptive schedule:</p>
<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><msub><mi>œÉ</mi><mi mathvariant="normal">Œ¶</mi></msub><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>=</mo><msub><mi>œÉ</mi><mn>0</mn></msub><mi>exp</mi><mo>‚Å°</mo><mrow><mo fence="true">(</mo><mo>‚àí</mo><mfrac><mrow><mi mathvariant="normal">‚à•</mi><mi mathvariant="normal">‚àá</mi><mi mathvariant="normal">Œ¶</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><msubsup><mi mathvariant="normal">‚à•</mi><mn>2</mn><mn>2</mn></msubsup></mrow><msubsup><mi>œÉ</mi><mi>c</mi><mn>2</mn></msubsup></mfrac><mo fence="true">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma_\Phi(t) = \sigma_0 \exp\left(-\frac{\|\nabla \Phi(t)\|^2_2}{\sigma_c^2}\right)</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right: 0.03588em;">œÉ</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3283em;"><span style="top: -2.55em; margin-left: -0.0359em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight">Œ¶</span></span></span></span><span class="vlist-s">‚Äã</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span></span></span></span></span></span></span><span class="mopen">(</span><span class="mord mathnormal">t</span><span class="mclose">)</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 2.4411em; vertical-align: -0.95em;"></span><span class="mord"><span c