<span class="line"><span style="color: rgb(215, 186, 125);">\|</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(215, 186, 125);">\|</span><span style="color: rgb(78, 201, 176);"> &lt; \min_i </span><span style="color: rgb(215, 186, 125);">\|</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(215, 186, 125);">\|</span><span style="color: rgb(78, 201, 176);">_i</span></span>
