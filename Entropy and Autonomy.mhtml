<span class="line"><span style="color: rgb(230, 230, 230);">Huxley </span><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(230, 230, 230);"> Pacification </span><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(230, 230, 230);"> Assumes a coherent hedonistic equilibrium </span><span style="color: rgb(197, 134, 192);">\\</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Actual </span><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(230, 230, 230);"> Semantic noise and micro-capture </span><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(230, 230, 230);"> No equilibrium, no coherence, no shared reference layer </span><span style="color: rgb(197, 134, 192);">\cite</span><span style="color: rgb(230, 230, 230);">{bridle2018darkage} </span><span style="color: rgb(197, 134, 192);">\\</span></span>
