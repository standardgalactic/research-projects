<span class="line"><span style="color: rgb(230, 230, 230);">If </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \cdot</span><span style="color: rgb(78, 201, 176);"> \mathbf{v} &gt; </span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> at finite points, field coherence decays globally: </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\int</span><span style="color: rgb(78, 201, 176);">_{\mathcal{M}} </span><span style="color: rgb(215, 186, 125);">\|</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(215, 186, 125);">\|</span><span style="color: rgb(220, 220, 170);"> \,</span><span style="color: rgb(78, 201, 176);"> d</span><span style="color: rgb(86, 156, 214);">\mu</span><span style="color: rgb(78, 201, 176);"> \to </span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);">.</span></span>
