\end{itemize}</p>
<p dir="auto" class="break-words" style="white-space: pre-wrap;">Under strong behavioral capture, the compression term dominates:</p>
<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mfrac><mrow><mi mathvariant="normal">‚àÇ</mi><mi>S</mi></mrow><mrow><mi mathvariant="normal">‚àÇ</mi><mi>t</mi></mrow></mfrac><mo>‚âà</mo><mi>Œª</mi><mi mathvariant="normal">‚à£</mi><mi mathvariant="normal">‚àá</mi><mo>‚ãÖ</mo><mover accent="true"><mi>v</mi><mo>‚Éó</mo></mover><mi mathvariant="normal">‚à£</mi><mo>‚â´</mo><msub><mi>D</mi><mi>S</mi></msub><msup><mi mathvariant="normal">‚àá</mi><mn>2</mn></msup><mi>S</mi></mrow><annotation encoding="application/x-tex">\frac{\partial S}{\partial t} \approx \lambda |\nabla \cdot \vec{v}| \gg D_S \nabla^2 S</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 2.0574em; vertical-align: -0.686em;"></span><span class="mord"><span class="mopen nulldelimiter"></span><span class="mfrac"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 1.3714em;"><span style="top: -2.314em;"><span class="pstrut" style="height: 3em;"></span><span class="mord"><span class="mord" style="margin-right: 0.05556em;">‚àÇ</span><span class="mord mathnormal">t</span></span></span><span style="top: -3.23em;"><span class="pstrut" style="height: 3em;"></span><span class="frac-line" style="border-bottom-width: 0.04em;"></span></span><span style="top: -3.677em;"><span class="pstrut" style="height: 3em;"></span><span class="mord"><span class="mord" style="margin-right: 0.05556em;">‚àÇ</span><span class="mord mathnormal" style="margin-right: 0.05764em;">S</span></span></span></span><span class="vlist-s">‚Äã</span></span><span class="vlist-r"><span class="vlist" style="height: 0.686em;"><span></span></span></span></span></span><span class="mclose nulldelimiter"></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">‚âà</span><span class="mspace" style