<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">be the expected semantic gradient magnitude.</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">definition</span><span style="color: rgb(230, 230, 230);">}[Observed Collapse]</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">A cognitive population exhibits </span><span style="color: rgb(220, 220, 170);">\emph</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(230, 230, 230); font-style: italic;">semantic collapse</span><span style="color: rgb(230, 230, 230);">} at time </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">t_c</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> if:</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">G(t_c) \le </span><span style="color: rgb(86, 156, 214);">\epsilon</span><span style="color: rgb(78, 201, 176);">_G \quad \text{and} \quad </span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(78, 201, 176);">_t G (t_c) &lt; </span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);">.</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">definition</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Empirical proxies for </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">G(t)</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> include:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">itemize</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(230, 230, 230);"> Variance of next-token predictive distributions in population-scale language traces</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(230, 230, 230);"> Inverse Jensen‚ÄìShannon divergence between user and platform language models</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(230, 230, 230);"> Topic-space degeneracy rank of collective discourse embeddings</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">itemize</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">theorem</span><span style="color: rgb(230, 230, 230);">}[Proxy Convergence]</span></span>
