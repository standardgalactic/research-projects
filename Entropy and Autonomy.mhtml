\begin{align}
\partial_t \Phi + \nabla\!\cdot(\mathbf{u}\,\Phi) &amp;= D_\Phi \nabla^2 \Phi \;-\; \alpha_{\rm A}\,\nabla\cdot \mathbf{J}(\Phi) , \label{eq:rsvp_phi}\\
