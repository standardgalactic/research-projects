<span class="line"><span style="color: rgb(220, 220, 170);">\Large</span><span style="color: rgb(230, 230, 230);"> A Field Theory of Autonomy in the Predictive Age}</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\author</span><span style="color: rgb(230, 230, 230);">{Flyxion</span><span style="color: rgb(197, 134, 192);">\\</span></span>
