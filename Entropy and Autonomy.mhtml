<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(230, 230, 230);"> possibility gradients steer agency (</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);">) </span><span style="color: rgb(197, 134, 192);">\cite</span><span style="color: rgb(230, 230, 230);">{barabasi2016network}</span></span>
