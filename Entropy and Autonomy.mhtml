<p dir="auto" class="break-words" style="white-space: pre-wrap;">\chapter{Training Objectives That Preserve Semantic Gradient}</p>
<p dir="auto" class="break-words" style="white-space: pre-wrap;">\epigraph{``Loss functions that shrink uncertainty will also shrink futures.''}{R. K. Malhotra (formalized)}</p>
<p dir="auto" class="break-words" style="white-space: pre-wrap;">Define the semantic gradient preservation objective:</p>
<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><msub><mi mathvariant="script">L</mi><mtext>SGP</mtext></msub><mo>=</mo><mi mathvariant="double-struck">E</mi><mrow><mo fence="true">[</mo><mo>‚àí</mo><mi>log</mi><mo>‚Å°</mo><msub><mi>p</mi><mi>Œ∏</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>+</mo><msub><mi>Œª</mi><mi>g</mi></msub><mi mathvariant="normal">‚à•</mi><msub><mi mathvariant="normal">‚àá</mi><mi mathvariant="normal">Œ¶</mi></msub><mi>log</mi><mo>‚Å°</mo><msub><mi>p</mi><mi>Œ∏</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><msup><mi mathvariant="normal">‚à•</mi><mn>2</mn></msup><mo>‚àí</mo><msub><mi>Œª</mi><mi>c</mi></msub><mi>det</mi><mo>‚Å°</mo><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">‚àá</mi><mi mathvariant="normal">Œ¶</mi><mn>2</mn></msubsup><mi>log</mi><mo>‚Å°</mo><msub><mi>p</mi><mi>Œ∏</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo fence="true">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{SGP}} = \mathbb{E}\left[-\log p_\theta(x) + \lambda_g \|\nabla_\Phi \log p_\theta(x)\|^2 - \lambda_c \det(\nabla_\Phi^2 \log p_\theta(x))\right]</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.8333em; vertical-align: -0.15em;"></span><span class="mord"><span class="mord mathcal">L</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3283em;"><span style="top: -2.55em; margin-left: 0em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord text mtight"><span class="mord mtight">SGP</span></span></span></span></span></span><span cl