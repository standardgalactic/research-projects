<span class="line"><span style="color: rgb(230, 230, 230);">initialize Œ¶, v on 2D lattice</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">for t in timesteps:</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    noiseŒ¶ = Œ∑ * random()</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    noiseV = Œ∑ * random_vector()</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    Œ¶ += dt * (DŒ¶ * laplacian(Œ¶) - Œ≤ * Œ¶ + noiseŒ¶)</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    v += dt * (Dv * laplacian(v) - Œ≤ * v + grad(Œ¶) + noiseV)</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    # Optional anti-capture operators</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    if enable_divergence:</span></span>
