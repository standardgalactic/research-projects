<span class="line"><span style="color: rgb(220, 220, 170);">\chapter</span><span style="color: rgb(230, 230, 230);">{Derivation of the Critical Capture Threshold}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">We begin with the scalar field evolution under capture:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">equation</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\frac{</span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);">}{</span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(78, 201, 176);"> t} = D_</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(86, 156, 214);"> \nabla</span><span style="color: rgb(78, 201, 176);">^</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(86, 156, 214);"> \Phi</span><span style="color: rgb(78, 201, 176);"> - </span><span style="color: rgb(86, 156, 214);">\beta</span><span style="color: rgb(86, 156, 214);"> \Phi</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">equation</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Assume Fourier modes of the form:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">(x,t) = </span><span style="color: rgb(86, 156, 214);">\sum</span><span style="color: rgb(78, 201, 176);">_k \hat{</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">}_k e^{i k x + </span><span style="color: rgb(86, 156, 214);">\lambda</span><span style="color: rgb(78, 201, 176);">_k t}</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Then:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\lambda</span><span style="color: rgb(78, 201, 176);">_k \hat{</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">}_k = -D_</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);"> k^</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(78, 201, 176);"> \hat{</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">}_k - </span><span style="color: rgb(86, 156, 214);">\beta</span><span style="color: rgb(78, 201, 176);"> \hat{</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">}_k</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\lambda</span><span style="color: rgb(78, 201, 176);">_k = -D_</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);"> k^</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(78, 201, 176);"> - </span><span style="color: rgb(86, 156, 214);">\beta</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Stability requires </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\lambda</span><span style="color: rgb(78, 201, 176);">_k &lt; </span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> for all </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">k</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);">.</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Semantic collapse occurs when the least stable mode reaches zero:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\lambda</span><span style="color: rgb(78, 201, 176);">_{k_{\min}} = </span><span style="color: rgb(181, 206, 168);">0</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">On a domain of size </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">L</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);">, the lowest nonzero mode is:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">k_{\min} = \frac{</span><span style="color: rgb(86, 156, 214);">\pi</span><span style="color: rgb(78, 201, 176);">}{L}</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Thus the transition point </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\beta</span><span style="color: rgb(78, 201, 176);">_c</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);"> satisfies:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);"> = -D_</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);"> \left(\frac{</span><span style="color: rgb(86, 156, 214);">\pi</span><span style="color: rgb(78, 201, 176);">}{L}\right)^</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(78, 201, 176);"> - </span><span style="color: rgb(86, 156, 214);">\beta</span><span style="color: rgb(78, 201, 176);">_c</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\boxed{ </span><span style="color: rgb(86, 156, 214);">\beta</span><span style="color: rgb(78, 201, 176);">_c = \frac{D_</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(86, 156, 214);"> \pi</span><span style="color: rgb(78, 201, 176);">^</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(78, 201, 176);">}{L^</span><span style="color: rgb(181, 206, 168);">2</span><span style="color: rgb(78, 201, 176);">} }</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">This gives a concrete, measurable collapse threshold in terms of:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">table</span><span style="color: rgb(230, 230, 230);">}[htbp]</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\centering</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">tabular</span><span style="color: rgb(230, 230, 230);">}{l l}</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\toprule</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\textbf</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(86, 156, 214); font-weight: bold;">Parameter</span><span style="color: rgb(230, 230, 230);">} </span><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(220, 220, 170);"> \textbf</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(86, 156, 214); font-weight: bold;">Meaning in society</span><span style="color: rgb(230, 230, 230);">} </span><span style="color: rgb(197, 134, 192);">\\</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\midrule</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">D_</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(197, 134, 192);"> &amp;</span><span style="color: rgb(230, 230, 230);"> semantic mobility, education, cognitive cross-pollination </span><span style="color: rgb(197, 134, 192);">\cite</span><span style="color: rgb(230, 230, 230);">{prigogine1984order} </span><span style="color: rgb(197, 134, 192);">\\</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">L</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(197, 134, 192);"> &amp;</span><span style="color: rgb(230, 230, 230);"> characteristic cultural diameter (how far ideas must travel to matter) </span><span style="color: rgb(197, 134, 192);">\cite</span><span style="color: rgb(230, 230, 230);">{newman2018networks} </span><span style="color: rgb(197, 134, 192);">\\</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(86, 156, 214);">\beta</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(197, 134, 192);"> &amp;</span><span style="color: rgb(230, 230, 230);"> capture pressure (ads, polarization, rage/reward loops, algorithmic profiling) </span><span style="color: rgb(197, 134, 192);">\cite</span><span style="color: rgb(230, 230, 230);">{friston2010freeenergy} </span><span style="color: rgb(197, 134, 192);">\\</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\bottomrule</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">tabular</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">table</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Collapse happens not when ideas vanish, but when they cannot propagate far enough to recombine </span><span style="color: rgb(197, 134, 192);">\cite</span><span style="color: rgb(230, 230, 230);">{bridle2018darkage}.</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(106, 153, 85);">% ------------------------------------------------------------</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\chapter</span><span style="color: rgb(230, 230, 230);">{Pseudocode Simulation of Semantic Turbulence}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">A minimal simulation of the coupled fields with capture:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">verbatim</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">initialize Phi, v on 2D lattice</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">for t in timesteps:</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    noisePhi = eta * random()</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    noiseV = eta * random_vector()</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    Phi += dt * (DPhi * laplacian(Phi) - beta * Phi + noisePhi)</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    v += dt * (Dv * laplacian(v) - beta * v + grad(Phi) + noiseV)</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    # Optional anti-capture operators</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    if enable_divergence:</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">        Phi += alpha * divergence(grad(Phi))</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    if enable_circulation:</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">        v += gamma * curl(v)</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    if enable_reentropize:</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">        Phi += sigma * noise_boundary(Phi)</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">verbatim</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Key observables to track:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">itemize</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(220, 220, 170);"> \texttt</span><span style="color: rgb(230, 230, 230);">{semantic_variance = var(Phi)}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(220, 220, 170);"> \texttt</span><span style="color: rgb(230, 230, 230);">{agency_energy     = mean(|v|^2)}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(220, 220, 170);"> \texttt</span><span style="color: rgb(230, 230, 230);">{gradient_flux     = mean(|grad(Phi)|)}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(220, 220, 170);"> \texttt</span><span style="color: rgb(230, 230, 230);">{capture_index     = mean(beta * |Phi|)}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(220, 220, 170);"> \texttt</span><span style="color: rgb(230, 230, 230);">{manifold_health   = gradient_flux / capture_index}</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">itemize</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Interpretation:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">itemize</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(230, 230, 230);"> Healthy society: </span><span style="color: rgb(220, 220, 170);">\texttt</span><span style="color: rgb(230, 230, 230);">{gradient_flux &gt;&gt; capture_index}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(230, 230, 230);"> Captured society: </span><span style="color: rgb(220, 220, 170);">\texttt</span><span style="color: rgb(230, 230, 230);">{capture_index &gt; gradient_flux}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    \item</span><span style="color: rgb(230, 230, 230);"> Terminal collapse: </span><span style="color: rgb(220, 220, 170);">\texttt</span><span style="color: rgb(230, 230, 230);">{semantic_variance ‚Üí 0}</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">itemize</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(106, 153, 85);">% ------------------------------------------------------------</span></span>
