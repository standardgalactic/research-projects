<p dir="auto" class="break-words" style="white-space: pre-wrap;">\begin{theorem}[Attention Collapse Equivalence]
\begin{boxed}
Market optimization of attention is isomorphic to gradient descent on <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>U</mi><mo stretchy="false">(</mo><mi mathvariant="normal">Î¦</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">U(\Phi)</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mord mathnormal" style="margin-right: 0.10903em;">U</span><span class="mopen">(</span><span class="mord">Î¦</span><span class="mclose">)</span></span></span></span> with diffusion.
\end{boxed}
\end{theorem}</p>
<p dir="auto" class="break-words" style="white-space: pre-wrap;">\begin{proof}
Identical form to Fokkerâ€“Planck dynamics with drift term <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi mathvariant="normal">âˆ‡</mi><mi>U</mi><mo stretchy="false">(</mo><mi mathvariant="normal">Î¦</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\nabla U(\Phi)</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mord">âˆ‡</span><span class="mord mathnormal" style="margin-right: 0.10903em;">U</span><span class="mopen">(</span><span class="mord">Î¦</span><span class="mclose">)</span></span></span></span>, hence the stationary distribution minimizes <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>U</mi><mo stretchy="false">(</mo><mi mathvariant="normal">Î¦</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">U(\Phi)</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mord mathnormal" style="margin-right: 0.10903em;">U</span><span class="mopen">(</span><span class="mord">Î¦</span><span class="mclose">)</span></span></span></span>.
\end{proof}</p>
