<span class="line"><span style="color: rgb(230, 230, 230);">Capture index </span><span style="color: rgb(197, 134, 192);">&amp;</span><span style="color: rgb(78, 201, 176);"> $</span><span style="color: rgb(78, 201, 176);">C = </span><span style="color: rgb(86, 156, 214);">\beta</span><span style="color: rgb(86, 156, 214);"> \langle</span><span style="color: rgb(78, 201, 176);"> |</span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">| </span><span style="color: rgb(86, 156, 214);">\rangle</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(197, 134, 192);"> &amp;</span><span style="color: rgb(78, 201, 176);"> $</span><span style="color: rgb(78, 201, 176);">\to </span><span style="color: rgb(86, 156, 214);">\infty</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(197, 134, 192);"> \\</span></span>
