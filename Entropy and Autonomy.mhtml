x="0" style="background-color: rgb(34, 34, 34); color: rgb(230, 230, 230);"><code><span class="line"><span style="color: rgb(197, 134, 192);">\documentclass</span><span style="color: rgb(230, 230, 230);">[</span><span style="color: rgb(156, 220, 254);">11pt,a4paper</span><span style="color: rgb(230, 230, 230);">]{</span><span style="color: rgb(78, 201, 176);">article</span><span style="color: rgb(230, 230, 230);">}</span></span>
