<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">itemize</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(230, 230, 230);"> Stable agency (diverse choices, shallow minima)</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(230, 230, 230);"> Competing narratives (multi-minima metastability)</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\item</span><span style="color: rgb(230, 230, 230);"> Collapse to a capture well (authoritarian attractor)</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">itemize</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">When AI platforms reinforce choices proportional to predicted engagement </span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(78, 201, 176);">E</span><span style="color: rgb(78, 201, 176);">$</span><span style="color: rgb(230, 230, 230);">:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">P(\text{choice}) </span><span style="color: rgb(86, 156, 214);">\propto</span><span style="color: rgb(78, 201, 176);"> e^{</span><span style="color: rgb(86, 156, 214);">\beta</span><span style="color: rgb(78, 201, 176);"> E}</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">the landscape loses convexity, guaranteeing path-dependent lock-in.</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(106, 153, 85);">% ------------------------------------------------------------</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\chapter</span><span style="color: rgb(230, 230, 230);">{Topology of Moral Vortices}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">A moral-vortex is defined as a closed circulation in the agency field:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\oint</span><span style="color: rgb(78, 201, 176);">_{</span><span style="color: rgb(86, 156, 214);">\Gamma</span><span style="color: rgb(78, 201, 176);">} \vec{v} </span><span style="color: rgb(86, 156, 214);">\cdot</span><span style="color: rgb(78, 201, 176);"> d</span><span style="color: rgb(86, 156, 214);">\ell</span><span style="color: rgb(86, 156, 214);"> \neq</span><span style="color: rgb(181, 206, 168);"> 0</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Its stability is determined by its vorticity magnitude:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\Omega</span><span style="color: rgb(78, 201, 176);"> = </span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \times</span><span style="color: rgb(78, 201, 176);"> \vec{v}</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">Toxic affect loops form when:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\frac{</span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(86, 156, 214);"> \Omega</span><span style="color: rgb(78, 201, 176);">}{</span><span style="color: rgb(86, 156, 214);">\partial</span><span style="color: rgb(78, 201, 176);"> t} &gt; </span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(78, 201, 176);"> \quad \text{and} \quad </span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(86, 156, 214);"> \cdot</span><span style="color: rgb(78, 201, 176);"> \vec{v} &lt; </span><span style="color: rgb(181, 206, 168);">0</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">meaning agency spirals inward without semantic propagation.</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">The maximal polarization state corresponds to:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">equation</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">|</span><span style="color: rgb(86, 156, 214);">\Omega</span><span style="color: rgb(78, 201, 176);">| </span><span style="color: rgb(86, 156, 214);">\rightarrow</span><span style="color: rgb(181, 206, 168);"> 1</span><span style="color: rgb(78, 201, 176);">,\quad </span><span style="color: rgb(86, 156, 214);">\nabla</span><span style="color: rgb(78, 201, 176);"> S </span><span style="color: rgb(86, 156, 214);">\rightarrow</span><span style="color: rgb(181, 206, 168);"> 0</span><span style="color: rgb(78, 201, 176);"> \quad \text{(static, cyclic outrage state)}</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\end</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(156, 220, 254);">equation</span><span style="color: rgb(230, 230, 230);">}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(106, 153, 85);">% ------------------------------------------------------------</span></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\chapter</span><span style="color: rgb(230, 230, 230);">{Information Monopoles and Field Centralization}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">An information monopole is defined by field flux imbalance:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">_{\text{out}} = </span><span style="color: rgb(86, 156, 214);">\oint</span><span style="color: rgb(78, 201, 176);">_S \vec{v} </span><span style="color: rgb(86, 156, 214);">\cdot</span><span style="color: rgb(78, 201, 176);"> d\vec{A}</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">For a decentralized system:</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\[</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">\sum</span><span style="color: rgb(78, 201, 176);">_i </span><span style="color: rgb(86, 156, 214);">\Phi</span><span style="color: rgb(78, 201, 176);">_{\text{out},i} = </span><span style="color: rgb(181, 206, 168);">0</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">\]</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">For platform monopolization:</span></span>
