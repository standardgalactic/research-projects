<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\chapter</span><span style="color: rgb(230, 230, 230);">{Algorithmic Capture as a Control System}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\section</span><span style="color: rgb(230, 230, 230);">{State‚ÄìControl Formulation}</span></span>
<span class="line"></span>
