    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">synthesize_audio_from_text</span></span><span>(</span><span><span class="hljs-params">self, text: <span class="hljs-built_in">str</span></span></span><span>) -&gt; </span><span><span class="hljs-built_in">str</span></span><span>:
