</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">make_zip</span></span><span>(</span><span><span class="hljs-params">zip_name, include_paths</span></span><span>):
    zip_path = os.path.join(BASE, zip_name)
    </span><span><span class="hljs-keyword">with</span></span><span> zipfile.ZipFile(zip_path, </span><span><span class="hljs-string">"w"</span></span><span>, zipfile.ZIP_DEFLATED) </span><span><span class="hljs-keyword">as</span></span><span> z:
