MergeStmt    ::= </span><span><span class="hljs-string">"merge"</span></span><span> ID </span><span><span class="hljs-string">"and"</span></span><span> ID </span><span><span class="hljs-string">"as"</span></span><span> </span><span><span class="hljs-type">String</span></span><span>

DefineRuleStmt ::= RegexRule | TypeRule | TokenRule

RegexRule    ::= </span><span><span class="hljs-string">"define regexrule"</span></span><span> ID </span><span><span class="hljs-string">"on"</span></span><span> Modality </span><span><span class="hljs-string">"{"</span></span><span> Subst+ </span><span><span class="hljs-string">"}"</span></span><span>
Subst        ::= </span><span><span class="hljs-type">String</span></span><span> </span><span><span class="hljs-string">"=&gt;"</span></span><span> </span><span><span class="hljs-type">String</span></span><span> </span><span><span class="hljs-string">";"</span></span><span>

TypeRule     ::= </span><span><span class="hljs-string">"define typerule"</span></span><span> ID </span><span><span class="hljs-string">"input:"</span></span><span> Modality </span><span><span class="hljs-string">"output:"</span></span><span> Modality </span><span><span class="hljs-string">"{"</span></span><span> PY </span><span><span class="hljs-string">"}"</span></span><span>
PY           ::= </span><span><span class="hljs-string">"python:"</span></span><span> Expr

TokenRule    ::= </span><span><span class="hljs-string">"define tokenrule"</span></span><span> ID </span><span><span class="hljs-string">"on"</span></span><span> Modality </span><span><span class="hljs-string">"pattern:"</span></span><span> Regex </span><span><span class="hljs-string">"repl:"</span></span><span> </span><span><span class="hljs-type">String</span></span><span>

Modality     ::= </span><span><span class="hljs-string">"text"</span></span><span> | </span><span><span class="hljs-string">"audio"</span></span><span> | </span><span><span class="hljs-string">"video"</span></span><span> | </span><span><span class="hljs-string">"embedding"</span></span><span>
Regex        ::= </span><span><span class="hljs-string">"/"</span></span><span> ([^/])+ </span><span><span class="hljs-string">"/"</span></span><span>
ID           ::= [A-Za-z_][A-Za-z0-</span><span><span class="hljs-number">9_</span></span><span>]*
</span><span><span class="hljs-type">String</span></span><span>       ::= </span><span><span class="hljs-string">'"'</span></span><span> [^</span><span><span class="hljs-string">"]* '"</span></span><span>' | </span><span><span class="hljs-string">"'"</span></span><span> [^']* </span><span><span class="hljs-string">"'"</span></span><span>
Expr         ::= (restricted Python expression; see §</span><span><span class="hljs-number">3.3</span></span><span>)
</span></span></code></div></div></pre>
