<p data-start="3326" data-end="3477">write("cli.py", textwrap.dedent("""<br data-start="3361" data-end="3363">
#!/usr/bin/env python3<br>
import sys, argparse<br>
from spherepop.interpreter import Interpreter<br>
from pathlib import Path</p>
<p data-start="3479" data-end="3904">def demo():<br>
interp = Interpreter()<br>
# make a sphere with text modality only<br>
interp.make_sphere("A", ["text","audio"], {"text":"Entropy bounds matter."})<br>
interp.define_rule("tts", "text", "audio", epsilon=0.02, impl="python:tts_placeholder")<br>
interp.pop("A","B", ["tts"])<br>
interp.close("B")<br>
print("Spheres:", list(interp.spheres.keys()))<br>
for sid, s in interp.spheres.items():<br>
print(sid, s)</p>
<p data-start="3906" data-end="4129">def main(argv):<br>
p = argparse.ArgumentParser()<br>
p.add_argument("cmd", nargs="?", default="demo")<br>
args = p.parse_args(argv)<br>
if args.cmd == "demo":<br>
demo()<br>
else:<br>
print("unknown cmd", args.cmd)</p>
<p data-start="4131" data-end="4186">if <strong data-start="4134" data-end="4142">name</strong> == '<strong data-start="4147" data-end="4155">main</strong>':<br>
