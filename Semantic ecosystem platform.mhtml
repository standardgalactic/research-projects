"docs/architecture.md": textwrap.dedent("""\</p>
<h1 data-start="2271" data-end="2295">PlenumHub Architecture</h1>
<p data-start="2297" data-end="2368">This document sketches the repository architecture and core components.</p>
<ul data-start="2370" data-end="2747">
<li data-start="2370" data-end="2443">
<p data-start="2372" data-end="2443"><code data-start="2372" data-end="2390">plenumhub.sphere</code> — Sphere dataclass (modalities, entropy, provenance)</p>
</li>
<li data-start="2444" data-end="2507">
<p data-start="2446" data-end="2507"><code data-start="2446" data-end="2462">plenumhub.rule</code> — Typed rule primitives with entropy budgets</p>
</li>
<li data-start="2508" data-end="2591">
<p data-start="2510" data-end="2591"><code data-start="2510" data-end="2533">plenumhub.typechecker</code> — Static checks for modality presence and entropy budgets</p>
</li>
<li data-start="2592" data-end="2677">
<p data-start="2594" data-end="2677"><code data-start="2594" data-end="2611">plenumhub.merge</code> — Merge engine with entropy-bound enforcement and mediation hooks</p>
</li>
<li data-start="2678" data-end="2747">
<p data-start="2680" data-end="2747"><code data-start="2680" data-end="2697">plenumhub.trace</code> — Trace operator implementing safe feedback loops</p>
</li>
</ul>
<h2 data-start="2749" data-end="2764">TikZ diagram</h2>
<p data-start="2765" data-end="3132">A TikZ architecture diagram can be inserted in the LaTeX paper; see <code data-start="2833" data-end="2867">paper/figures/plenumhub_arch.tex</code> (not included).<br>
"""),<br>
"examples/basic_demo.py": textwrap.dedent("""<br data-start="2935" data-end="2937">
from plenumhub.sphere import Sphere<br>
from plenumhub.rule import Rule<br>
from plenumhub.typechecker import TypeChecker<br>
from plenumhub.merge import MergeEngine<br>
from plenumhub.trace import TraceOperator</p>
<p data-start="3134" data-end="4060">def main():<br>
s1 = Sphere(id='A', modalities={'text': 'Hello world'}, entropy=0.01, provenance=[])<br>
s2 = Sphere(id='B', modalities={'text': 'General comment'}, entropy=0.02, provenance=[])<br>
r = Rule(id='append', input_modality='text', output_modality='text', budget=0.005,<br>
impl=lambda v: v + " (appended)")<br>
tc = TypeChecker()<br>
me = MergeEngine()<br>
# apply rule<br>
s1p = r.apply(s1)<br>
print('After rule:', s1p)<br>
# merge<br>
merged = me.merge(s1p, s2)<br>
print('Merged:', merged)<br>
# trace example (simple)<br>
def f(s):<br>
# small transform that decreases entropy<br>
s2 = s.copy()<br>
s2.modalities['text'] = s2.modalities['text'].upper()<br>
s2.entropy = max(0.0, s2.entropy - 0.005)<br>
return s2<br>
tr = TraceOperator(max_iters=10)<br>
fixed = tr.trace(f, Sphere(id='X', modalities={'text': 'loop'}, entropy=0.05, provenance=[]))<br>
print('Fixed point:', fixed)</p>
<p data-start="4062" data-end="4396">if <strong data-start="4065" data-end="4073">name</strong> == '<strong data-start="4078" data-end="4086">main</strong>':<br>
main()<br>
"""),<br>
