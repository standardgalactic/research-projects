        merged_text = ta + </span><span><span class="hljs-string">"\n\n---MERGE---\n\n"</span></span><span> + tb
    merged_modalities = {</span><span><span class="hljs-string">"text"</span></span><span>: merged_text}
    merged_meta = {
        </span><span><span class="hljs-string">"merged_from"</span></span><span>: </span><span><span class="hljs-string">f"<span class="hljs-subst">{a.<span class="hljs-built_in">id</span></span></span></span><span>},</span><span><span class="hljs-subst">{b.<span class="hljs-built_in">id</span></span></span><span>}",
        </span><span><span class="hljs-string">"merge_policy"</span></span><span>: policy,
        </span><span><span class="hljs-string">"entropy_scores"</span></span><span>: </span><span><span class="hljs-string">f"<span class="hljs-subst">{sa:<span class="hljs-number">.2</span></span></span></span><span>f},</span><span><span class="hljs-subst">{sb:<span class="hljs-number">.2</span></span></span><span>f}"
    }
    merged = Sphere(</span><span><span class="hljs-built_in">id</span></span><span>=new_id(), title=</span><span><span class="hljs-string">f"Merged: <span class="hljs-subst">{a.title}</span></span></span><span>|</span><span><span class="hljs-subst">{b.title}</span></span><span>", data=merged_text,
                    modalities=merged_modalities, metadata=merged_meta,
                    entropy_score=(sa+sb)/</span><span><span class="hljs-number">2</span></span><span>)
