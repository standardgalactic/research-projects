</span><span><span class="hljs-keyword">import</span></span><span> os

</span><span><span class="hljs-comment"># --- Utilities ---</span></span><span>
</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">new_id</span></span><span>(</span><span><span class="hljs-params">prefix=<span class="hljs-string">"sph"</span></span></span><span>):
