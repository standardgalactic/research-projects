348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-python"><span><span><span class="hljs-comment"># SpherePop Calculus Interpreter Prototype</span></span><span>
</span><span><span class="hljs-comment"># Prototype implementation for the user (visible execution).</span></span><span>
</span><span><span class="hljs-comment"># Features:</span></span><span>
</span><span><span class="hljs-comment"># - Sphere objects as semantic modules with metadata and modalities</span></span><span>
</span><span><span class="hljs-comment"># - Pop operations that apply transformation rules</span></span><span>
</span><span><span class="hljs-comment"># - Merge operations with conflict-resolution policies (simple entropy-inspired)</span></span><span>
</span><span><span class="hljs-comment"># - MediaQuine stub to detect missing modalities and synthesize placeholders</span></span><span>
</span><span><span class="hljs-comment"># - Spelling &amp; Pronunciation Reporter to flag tokens with simple heuristics</span></span><span>
</span><span><span class="hljs-comment"># - Small REPL demo and unit-test-like examples showing usage</span></span><span>
</span><span><span class="hljs-comment">#</span></span><span>
</span><span><span class="hljs-comment"># Notes:</span></span><span>
</span><span><span class="hljs-comment"># - This is a lightweight prototype to iterate from. Replace TTS/STT with real services later.</span></span><span>
</span><span><span class="hljs-comment"># - No external network calls. All media generation is mocked (placeholder strings).</span></span><span>
</span><span><span class="hljs-comment"># - Save any files created into /mnt/data so you can download them if needed.</span></span><span>

</span><span><span class="hljs-keyword">from</span></span><span> dataclasses </span><span><span class="hljs-keyword">import</span></span><span> dataclass, field, asdict
</span><span><span class="hljs-keyword">from</span></span><span> typing </span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-type">Dict</span></span><span>, </span><span><span class="hljs-type">List</span></span><span>, </span><span><span class="hljs-type">Callable</span></span><span>, </span><span><span class="hljs-type">Optional</span></span><span>, </span><span><span class="hljs-type">Tuple</span></span><span>
</span><span><span class="hljs-keyword">import</span></span><span> json
</span><span><span class="hljs-keyword">import</span></span><span> re
</span><span><span class="hljs-keyword">import</span></span><span> uuid
</span><span><span class="hljs-keyword">import</span></span><span> os

</span><span><span class="hljs-comment"># --- Utilities --------------------------------------------------------------</span></span><span>

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">new_id</span></span><span>(</span><span><span class="hljs-params">prefix=<span class="hljs-string">"sph"</span></span></span><span>):
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-string">f"<span class="hljs-subst">{prefix}</span></span></span><span>_</span><span><span class="hljs-subst">{uuid.uuid4().<span class="hljs-built_in">hex</span></span></span><span>[:</span><span><span class="hljs-number">8</span></span><span>]}"

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">simple_tokenize</span></span><span>(</span><span><span class="hljs-params">text: <span class="hljs-built_in">str</span></span></span><span>):
    </span><span><span class="hljs-comment"># Very small tokenizer for demonstration</span></span><span>
    </span><span><span class="hljs-keyword">return</span></span><span> re.findall(</span><span><span class="hljs-string">r"[A-Za-z0-9_'-]+|[^\sA-Za-z0-9_'-]+"</span></span><span>, text)

</span><span><span class="hljs-comment"># --- Sphere ---------------------------------------------------------------</span></span><span>

</span><span><span class="hljs-meta">@dataclass</span></span><span>
</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">Sphere</span></span><span>:
    </span><span><span class="hljs-built_in">id</span></span><span>: </span><span><span class="hljs-built_in">str</span></span><span>
    title: </span><span><span class="hljs-built_in">str</span></span><span>
    data: </span><span><span class="hljs-built_in">str</span></span><span>
    modalities: </span><span><span class="hljs-type">Dict</span></span><span>[</span><span><span class="hljs-built_in">str</span></span><span>, </span><span><span class="hljs-built_in">str</span></span><span>] = field(default_factory=</span><span><span class="hljs-built_in">dict</span></span><span>)  </span><span><span class="hljs-comment"># e.g., {'text': '...', 'audio': '...'}</span></span><span>
    metadata: </span><span><span class="hljs-type">Dict</span></span><span>[</span><span><span class="hljs-built_in">str</span></span><span>, </span><span><span class="hljs-built_in">str</span></span><span>] = field(default_factory=</span><span><span class="hljs-built_in">dict</span></span><span>)    </span><span><span class="hljs-comment"># author, timestamp, tags</span></span><span>
    entropy_score: </span><span><span class="hljs-built_in">float</span></span><span> = </span><span><span class="hljs-number">0.0</span></span><span>  </span><span><span class="hljs-comment"># small heuristic score for content "disorder"</span></span><span>

    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">clone</span></span><span>(</span><span><span class="hljs-params">self, **overrides</span></span><span>):
        d = asdict(self)
        d.update(overrides)
        </span><span><span class="hljs-keyword">return</span></span><span> Sphere(**d)

    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">summarize</span></span><span>(</span><span><span class="hljs-params">self, max_len=<span class="hljs-number">140</span></span></span><span>):
        txt = self.modalities.get(</span><span><span class="hljs-string">"text"</span></span><span>, self.data)
        </span><span><span class="hljs-keyword">return</span></span><span> txt[:max_len] + (</span><span><span class="hljs-string">"…"</span></span><span> </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-built_in">len</span></span><span>(txt) &gt; max_len </span><span><span class="hljs-keyword">else</span></span><span> </span><span><span class="hljs-string">""</span></span><span>)

</span><span><span class="hljs-comment"># --- Rule system ---------------------------------------------------------</span></span><span>

</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">Rule</span></span><span>:
    <span class="hljs-string">"""
    A transformation rule that can be applied when popping a sphere.
    It receives a Sphere and returns a transformed Sphere (or same).
    """</span>
    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">__init__</span></span><span>(</span><span><span class="hljs-params">self, name: <span class="hljs-built_in">str</span></span></span><span>, func: </span><span><span class="hljs-type">Callable</span></span><span>[[Sphere], Sphere], description: </span><span><span class="hljs-built_in">str</span></span><span>=</span><span><span class="hljs-string">""</span></span><span>):
        self.name = name
        self.func = func
        self.description = description

    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">apply</span></span><span>(</span><span><span class="hljs-params">self, s: Sphere</span></span><span>) -&gt; Sphere:
        </span><span><span class="hljs-keyword">return</span></span><span> self.func(s)

</span><span><span class="hljs-comment"># --- Spelling &amp; Pronunciation Reporter -----------------------------------</span></span><span>

</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">SpellingPronunciationReporter</span></span><span>:
    <span class="hljs-string">"""
    Very small heuristic reporter.
    Flags:
     - spelling: token outside a basic wordlist (we'll use simple heuristics)
     - pronunciation: tokens with suspicious punctuation or capitalization pattern for audio
    """</span>
    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">__init__</span></span><span>(</span><span><span class="hljs-params">self</span></span><span>):
        </span><span><span class="hljs-comment"># minimal "wordlist" for demo; extend with a proper dictionary later</span></span><span>
        self.common_words = {</span><span><span class="hljs-string">"the"</span></span><span>,</span><span><span class="hljs-string">"and"</span></span><span>,</span><span><span class="hljs-string">"is"</span></span><span>,</span><span><span class="hljs-string">"in"</span></span><span>,</span><span><span class="hljs-string">"it"</span></span><span>,</span><span><span class="hljs-string">"to"</span></span><span>,</span><span><span class="hljs-string">"of"</span></span><span>,</span><span><span class="hljs-string">"a"</span></span><span>,</span><span><span class="hljs-string">"an"</span></span><span>,</span><span><span class="hljs-string">"for"</span></span><span>,</span><span><span class="hljs-string">"with"</span></span><span>,</span><span><span class="hljs-string">"on"</span></span><span>,</span><span><span class="hljs-string">"by"</span></span><span>,</span><span><span class="hljs-string">"as"</span></span><span>,</span><span><span class="hljs-string">"this"</span></span><span>,</span><span><span class="hljs-string">"that"</span></span><span>,</span><span><span class="hljs-string">"not"</span></span><span>}
        </span><span><span class="hljs-comment"># common technical tokens allowed</span></span><span>
        self.tech_tokens = {</span><span><span class="hljs-string">"RSVP"</span></span><span>,</span><span><span class="hljs-string">"SpherePop"</span></span><span>,</span><span><span class="hljs-string">"lamphrodyne"</span></span><span>,</span><span><span class="hljs-string">"TARTAN"</span></span><span>,</span><span><span class="hljs-string">"CLIO"</span></span><span>,</span><span><span class="hljs-string">"Φ"</span></span><span>,</span><span><span class="hljs-string">"phi"</span></span><span>}

    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">analyze_text</span></span><span>(</span><span><span class="hljs-params">self, text: <span class="hljs-built_in">str</span></span></span><span>) -&gt; </span><span><span class="hljs-type">List</span></span><span>[</span><span><span class="hljs-type">Dict</span></span><span>]:
        tokens = simple_tokenize(text)
        reports = []
        </span><span><span class="hljs-keyword">for</span></span><span> t </span><span><span class="hljs-keyword">in</span></span><span> tokens:
            </span><span><span class="hljs-keyword">if</span></span><span> re.fullmatch(</span><span><span class="hljs-string">r"[A-Za-z0-9_'-]+"</span></span><span>, t):
                </span><span><span class="hljs-keyword">if</span></span><span> t.lower() </span><span><span class="hljs-keyword">not</span></span><span> </span><span><span class="hljs-keyword">in</span></span><span> self.common_words </span><span><span class="hljs-keyword">and</span></span><span> t </span><span><span class="hljs-keyword">not</span></span><span> </span><span><span class="hljs-keyword">in</span></span><span> self.tech_tokens </span><span><span class="hljs-keyword">and</span></span><span> </span><span><span class="hljs-built_in">len</span></span><span>(t) &gt; </span><span><span class="hljs-number">12</span></span><span>:
                    reports.append({</span><span><span class="hljs-string">"type"</span></span><span>: </span><span><span class="hljs-string">"spelling"</span></span><span>, </span><span><span class="hljs-string">"token"</span></span><span>: t, </span><span><span class="hljs-string">"reason"</span></span><span>: </span><span><span class="hljs-string">"long/uncommon token"</span></span><span>})
                </span><span><span class="hljs-comment"># detect suspicious capitalization (like CamelCase in prose)</span></span><span>
                </span><span><span class="hljs-keyword">if</span></span><span> re.search(</span><span><span class="hljs-string">r"[A-Z][a-z]+[A-Z][a-z]+"</span></span><span>, t):
                    reports.append({</span><span><span class="hljs-string">"type"</span></span><span>: </span><span><span class="hljs-string">"pronunciation"</span></span><span>, </span><span><span class="hljs-string">"token"</span></span><span>: t, </span><span><span class="hljs-string">"reason"</span></span><span>: </span><span><span class="hljs-string">"CamelCase - may be mispronounced"</span></span><span>})
            </span><span><span class="hljs-keyword">else</span></span><span>:
                </span><span><span class="hljs-comment"># punctuation-heavy tokens</span></span><span>
                </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-built_in">len</span></span><span>(t.strip()) &gt; </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-keyword">and</span></span><span> re.search(</span><span><span class="hljs-string">r"[^\w\s]"</span></span><span>, t):
                    reports.append({</span><span><span class="hljs-string">"type"</span></span><span>: </span><span><span class="hljs-string">"pronunciation"</span></span><span>, </span><span><span class="hljs-string">"token"</span></span><span>: t, </span><span><span class="hljs-string">"reason"</span></span><span>: </span><span><span class="hljs-string">"punctuation may confuse TTS"</span></span><span>})
        </span><span><span class="hljs-keyword">return</span></span><span> reports

</span><span><span class="hljs-comment"># --- MediaQuine (Modalities fixer) ---------------------------------------</span></span><span>

</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">MediaQuine</span></span><span>:
    <span class="hljs-string">"""
    Detects missing modalities and synthesizes placeholders.
    For production: plug TTS/STT, summarizers, video generators.
    """</span>
    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">__init__</span></span><span>(</span><span><span class="hljs-params">self</span></span><span>):
