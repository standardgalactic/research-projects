</span><span><span class="hljs-comment"># Visible prototype: adds a DSL parser and new Rule types (RegexRule, TypedRule).</span></span><span>
</span><span><span class="hljs-comment"># Demo at the end shows usage.</span></span><span>
</span><span><span class="hljs-keyword">from</span></span><span> dataclasses </span><span><span class="hljs-keyword">import</span></span><span> dataclass, field, asdict
</span><span><span class="hljs-keyword">from</span></span><span> typing </span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-type">Dict</span></span><span>, </span><span><span class="hljs-type">List</span></span><span>, </span><span><span class="hljs-type">Callable</span></span><span>, </span><span><span class="hljs-type">Optional</span></span><span>, </span><span><span class="hljs-type">Tuple</span></span><span>, Pattern
</span><span><span class="hljs-keyword">import</span></span><span> re
