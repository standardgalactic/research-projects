        </span><span><span class="hljs-keyword">return</span></span><span> self.impl(content)

</span><span><span class="hljs-comment"># --------------------------- Entropy estimator ---------------------------</span></span><span>

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">estimate_entropy</span></span><span>(</span><span><span class="hljs-params">s: Sphere</span></span><span>) -&gt; </span><span><span class="hljs-built_in">float</span></span><span>:
    <span class="hljs-string">"""
    Simple heuristic entropy estimator:
    - base on number of missing modalities and payload lengths (log scale)
    - real implementation should use structural inconsistency metrics, MI, etc.
    """</span>
    missing = </span><span><span class="hljs-built_in">sum</span></span><span>(</span><span><span class="hljs-number">1</span></span><span> </span><span><span class="hljs-keyword">for</span></span><span> k </span><span><span class="hljs-keyword">in</span></span><span> s.types </span><span><span class="hljs-keyword">if</span></span><span> k </span><span><span class="hljs-keyword">not</span></span><span> </span><span><span class="hljs-keyword">in</span></span><span> s.mmap </span><span><span class="hljs-keyword">or</span></span><span> s.mmap[k] </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>)
    size_score = </span><span><span class="hljs-built_in">sum</span></span><span>(</span><span><span class="hljs-built_in">len</span></span><span>(c.payload) </span><span><span class="hljs-keyword">for</span></span><span> c </span><span><span class="hljs-keyword">in</span></span><span> s.mmap.values()) </span><span><span class="hljs-keyword">if</span></span><span> s.mmap </span><span><span class="hljs-keyword">else</span></span><span> </span><span><span class="hljs-number">0</span></span><span>
    </span><span><span class="hljs-comment"># entropy = missing penalty + normalized log-size</span></span><span>
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-built_in">float</span></span><span>(missing * </span><span><span class="hljs-number">1.0</span></span><span> + math.log1p(size_score) * </span><span><span class="hljs-number">0.25</span></span><span>)

</span><span><span class="hljs-comment"># --------------------------- Store ---------------------------</span></span><span>

</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">Store</span></span><span>:
    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">__init__</span></span><span>(</span><span><span class="hljs-params">self</span></span><span>):
        self._by_id: </span><span><span class="hljs-type">Dict</span></span><span>[</span><span><span class="hljs-built_in">str</span></span><span>, Sphere] = {}

    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">put</span></span><span>(</span><span><span class="hljs-params">self, s: Sphere</span></span><span>):
        self._by_id[s.</span><span><span class="hljs-built_in">id</span></span><span>] = s

    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">get</span></span><span>(</span><span><span class="hljs-params">self, sid: <span class="hljs-built_in">str</span></span></span><span>) -&gt; </span><span><span class="hljs-type">Optional</span></span><span>[Sphere]:
        </span><span><span class="hljs-keyword">return</span></span><span> self._by_id.get(sid)

    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">all</span></span><span>(</span><span><span class="hljs-params">self</span></span><span>) -&gt; </span><span><span class="hljs-type">List</span></span><span>[Sphere]:
        </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-built_in">list</span></span><span>(self._by_id.values())

    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">__repr__</span></span><span>(</span><span><span class="hljs-params">self</span></span><span>):
        </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-string">f"&lt;Store <span class="hljs-subst">{<span class="hljs-built_in">len</span></span></span></span><span>(self._by_id)} spheres&gt;"

</span><span><span class="hljs-comment"># --------------------------- Pop (rule chain) ---------------------------</span></span><span>

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">pop</span></span><span>(</span><span><span class="hljs-params">store: Store, sid: <span class="hljs-built_in">str</span></span></span><span>, rules: </span><span><span class="hljs-type">Sequence</span></span><span>[Rule]) -&gt; </span><span><span class="hljs-type">Tuple</span></span><span>[</span><span><span class="hljs-type">Optional</span></span><span>[Sphere], </span><span><span class="hljs-type">List</span></span><span>[</span><span><span class="hljs-built_in">str</span></span><span>]]:
    <span class="hljs-string">"""
    Apply a sequence of rules to sphere sid in `store`. Returns (result_sphere or None, log)
    Rules applied left-to-right. Each rule must:
      - find the required 'from' modality
      - produce 'to' modality value
      - ensure entropy(new) &lt;= entropy(old) + budget
    """</span>
    s = store.get(sid)
    log = []
    </span><span><span class="hljs-keyword">if</span></span><span> s </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>:
        log.append(</span><span><span class="hljs-string">f"pop: sphere <span class="hljs-subst">{sid}</span></span></span><span> not found")
        </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>, log
    cur = s.copy()
    </span><span><span class="hljs-keyword">for</span></span><span> r </span><span><span class="hljs-keyword">in</span></span><span> rules:
        log.append(</span><span><span class="hljs-string">f"applying rule <span class="hljs-subst">{r.<span class="hljs-built_in">id</span></span></span></span><span>}: </span><span><span class="hljs-subst">{r.from_mod}</span></span><span> -&gt; </span><span><span class="hljs-subst">{r.to_mod}</span></span><span> (budget </span><span><span class="hljs-subst">{r.budget}</span></span><span>)")
        </span><span><span class="hljs-keyword">if</span></span><span> r.from_mod </span><span><span class="hljs-keyword">not</span></span><span> </span><span><span class="hljs-keyword">in</span></span><span> cur.mmap:
            log.append(</span><span><span class="hljs-string">f" rule <span class="hljs-subst">{r.<span class="hljs-built_in">id</span></span></span></span><span>} failed: missing modality </span><span><span class="hljs-subst">{r.from_mod}</span></span><span>")
            </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>, log
        inp = cur.mmap[r.from_mod]
        out = r.apply(inp)
        new = cur.copy()
        new.mmap[r.to_mod] = out
        new.prov = new.prov + [</span><span><span class="hljs-string">f"rule:<span class="hljs-subst">{r.<span class="hljs-built_in">id</span></span></span></span><span>}"]
        new.entropy = estimate_entropy(new)  </span><span><span class="hljs-comment"># recompute heuristic entropy</span></span><span>
        </span><span><span class="hljs-keyword">if</span></span><span> new.entropy &gt; cur.entropy + r.budget + </span><span><span class="hljs-number">1e-12</span></span><span>:
            log.append(</span><span><span class="hljs-string">f" rule <span class="hljs-subst">{r.<span class="hljs-built_in">id</span></span></span></span><span>} would exceed entropy budget: </span><span><span class="hljs-subst">{new.entropy:<span class="hljs-number">.4</span></span></span><span>f} &gt; </span><span><span class="hljs-subst">{cur.entropy:<span class="hljs-number">.4</span></span></span><span>f} + </span><span><span class="hljs-subst">{r.budget:<span class="hljs-number">.4</span></span></span><span>f}")
            </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>, log
        cur = new
        log.append(</span><span><span class="hljs-string">f" rule <span class="hljs-subst">{r.<span class="hljs-built_in">id</span></span></span></span><span>} applied; entropy -&gt; </span><span><span class="hljs-subst">{cur.entropy:<span class="hljs-number">.4</span></span></span><span>f}")
    </span><span><span class="hljs-comment"># save resulting sphere</span></span><span>
    store.put(cur)
    </span><span><span class="hljs-keyword">return</span></span><span> cur, log

</span><span><span class="hljs-comment"># --------------------------- Merge ---------------------------</span></span><span>

MERGE_EPS = </span><span><span class="hljs-number">0.25</span></span><span>  </span><span><span class="hljs-comment"># epsilon allowed beyond max entropies</span></span><span>

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">merge</span></span><span>(</span><span><span class="hljs-params">store: Store, aid: <span class="hljs-built_in">str</span></span></span><span>, bid: </span><span><span class="hljs-built_in">str</span></span><span>, result_id: </span><span><span class="hljs-type">Optional</span></span><span>[</span><span><span class="hljs-built_in">str</span></span><span>] = </span><span><span class="hljs-literal">None</span></span><span>, eps: </span><span><span class="hljs-built_in">float</span></span><span> = MERGE_EPS) -&gt; </span><span><span class="hljs-type">Tuple</span></span><span>[</span><span><span class="hljs-type">Optional</span></span><span>[Sphere], </span><span><span class="hljs-built_in">str</span></span><span>]:
    a = store.get(aid)
    b = store.get(bid)
    </span><span><span class="hljs-keyword">if</span></span><span> a </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-literal">None</span></span><span> </span><span><span class="hljs-keyword">or</span></span><span> b </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>:
        </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>, </span><span><span class="hljs-string">"one or both spheres not found"</span></span><span>
    </span><span><span class="hljs-comment"># naive merge: union of modalities, prefer non-empty values from a, then b</span></span><span>
    mid = result_id </span><span><span class="hljs-keyword">or</span></span><span> gen_id(</span><span><span class="hljs-string">"m"</span></span><span>)
    mmap = </span><span><span class="hljs-built_in">dict</span></span><span>(b.mmap)
    mmap.update(a.mmap)  </span><span><span class="hljs-comment"># prefer a's content where collisions occur</span></span><span>
    types = </span><span><span class="hljs-built_in">list</span></span><span>(</span><span><span class="hljs-built_in">sorted</span></span><span>(</span><span><span class="hljs-built_in">set</span></span><span>(a.types + b.types)))
    prov = a.prov + b.prov + [</span><span><span class="hljs-string">f"merge:<span class="hljs-subst">{aid}</span></span></span><span>+</span><span><span class="hljs-subst">{bid}</span></span><span>"]
    merged = Sphere(</span><span><span class="hljs-built_in">id</span></span><span>=mid, types=types, mmap=mmap, entropy=</span><span><span class="hljs-number">0.0</span></span><span>, prov=prov)
    merged.entropy = estimate_entropy(merged)
    allowed = </span><span><span class="hljs-built_in">max</span></span><span>(a.entropy, b.entropy) + eps
    </span><span><span class="hljs-keyword">if</span></span><span> merged.entropy &lt;= allowed + </span><span><span class="hljs-number">1e-12</span></span><span>:
        store.put(merged)
        </span><span><span class="hljs-keyword">return</span></span><span> merged, </span><span><span class="hljs-string">f"merged ok; entropy <span class="hljs-subst">{merged.entropy:<span class="hljs-number">.4</span></span></span></span><span>f} &lt;= allowed </span><span><span class="hljs-subst">{allowed:<span class="hljs-number">.4</span></span></span><span>f}"
    </span><span><span class="hljs-keyword">else</span></span><span>:
        </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>, </span><span><span class="hljs-string">f"merge rejected: entropy <span class="hljs-subst">{merged.entropy:<span class="hljs-number">.4</span></span></span></span><span>f} &gt; allowed </span><span><span class="hljs-subst">{allowed:<span class="hljs-number">.4</span></span></span><span>f}"

</span><span><span class="hljs-comment"># --------------------------- Closure (Media-Quine) ---------------------------</span></span><span>

</span><span><span class="hljs-comment"># Register of permitted transducers: modality -&gt; function that consumes sphere and produces content</span></span><span>
Transducer = </span><span><span class="hljs-type">Callable</span></span><span>[[Sphere, Modality], </span><span><span class="hljs-type">Optional</span></span><span>[Content]]
TRANSDUCERS: </span><span><span class="hljs-type">Dict</span></span><span>[</span><span><span class="hljs-type">Tuple</span></span><span>[Modality, Modality], </span><span><span class="hljs-type">Callable</span></span><span>[[Content], Content]] = {}

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">register_transducer</span></span><span>(</span><span><span class="hljs-params">from_mod: Modality, to_mod: Modality, fn: <span class="hljs-type">Callable</span></span></span><span>[[Content], Content]):
    TRANSDUCERS[(from_mod, to_mod)] = fn

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">synthesize_modality</span></span><span>(</span><span><span class="hljs-params">s: Sphere, target_mod: Modality</span></span><span>) -&gt; </span><span><span class="hljs-type">Optional</span></span><span>[Content]:
    </span><span><span class="hljs-comment"># try direct transduction from any present modality</span></span><span>
    </span><span><span class="hljs-keyword">for</span></span><span> (frm, to), fn </span><span><span class="hljs-keyword">in</span></span><span> TRANSDUCERS.items():
        </span><span><span class="hljs-keyword">if</span></span><span> to == target_mod </span><span><span class="hljs-keyword">and</span></span><span> frm </span><span><span class="hljs-keyword">in</span></span><span> s.mmap:
            </span><span><span class="hljs-keyword">try</span></span><span>:
                </span><span><span class="hljs-keyword">return</span></span><span> fn(s.mmap[frm])
            </span><span><span class="hljs-keyword">except</span></span><span> Exception:
                </span><span><span class="hljs-keyword">continue</span></span><span>
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">closure</span></span><span>(</span><span><span class="hljs-params">store: Store, sid: <span class="hljs-built_in">str</span></span></span><span>, allowed_transducers: </span><span><span class="hljs-type">Optional</span></span><span>[</span><span><span class="hljs-type">Dict</span></span><span>]=</span><span><span class="hljs-literal">None</span></span><span>) -&gt; </span><span><span class="hljs-type">Tuple</span></span><span>[</span><span><span class="hljs-type">Optional</span></span><span>[Sphere], </span><span><span class="hljs-type">List</span></span><span>[</span><span><span class="hljs-built_in">str</span></span><span>]]:
    s = store.get(sid)
    log = []
    </span><span><span class="hljs-keyword">if</span></span><span> s </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>:
        log.append(</span><span><span class="hljs-string">"closure: sphere not found"</span></span><span>)
        </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>, log
    cur = s.copy()
    missing = [k </span><span><span class="hljs-keyword">for</span></span><span> k </span><span><span class="hljs-keyword">in</span></span><span> cur.types </span><span><span class="hljs-keyword">if</span></span><span> k </span><span><span class="hljs-keyword">not</span></span><span> </span><span><span class="hljs-keyword">in</span></span><span> cur.mmap </span><span><span class="hljs-keyword">or</span></span><span> cur.mmap[k] </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>]
    </span><span><span class="hljs-keyword">for</span></span><span> k </span><span><span class="hljs-keyword">in</span></span><span> missing:
        c = synthesize_modality(cur, k)
        </span><span><span class="hljs-keyword">if</span></span><span> c </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>:
            log.append(</span><span><span class="hljs-string">f" closure cannot synthesize modality <span class="hljs-subst">{k}</span></span></span><span>")
            </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>, log
        cur.mmap[k] = c
        cur.prov = cur.prov + [</span><span><span class="hljs-string">f"transduce:<span class="hljs-subst">{k}</span></span></span><span>"]
        cur.entropy = estimate_entropy(cur)
        log.append(</span><span><span class="hljs-string">f" synthesized modality <span class="hljs-subst">{k}</span></span></span><span>; entropy -&gt; </span><span><span class="hljs-subst">{cur.entropy:<span class="hljs-number">.4</span></span></span><span>f}")
    store.put(cur)
    log.append(</span><span><span class="hljs-string">"closure succeeded"</span></span><span>)
    </span><span><span class="hljs-keyword">return</span></span><span> cur, log

</span><span><span class="hljs-comment"># --------------------------- Mediation heuristics ---------------------------</span></span><span>

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">greedy_mediation</span></span><span>(</span><span><span class="hljs-params">store: Store, aid: <span class="hljs-built_in">str</span></span></span><span>, bid: </span><span><span class="hljs-built_in">str</span></span><span>, max_steps: </span><span><span class="hljs-built_in">int</span></span><span> = </span><span><span class="hljs-number">6</span></span><span>) -&gt; </span><span><span class="hljs-type">Tuple</span></span><span>[</span><span><span class="hljs-type">Optional</span></span><span>[Sphere], </span><span><span class="hljs-type">List</span></span><span>[</span><span><span class="hljs-built_in">str</span></span><span>]]:
    <span class="hljs-string">"""
    Greedy mediation: attempt rule applications on either side that minimize merged entropy.
    For this reference impl, available rules are synthesized from TRANSDUCERS (simple moves)
    """</span>
    a = store.get(aid)
    b = store.get(bid)
    </span><span><span class="hljs-keyword">if</span></span><span> a </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-literal">None</span></span><span> </span><span><span class="hljs-keyword">or</span></span><span> b </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>:
        </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>, [</span><span><span class="hljs-string">"missing sphere(s)"</span></span><span>]
    log = []
    </span><span><span class="hljs-comment"># quick check: can merge now?</span></span><span>
    merged, msg = merge(store, aid, bid)
    </span><span><span class="hljs-keyword">if</span></span><span> merged </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-keyword">not</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>:
        log.append(</span><span><span class="hljs-string">"merge succeeded without mediation: "</span></span><span> + msg)
        </span><span><span class="hljs-keyword">return</span></span><span> merged, log
    log.append(</span><span><span class="hljs-string">"initial merge failed; entering greedy mediation"</span></span><span>)
