    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">missing_modalities</span></span><span>(</span><span><span class="hljs-params">self, s: Sphere, modalities_expected=(<span class="hljs-params"><span class="hljs-string">"text"</span></span></span></span><span>,</span><span><span class="hljs-string">"audio"</span></span><span>,</span><span><span class="hljs-string">"transcript"</span></span><span>)) -&gt; </span><span><span class="hljs-type">List</span></span><span>[</span><span><span class="hljs-built_in">str</span></span><span>]:
