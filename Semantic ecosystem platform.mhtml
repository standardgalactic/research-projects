<p data-start="10435" data-end="10675">function publish_rule(node, rule, epsilon_r):<br>
stake = gamma * epsilon_r<br>
require(ledger.lock_balance(node, "TC", stake))<br>
repo.add_rule(rule, author=node, stake=stake)<br>
ledger.record_lock(node, stake, "rule_stake", rule.id)</p>
