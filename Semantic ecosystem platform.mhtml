</span><span><span class="hljs-comment"># - create a zip archive at /mnt/data/plenumhub_stage3.zip</span></span><span>
</span><span><span class="hljs-comment"># - display the created files (list) for user to review</span></span><span>
</span><span><span class="hljs-keyword">import</span></span><span> os, json, textwrap, shutil, zipfile, pathlib

root = </span><span><span class="hljs-string">"/mnt/data/plenumhub_stage3"</span></span><span>
</span><span><span class="hljs-keyword">if</span></span><span> os.path.exists(root):
    shutil.rmtree(root)
os.makedirs(root)

</span><span><span class="hljs-comment"># Files to create</span></span><span>
