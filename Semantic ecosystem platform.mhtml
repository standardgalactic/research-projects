</span><span><span class="hljs-keyword">\[</span></span><span>
</span><span><span class="hljs-keyword">\entropy</span></span><span>(</span><span><span class="hljs-keyword">\merge</span></span><span>(</span><span><span class="hljs-keyword">\sphere</span></span><span><span class="hljs-built_in">_</span></span><span>1,</span><span><span class="hljs-keyword">\sphere</span></span><span><span class="hljs-built_in">_</span></span><span>2)) </span><span><span class="hljs-keyword">\le</span></span><span>
</span><span><span class="hljs-keyword">\entropy</span></span><span>(</span><span><span class="hljs-keyword">\sphere</span></span><span><span class="hljs-built_in">_</span></span><span>1) + </span><span><span class="hljs-keyword">\entropy</span></span><span>(</span><span><span class="hljs-keyword">\sphere</span></span><span><span class="hljs-built_in">_</span></span><span>2) + </span><span><span class="hljs-keyword">\log</span></span><span>(1+</span><span><span class="hljs-keyword">\dim</span></span><span>(</span><span><span class="hljs-keyword">\mathcal</span></span><span>{M}))
</span><span><span class="hljs-keyword">\]</span></span><span>
</span><span><span class="hljs-keyword">\end</span></span><span>{lemma}

</span><span><span class="hljs-comment">% ============================================================</span></span><span>
</span><span><span class="hljs-keyword">\section</span></span><span>{Categorical Framing of SpherePOP}
</span><span><span class="hljs-keyword">\label</span></span><span>{sec:A2}

</span><span><span class="hljs-keyword">\begin</span></span><span>{theorem}[SpherePOP is a Symmetric Monoidal Category]
Let objects be spheres, morphisms be semantic rewrites, and </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\tensor</span></span><span><span class="hljs-built_in">$</span></span><span> encode multimodal juxtaposition. Then:
</span><span><span class="hljs-keyword">\[</span></span><span>
(</span><span><span class="hljs-keyword">\mathbf</span></span><span>{Sph}, </span><span><span class="hljs-keyword">\tensor</span></span><span>, I, </span><span><span class="hljs-keyword">\alpha</span></span><span>, </span><span><span class="hljs-keyword">\lambda</span></span><span>, </span><span><span class="hljs-keyword">\rho</span></span><span>, </span><span><span class="hljs-keyword">\sigma</span></span><span>)
</span><span><span class="hljs-keyword">\]</span></span><span>
satisfies the axioms of a symmetric monoidal category </span><span><span class="hljs-keyword">\cite</span></span><span>{MacLane1998}.
</span><span><span class="hljs-keyword">\end</span></span><span>{theorem}

</span><span><span class="hljs-keyword">\begin</span></span><span>{definition}[Bifunctorial Merge]
</span><span><span class="hljs-keyword">\[</span></span><span>
</span><span><span class="hljs-keyword">\merge</span></span><span> : </span><span><span class="hljs-keyword">\mathbf</span></span><span>{Sph} </span><span><span class="hljs-keyword">\xrightarrow</span></span><span>{</span><span><span class="hljs-keyword">\tensor</span></span><span>} </span><span><span class="hljs-keyword">\mathbf</span></span><span>{Sph} </span><span><span class="hljs-keyword">\xrightarrow</span></span><span>{C} </span><span><span class="hljs-keyword">\mathbf</span></span><span>{Sph}
</span><span><span class="hljs-keyword">\]</span></span><span>
where </span><span><span class="hljs-built_in">$</span></span><span>C</span><span><span class="hljs-built_in">$</span></span><span> enforces entropy bounds and determines conflict mediation.
</span><span><span class="hljs-keyword">\end</span></span><span>{definition}

</span><span><span class="hljs-keyword">\begin</span></span><span>{theorem}[Entropy-Aware Associativity (Weak)]
</span><span><span class="hljs-keyword">\[</span></span><span>
</span><span><span class="hljs-keyword">\entropy</span></span><span>((a </span><span><span class="hljs-keyword">\merge</span></span><span> b)</span><span><span class="hljs-keyword">\merge</span></span><span> c) - </span><span><span class="hljs-keyword">\entropy</span></span><span>(a </span><span><span class="hljs-keyword">\merge</span></span><span> (b</span><span><span class="hljs-keyword">\merge</span></span><span> c)) </span><span><span class="hljs-keyword">\le</span></span><span> </span><span><span class="hljs-keyword">\delta</span></span><span>
</span><span><span class="hljs-keyword">\]</span></span><span>
for bounded divergence </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\delta</span></span><span><span class="hljs-built_in">$</span></span><span> fixed by policy.
</span><span><span class="hljs-keyword">\end</span></span><span>{theorem}

</span><span><span class="hljs-comment">% ============================================================</span></span><span>
</span><span><span class="hljs-keyword">\section</span></span><span>{Typed Sphere Calculus with Entropy Effects}
</span><span><span class="hljs-keyword">\label</span></span><span>{sec:A3}

</span><span><span class="hljs-keyword">\subsection</span></span><span>{Typing Judgments}
</span><span><span class="hljs-keyword">\[</span></span><span>
</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\sphere</span></span><span> : </span><span><span class="hljs-keyword">\mathcal</span></span><span>{M} [</span><span><span class="hljs-keyword">\entropy</span></span><span> </span><span><span class="hljs-keyword">\le</span></span><span> </span><span><span class="hljs-keyword">\kappa</span></span><span>]
</span><span><span class="hljs-keyword">\qquad</span></span><span>
</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> r : </span><span><span class="hljs-keyword">\mathcal</span></span><span>{M}</span><span><span class="hljs-built_in">_</span></span><span>1 </span><span><span class="hljs-keyword">\to</span></span><span> </span><span><span class="hljs-keyword">\mathcal</span></span><span>{M}</span><span><span class="hljs-built_in">_</span></span><span>2 [</span><span><span class="hljs-keyword">\Delta</span></span><span> </span><span><span class="hljs-keyword">\entropy</span></span><span> </span><span><span class="hljs-keyword">\le</span></span><span> </span><span><span class="hljs-keyword">\lambda</span></span><span><span class="hljs-built_in">_</span></span><span>r]
</span><span><span class="hljs-keyword">\]</span></span><span>

</span><span><span class="hljs-keyword">\subsection</span></span><span>{Core Typing Rules}

</span><span><span class="hljs-keyword">\[</span></span><span>
</span><span><span class="hljs-keyword">\frac</span></span><span>{
  </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> a : </span><span><span class="hljs-keyword">\mathcal</span></span><span>{M}</span><span><span class="hljs-built_in">_</span></span><span>1 [e</span><span><span class="hljs-built_in">_</span></span><span>1] </span><span><span class="hljs-keyword">\quad</span></span><span>
  </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> b : </span><span><span class="hljs-keyword">\mathcal</span></span><span>{M}</span><span><span class="hljs-built_in">_</span></span><span>2 [e</span><span><span class="hljs-built_in">_</span></span><span>2]
}{
  </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> a </span><span><span class="hljs-keyword">\tensor</span></span><span> b : </span><span><span class="hljs-keyword">\mathcal</span></span><span>{M}</span><span><span class="hljs-built_in">_</span></span><span>1 </span><span><span class="hljs-keyword">\tensor</span></span><span> </span><span><span class="hljs-keyword">\mathcal</span></span><span>{M}</span><span><span class="hljs-built_in">_</span></span><span>2
  [e</span><span><span class="hljs-built_in">_</span></span><span>1 + e</span><span><span class="hljs-built_in">_</span></span><span>2]
}
</span><span><span class="hljs-keyword">\]</span></span><span>

</span><span><span class="hljs-keyword">\[</span></span><span>
</span><span><span class="hljs-keyword">\frac</span></span><span>{
  </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> a : </span><span><span class="hljs-keyword">\mathcal</span></span><span>{M} [e</span><span><span class="hljs-built_in">_</span></span><span>1] </span><span><span class="hljs-keyword">\quad</span></span><span>
  </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> b : </span><span><span class="hljs-keyword">\mathcal</span></span><span>{M} [e</span><span><span class="hljs-built_in">_</span></span><span>2] </span><span><span class="hljs-keyword">\quad</span></span><span>
  e</span><span><span class="hljs-built_in">_</span></span><span>1 + e</span><span><span class="hljs-built_in">_</span></span><span>2 + </span><span><span class="hljs-keyword">\delta</span></span><span> </span><span><span class="hljs-keyword">\le</span></span><span> </span><span><span class="hljs-keyword">\kappa</span></span><span>
}{
  </span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\merge</span></span><span>(a,b) : </span><span><span class="hljs-keyword">\mathcal</span></span><span>{M} [e</span><span><span class="hljs-built_in">_</span></span><span>1 + e</span><span><span class="hljs-built_in">_</span></span><span>2 + </span><span><span class="hljs-keyword">\delta</span></span><span>]
}
</span><span><span class="hljs-keyword">\]</span></span><span>

</span><span><span class="hljs-keyword">\begin</span></span><span>{theorem}[Type Preservation]
If </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\sphere</span></span><span> : </span><span><span class="hljs-keyword">\mathcal</span></span><span>{M}[</span><span><span class="hljs-keyword">\epsilon</span></span><span>]</span><span><span class="hljs-built_in">$</span></span><span> and
</span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\sphere</span></span><span> </span><span><span class="hljs-keyword">\rightarrow</span></span><span> </span><span><span class="hljs-keyword">\sphere</span></span><span>'</span><span><span class="hljs-built_in">$</span></span><span> by a valid rule, then:
</span><span><span class="hljs-keyword">\[</span></span><span>
</span><span><span class="hljs-keyword">\Gamma</span></span><span> </span><span><span class="hljs-keyword">\vdash</span></span><span> </span><span><span class="hljs-keyword">\sphere</span></span><span>' : </span><span><span class="hljs-keyword">\mathcal</span></span><span>{M}[</span><span><span class="hljs-keyword">\epsilon</span></span><span>'] </span><span><span class="hljs-keyword">\quad</span></span><span> </span><span><span class="hljs-keyword">\text</span></span><span>{where } </span><span><span class="hljs-keyword">\epsilon</span></span><span>' </span><span><span class="hljs-keyword">\le</span></span><span> </span><span><span class="hljs-keyword">\kappa</span></span><span>
</span><span><span class="hljs-keyword">\]</span></span><span>
</span><span><span class="hljs-keyword">\end</span></span><span>{theorem}

</span><span><span class="hljs-keyword">\begin</span></span><span>{theorem}[Progress]
A well-typed sphere is either a value or can take a rewrite step without violating entropy bounds.
</span><span><span class="hljs-keyword">\end</span></span><span>{theorem}

</span><span><span class="hljs-comment">% ============================================================</span></span><span>
</span><span><span class="hljs-keyword">\section</span></span><span>{Traced Structure: Feedback and Self-Reference}
</span><span><span class="hljs-keyword">\label</span></span><span>{sec:A4}

PlenumHub extends </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\mathbf</span></span><span>{Sph}</span><span><span class="hljs-built_in">$</span></span><span> with a trace operator </span><span><span class="hljs-keyword">\cite</span></span><span>{Joyal1996,Selinger2010} to model loops:

</span><span><span class="hljs-keyword">\begin</span></span><span>{definition}[Trace]
For morphism </span><span><span class="hljs-built_in">$</span></span><span>f: X </span><span><span class="hljs-keyword">\tensor</span></span><span> U </span><span><span class="hljs-keyword">\to</span></span><span> Y </span><span><span class="hljs-keyword">\tensor</span></span><span> U</span><span><span class="hljs-built_in">$</span></span><span>,
</span><span><span class="hljs-keyword">\[</span></span><span>
</span><span><span class="hljs-keyword">\Tr</span></span><span><span class="hljs-built_in">^</span></span><span>U(f): X </span><span><span class="hljs-keyword">\to</span></span><span> Y
</span><span><span class="hljs-keyword">\]</span></span><span>
closes the </span><span><span class="hljs-built_in">$</span></span><span>U</span><span><span class="hljs-built_in">$</span></span><span> channel as feedback.
</span><span><span class="hljs-keyword">\end</span></span><span>{definition}

</span><span><span class="hljs-keyword">\[</span></span><span>
</span><span><span class="hljs-keyword">\begin</span></span><span>{tikzpicture}[baseline=(c)]
  </span><span><span class="hljs-keyword">\node</span></span><span> (c) at (0,0) {};
  </span><span><span class="hljs-keyword">\draw</span></span><span>[-&gt;] (-1,0.4) -- (0,0.4);
  </span><span><span class="hljs-keyword">\draw</span></span><span> (0,0.4) arc (90:-90:0.4);
  </span><span><span class="hljs-keyword">\draw</span></span><span>[-&gt;] (0,-0.4) -- (1,-0.4);
  </span><span><span class="hljs-keyword">\node</span></span><span> at (-0.2,0) {</span><span><span class="hljs-built_in">$</span></span><span>f</span><span><span class="hljs-built_in">$</span></span><span>};
  </span><span><span class="hljs-keyword">\node</span></span><span>[font=</span><span><span class="hljs-keyword">\small</span></span><span>] at (0.6,0.6) {</span><span><span class="hljs-built_in">$</span></span><span>U</span><span><span class="hljs-built_in">$</span></span><span>};
</span><span><span class="hljs-keyword">\end</span></span><span>{tikzpicture}
</span><span><span class="hljs-keyword">\]</span></span><span>

</span><span><span class="hljs-keyword">\begin</span></span><span>{lemma}[Entropy Safety for Feedback]
</span><span><span class="hljs-keyword">\[</span></span><span>
</span><span><span class="hljs-keyword">\entropy</span></span><span>(</span><span><span class="hljs-keyword">\Tr</span></span><span><span class="hljs-built_in">^</span></span><span>U(f)) </span><span><span class="hljs-keyword">\le</span></span><span> </span><span><span class="hljs-keyword">\entropy</span></span><span>(f) + </span><span><span class="hljs-keyword">\log</span></span><span>(1+ </span><span><span class="hljs-keyword">\dim</span></span><span> U)
</span><span><span class="hljs-keyword">\]</span></span><span>
and loops with unbounded entropy growth are rejected.
</span><span><span class="hljs-keyword">\end</span></span><span>{lemma}

</span><span><span class="hljs-keyword">\begin</span></span><span>{definition}[Semantic Crystals as Fixed Points]
</span><span><span class="hljs-keyword">\[</span></span><span>
f</span><span><span class="hljs-built_in">^</span></span><span>* = </span><span><span class="hljs-keyword">\Tr</span></span><span>(f</span><span><span class="hljs-built_in">^</span></span><span>* </span><span><span class="hljs-keyword">\tensor</span></span><span> </span><span><span class="hljs-keyword">\mathrm</span></span><span>{id})
</span><span><span class="hljs-keyword">\]</span></span><span>
where </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\entropy</span></span><span>(f</span><span><span class="hljs-built_in">^</span></span><span>*) = 0</span><span><span class="hljs-built_in">$</span></span><span> and </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\partial</span></span><span><span class="hljs-built_in">_</span></span><span>t </span><span><span class="hljs-keyword">\entropy</span></span><span>(f) </span><span><span class="hljs-keyword">\le</span></span><span> 0</span><span><span class="hljs-built_in">$</span></span><span>.
These form stabilized texture/time crystal tokens.
</span><span><span class="hljs-keyword">\end</span></span><span>{definition}

</span><span><span class="hljs-comment">% ============================================================</span></span><span>
</span><span><span class="hljs-keyword">\section</span></span><span>{Interpretation}

</span><span><span class="hljs-keyword">\begin</span></span><span>{itemize}
  </span><span><span class="hljs-keyword">\item</span></span><span> Merges are bounded at the type level, not by policy.
  </span><span><span class="hljs-keyword">\item</span></span><span> Feedback loops must converge semantically or fail.
  </span><span><span class="hljs-keyword">\item</span></span><span> Value is backed by irreversible entropy reduction, not external consensus.
  </span><span><span class="hljs-keyword">\item</span></span><span> Knowledge graphs become executable fixed points, not mutable logs.
</span><span><span class="hljs-keyword">\end</span></span><span>{itemize}

