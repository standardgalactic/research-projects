-size3 size1 mtight"><span class="mord mtight">1</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.143em;"><span></span></span></span></span></span></span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.2501em;"><span></span></span></span></span></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mord mathnormal">b</span><span class="mspace" style="margin-right: 1em;"></span><span class="mord">Γ</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">⊢</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right: 0.02778em;">r</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3011em;"><span style="top: -2.55em; margin-left: -0.0278em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight">2</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span></span></span></span></span></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">:</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mord mathnormal">b</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel"><span class="mrel">→</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.1514em;"><span style="top: -2.55em; margin-left: 0em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mtight"><span class="mord mathnormal mtight">ϵ</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3173em;"><span style="top: -2.357em; margin-left: 0em; margin-right: 0.0714em;"><span class="pstrut" style="height: 2.5em;"></span><span class="sizing reset-size3 size1 mtight"><span class="mord mtight">2</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.143em;"><span></span></span></span></span></span></span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.2501em;"><span></span></span></span></span></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mord mathnormal">c</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.9361em;"><span></span></span></span></span></span><span class="mclose nulldelimiter"></span></span><span class="mspace" style="margin-right: 1em;"></span><span class="mopen">(</span><span class="mord text" style="color: rgb(204, 0, 0);"><span class="mord" style="color: rgb(204, 0, 0);">\textsc</span></span><span class="mord"><span class="mord mathnormal" style="margin-right: 0.13889em;">T</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">−</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mord mathnormal" style="margin-right: 0.07153em;">C</span><span class="mord mathnormal">o</span><span class="mord mathnormal">m</span><span class="mord mathnormal">p</span><span class="mord mathnormal">ose</span></span><span class="mclose">)</span></span></span></span></span>
<h3 data-start="2379" data-end="2429"><strong data-start="2383" data-end="2429">B.5. Pop (Rewrite Application) Typing Rule</strong></h3>
<p data-start="2431" data-end="2460">A sphere may be rewritten if:</p>
<ol data-start="2462" data-end="2530">
<li data-start="2462" data-end="2491">
<p data-start="2465" data-end="2491">The input modality exists.</p>
</li>
<li data-start="2492" data-end="2530">
<p data-start="2495" data-end="2530">The entropy budget is not exceeded.</p>
</li>
</ol>
<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mfrac><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mi>r</mi><mo>:</mo><mi>a</mi><msub><mo>→</mo><mi>ϵ</mi></msub><mi>b</mi><mspace width="1em"></mspace><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mi>σ</mi><mo>:</mo><mi>T</mi><mo stretchy="false">[</mo><mi>E</mi><mo>≤</mo><mi>e</mi><mo stretchy="false">]</mo><mspace width="1em"></mspace><mi>a</mi><mo>∈</mo><mi>T</mi><mspace width="1em"></mspace><mi>e</mi><mo>+</mo><mi>ϵ</mi><mo>≤</mo><msub><mi>e</mi><mtext>max</mtext></msub></mrow><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mtext>pop</mtext><mo stretchy="false">(</mo><mi>σ</mi><mo separator="true">,</mo><mi>r</mi><mo stretchy="false">)</mo><mo>:</mo><mi>T</mi><mo>∪</mo><mo stretchy="false">{</mo><mi>b</mi><mo stretchy="false">}</mo><mo stretchy="false">[</mo><mi>E</mi><mo>≤</mo><mi>e</mi><mo>+</mo><mi>ϵ</mi><mo stretchy="false">]</mo></mrow></mfrac><mspace width="1em"></mspace><mo stretchy="false">(</mo><mstyle mathcolor="#cc0000"><mtext>\textsc</mtext></mstyle><mrow><mi>T</mi><mo>−</mo><mi>P</mi><mi>o</mi><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\frac{
  \Gamma \vdash r : a \to_\epsilon b \quad
  \Gamma \vdash \sigma : T [E \le e] \quad
  a \in T \quad
  e + \epsilon \le e_{\text{max}}
}{
  \Gamma \vdash \text{pop}(\sigma, r) : T \cup \{b\} [E \le e + \epsilon]
