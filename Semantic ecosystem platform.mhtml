 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-python"><span><span><span class="hljs-comment"># Minimal reference implementation for Stage 2.</span></span><span>
</span><span><span class="hljs-keyword">from</span></span><span> dataclasses </span><span><span class="hljs-keyword">import</span></span><span> dataclass, field
</span><span><span class="hljs-keyword">from</span></span><span> typing </span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-type">Dict</span></span><span>, </span><span><span class="hljs-type">List</span></span><span>, </span><span><span class="hljs-type">Optional</span></span><span>
</span><span><span class="hljs-keyword">import</span></span><span> json
</span><span><span class="hljs-keyword">import</span></span><span> hashlib

</span><span><span class="hljs-meta">@dataclass</span></span><span>
</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">Modality</span></span><span>:
    name: </span><span><span class="hljs-built_in">str</span></span><span>

</span><span><span class="hljs-meta">@dataclass</span></span><span>
</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">Sphere</span></span><span>:
    </span><span><span class="hljs-built_in">id</span></span><span>: </span><span><span class="hljs-built_in">str</span></span><span>
    types: </span><span><span class="hljs-type">List</span></span><span>[</span><span><span class="hljs-built_in">str</span></span><span>]
    contents: </span><span><span class="hljs-type">Dict</span></span><span>[</span><span><span class="hljs-built_in">str</span></span><span>, </span><span><span class="hljs-built_in">str</span></span><span>] = field(default_factory=</span><span><span class="hljs-built_in">dict</span></span><span>)
    entropy: </span><span><span class="hljs-built_in">float</span></span><span> = </span><span><span class="hljs-number">0.0</span></span><span>
    provenance: </span><span><span class="hljs-type">List</span></span><span>[</span><span><span class="hljs-built_in">str</span></span><span>] = field(default_factory=</span><span><span class="hljs-built_in">list</span></span><span>)

    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">fingerprint</span></span><span>(</span><span><span class="hljs-params">self</span></span><span>) -&gt; </span><span><span class="hljs-built_in">str</span></span><span>:
        h = hashlib.sha256()
        h.update(self.</span><span><span class="hljs-built_in">id</span></span><span>.encode())
        h.update(</span><span><span class="hljs-built_in">str</span></span><span>(</span><span><span class="hljs-built_in">sorted</span></span><span>(self.contents.items())).encode())
        h.update(</span><span><span class="hljs-built_in">str</span></span><span>(self.entropy).encode())
        </span><span><span class="hljs-keyword">return</span></span><span> h.hexdigest()

</span><span><span class="hljs-meta">@dataclass</span></span><span>
</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">Rule</span></span><span>:
    </span><span><span class="hljs-built_in">id</span></span><span>: </span><span><span class="hljs-built_in">str</span></span><span>
    input_mod: </span><span><span class="hljs-built_in">str</span></span><span>
    output_mod: </span><span><span class="hljs-built_in">str</span></span><span>
    eps: </span><span><span class="hljs-built_in">float</span></span><span>  </span><span><span class="hljs-comment"># entropy budget</span></span><span>
    impl: </span><span><span class="hljs-type">Optional</span></span><span>[</span><span><span class="hljs-built_in">str</span></span><span>] = </span><span><span class="hljs-literal">None</span></span><span>  </span><span><span class="hljs-comment"># reference to implementation (WASM, python path, etc.)</span></span><span>

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">apply_rule</span></span><span>(</span><span><span class="hljs-params">rule: Rule, s: Sphere</span></span><span>) -&gt; Sphere:
    </span><span><span class="hljs-comment"># Very small deterministic stub: write placeholder output and increase entropy by &lt;= eps.</span></span><span>
    new_contents = </span><span><span class="hljs-built_in">dict</span></span><span>(s.contents)
    new_contents[rule.output_mod] = </span><span><span class="hljs-string">f"generated_by_<span class="hljs-subst">{rule.<span class="hljs-built_in">id</span></span></span></span><span>}"
    new_entropy = s.entropy + rule.eps
    new_prov = s.provenance + [rule.</span><span><span class="hljs-built_in">id</span></span><span>]
    </span><span><span class="hljs-keyword">return</span></span><span> Sphere(</span><span><span class="hljs-built_in">id</span></span><span>=s.</span><span><span class="hljs-built_in">id</span></span><span> + </span><span><span class="hljs-string">f".<span class="hljs-subst">{rule.<span class="hljs-built_in">id</span></span></span></span><span>}", types=s.types, contents=new_contents, entropy=new_entropy, provenance=new_prov)

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">merge_spheres</span></span><span>(</span><span><span class="hljs-params">a: Sphere, b: Sphere, merge_eps: <span class="hljs-built_in">float</span></span></span><span>) -&gt; </span><span><span class="hljs-type">Optional</span></span><span>[Sphere]:
    </span><span><span class="hljs-comment"># naive structural merge: union contents; entropy set to max + small penalty if conflict</span></span><span>
    merged_contents = </span><span><span class="hljs-built_in">dict</span></span><span>(a.contents)
    conflicts = []
    </span><span><span class="hljs-keyword">for</span></span><span> k, v </span><span><span class="hljs-keyword">in</span></span><span> b.contents.items():
        </span><span><span class="hljs-keyword">if</span></span><span> k </span><span><span class="hljs-keyword">in</span></span><span> merged_contents </span><span><span class="hljs-keyword">and</span></span><span> merged_contents[k] != v:
            conflicts.append(k)
            </span><span><span class="hljs-comment"># prefer a's content but mark as conflict in provenance</span></span><span>
        </span><span><span class="hljs-keyword">else</span></span><span>:
            merged_contents[k] = v
    base_entropy = </span><span><span class="hljs-built_in">max</span></span><span>(a.entropy, b.entropy)
    </span><span><span class="hljs-comment"># simple conflict penalty</span></span><span>
    penalty = </span><span><span class="hljs-number">0.1</span></span><span> * </span><span><span class="hljs-built_in">len</span></span><span>(conflicts)
    merged_entropy = base_entropy + penalty
    </span><span><span class="hljs-keyword">if</span></span><span> merged_entropy &lt;= base_entropy + merge_eps:
        merged_id = a.</span><span><span class="hljs-built_in">id</span></span><span> + </span><span><span class="hljs-string">"+"</span></span><span> + b.</span><span><span class="hljs-built_in">id</span></span><span>
        merged_prov = a.provenance + b.provenance + [</span><span><span class="hljs-string">"merge"</span></span><span>]
        </span><span><span class="hljs-keyword">return</span></span><span> Sphere(</span><span><span class="hljs-built_in">id</span></span><span>=merged_id, types=</span><span><span class="hljs-built_in">list</span></span><span>(</span><span><span class="hljs-built_in">set</span></span><span>(a.types + b.types)), contents=merged_contents, entropy=merged_entropy, provenance=merged_prov)
    </span><span><span class="hljs-keyword">else</span></span><span>:
        </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>  </span><span><span class="hljs-comment"># merge rejected, requires mediation</span></span><span>

</span><span><span class="hljs-comment"># Simple proof certificate (minimal)</span></span><span>
</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">make_proof</span></span><span>(</span><span><span class="hljs-params">s_before: Sphere, s_after: Sphere, rule_chain: <span class="hljs-type">List</span></span></span><span>[</span><span><span class="hljs-built_in">str</span></span><span>]) -&gt; </span><span><span class="hljs-type">Dict</span></span><span>:
    </span><span><span class="hljs-keyword">return</span></span><span> {
        </span><span><span class="hljs-string">"before"</span></span><span>: s_before.fingerprint(),
        </span><span><span class="hljs-string">"after"</span></span><span>: s_after.fingerprint(),
        </span><span><span class="hljs-string">"rules"</span></span><span>: rule_chain,
        </span><span><span class="hljs-string">"entropy_before"</span></span><span>: s_before.entropy,
        </span><span><span class="hljs-string">"entropy_after"</span></span><span>: s_after.entropy
    }

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">verify_proof</span></span><span>(</span><span><span class="hljs-params">proof: <span class="hljs-type">Dict</span></span></span><span>, s_before: Sphere, s_after: Sphere) -&gt; </span><span><span class="hljs-built_in">bool</span></span><span>:
    </span><span><span class="hljs-keyword">return</span></span><span> proof[</span><span><span class="hljs-string">"before"</span></span><span>] == s_before.fingerprint() </span><span><span class="hljs-keyword">and</span></span><span> proof[</span><span><span class="hljs-string">"after"</span></span><span>] == s_after.fingerprint()
</span></span></code></div></div></pre>
