    mmap: </span><span><span class="hljs-type">Dict</span></span><span>[Modality, Content]               </span><span><span class="hljs-comment"># present modality content</span></span><span>
    entropy: </span><span><span class="hljs-built_in">float</span></span><span>                              </span><span><span class="hljs-comment"># semantic entropy &gt;= 0</span></span><span>
    prov: </span><span><span class="hljs-type">List</span></span><span>[</span><span><span class="hljs-built_in">str</span></span><span>] = field(default_factory=</span><span><span class="hljs-built_in">list</span></span><span>)</span><span><span class="hljs-comment"># provenance history</span></span><span>

    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">copy</span></span><span>(</span><span><span class="hljs-params">self, **kwargs</span></span><span>) -&gt; </span><span><span class="hljs-string">"Sphere"</span></span><span>:
