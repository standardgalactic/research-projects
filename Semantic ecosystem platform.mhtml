</span><span><span class="hljs-comment"># --- Merge engine --------------------------------------------------------</span></span><span>

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">entropy_merge_score</span></span><span>(</span><span><span class="hljs-params">a: Sphere, b: Sphere</span></span><span>) -&gt; </span><span><span class="hljs-type">Tuple</span></span><span>[</span><span><span class="hljs-built_in">float</span></span><span>,</span><span><span class="hljs-built_in">float</span></span><span>]:
