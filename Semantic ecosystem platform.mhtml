};

</span><span><span class="hljs-keyword">\node</span></span><span>[engine, right=of sphere] (pop) {
  </span><span><span class="hljs-keyword">\textbf</span></span><span>{Pop Execution Runtime}</span><span><span class="hljs-keyword">\\</span></span><span>
  SpherePOP evaluator </span><span><span class="hljs-keyword">\&amp;</span></span><span> Rule Engine
};

</span><span><span class="hljs-keyword">\node</span></span><span>[box, right=of pop] (merge) {
  </span><span><span class="hljs-keyword">\textbf</span></span><span>{Merge Adjudication Layer}</span><span><span class="hljs-keyword">\\</span></span><span>
  Pushout / mediation / TiC quorum
};

</span><span><span class="hljs-comment">% Row 2: below row1</span></span><span>
</span><span><span class="hljs-keyword">\node</span></span><span>[box, below=22mm of pop] (mod) {
  </span><span><span class="hljs-keyword">\textbf</span></span><span>{Modality Completion Engine}</span><span><span class="hljs-keyword">\\</span></span><span>
  Permitted transducers </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\tau</span></span><span><span class="hljs-built_in">_</span></span><span>{a</span><span><span class="hljs-keyword">\to</span></span><span> b}</span><span><span class="hljs-built_in">$</span></span><span> (TTS, STT, compilers)
};

</span><span><span class="hljs-keyword">\node</span></span><span>[box, right=of mod] (reputation) {
  </span><span><span class="hljs-keyword">\textbf</span></span><span>{Reputation </span><span><span class="hljs-keyword">\&amp;</span></span><span> Attribution}</span><span><span class="hljs-keyword">\\</span></span><span>
  Crystal stakes, provenance weighting
};

</span><span><span class="hljs-comment">% Row 3: right-side network &amp; API</span></span><span>
</span><span><span class="hljs-keyword">\node</span></span><span>[cloud, right=28mm of merge] (consensus) {
  </span><span><span class="hljs-keyword">\textbf</span></span><span>{Consensus / Proof Network}</span><span><span class="hljs-keyword">\\</span></span><span>
  Broadcast proofs </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\pi</span></span><span><span class="hljs-built_in">$</span></span><span> (verify </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\Rightarrow</span></span><span><span class="hljs-built_in">$</span></span><span> accept)
};

</span><span><span class="hljs-keyword">\node</span></span><span>[box, below=of consensus] (api) {
  </span><span><span class="hljs-keyword">\textbf</span></span><span>{Public API / JSON-RPC}</span><span><span class="hljs-keyword">\\</span></span><span>
  Proof submission, query, notarization
};

</span><span><span class="hljs-comment">% Small annotations / caches</span></span><span>
</span><span><span class="hljs-keyword">\node</span></span><span>[box, above=of sphere] (cache) {
  </span><span><span class="hljs-keyword">\textbf</span></span><span>{Proof Cache </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\mathcal</span></span><span>{P}</span><span><span class="hljs-built_in">$</span></span><span>}</span><span><span class="hljs-keyword">\\</span></span><span>
  Proof replay / verification
};

</span><span><span class="hljs-comment">% Draw arrows: basic data flows</span></span><span>
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (sphere.east) -- ++(6mm,0) |- (pop.west) node[midway, above, small] {fetch sphere / provenance};
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (pop.east) -- (merge.west) node[midway, above, small] {candidate updates / proof};
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (merge.south) -- ++(0,-6mm) -| (mod.north) node[pos=0.25, right, small] {needs mediation / synthesis};
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (mod.east) -- ++(6mm,0) |- (reputation.west) node[pos=0.25, above, small] {synthesis certs / TC issuance};
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (merge.east) -- ++(6mm,0) -- (consensus.west) node[midway, above, small] {proof </span><span><span class="hljs-built_in">$</span></span><span><span class="hljs-keyword">\pi</span></span><span><span class="hljs-built_in">$</span></span><span> broadcast};
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (consensus.south) -- (api.north) node[midway, right, small] {proof query / accept};

</span><span><span class="hljs-keyword">\draw</span></span><span>[bidir] (sphere.south) -- ++(0,-8mm) -| (mod.west) node[midway, below, small] {closure requests / synthesis};
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (reputation.east) -- ++(6mm,0) |- (consensus.south) node[pos=0.25, right, small] {stake / attestations};
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (api.west) -- ++(-6mm,0) |- (pop.south) node[midway, left, small] {submit rule chain / pop event};

</span><span><span class="hljs-comment">% Proof cache connections</span></span><span>
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (pop.north) -- (cache.south) node[midway, left, small] {cache proofs};
</span><span><span class="hljs-keyword">\draw</span></span><span>[arrow] (cache.east) -- ++(6mm,0) |- (consensus.west) node[midway, above, small] {replay proofs for verification};

</span><span><span class="hljs-comment">% Legend</span></span><span>
</span><span><span class="hljs-keyword">\node</span></span><span>[box, below=18mm of api, minimum width=120mm] (legend) {
  </span><span><span class="hljs-keyword">\begin</span></span><span>{tabular}{@{} l l @{}}
    </span><span><span class="hljs-keyword">\textbf</span></span><span>{Box} </span><span><span class="hljs-built_in">&amp;</span></span><span> Runtime / service </span><span><span class="hljs-keyword">\\</span></span><span>
    </span><span><span class="hljs-keyword">\textbf</span></span><span>{Datastore (split)} </span><span><span class="hljs-built_in">&amp;</span></span><span> persisted sphere store (Merkle DAG) </span><span><span class="hljs-keyword">\\</span></span><span>
    </span><span><span class="hljs-keyword">\textbf</span></span><span>{Cloud} </span><span><span class="hljs-built_in">&amp;</span></span><span> decentralized consensus / network </span><span><span class="hljs-keyword">\\</span></span><span>
    </span><span><span class="hljs-keyword">\textbf</span></span><span>{Dashed double arrow} </span><span><span class="hljs-built_in">&amp;</span></span><span> bidirectional audit / replay paths </span><span><span class="hljs-keyword">\\</span></span><span>
    </span><span><span class="hljs-keyword">\textbf</span></span><span>{Solid arrow} </span><span><span class="hljs-built_in">&amp;</span></span><span> directed operation / message flow
  </span><span><span class="hljs-keyword">\end</span></span><span>{tabular}
};

