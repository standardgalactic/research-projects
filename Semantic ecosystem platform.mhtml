        s = self.spheres[src_id]
        s2 = apply_rule(rule, s)
        proof = make_proof(s, s2, [rule.</span><span><span class="hljs-built_in">id</span></span><span>])
        self.add_sphere(s2)
        </span><span><span class="hljs-keyword">return</span></span><span> s2, proof

    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">merge</span></span><span>(</span><span><span class="hljs-params">self, a_id, b_id, merge_eps</span></span><span>):
        a = self.spheres[a_id]
        b = self.spheres[b_id]
        m = merge_spheres(a, b, merge_eps)
        </span><span><span class="hljs-keyword">return</span></span><span> m
