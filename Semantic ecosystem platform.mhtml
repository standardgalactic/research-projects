</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">simple_tokenize</span></span><span>(</span><span><span class="hljs-params">text: <span class="hljs-built_in">str</span></span></span><span>):
    </span><span><span class="hljs-keyword">return</span></span><span> re.findall(</span><span><span class="hljs-string">r"[A-Za-z0-9_'-]+|[^\sA-Za-z0-9_'-]+"</span></span><span>, text)

</span><span><span class="hljs-comment"># --- Sphere (simplified copy for standalone demo) ---</span></span><span>
</span><span><span class="hljs-meta">@dataclass</span></span><span>
</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">Sphere</span></span><span>:
    </span><span><span class="hljs-built_in">id</span></span><span>: </span><span><span class="hljs-built_in">str</span></span><span>
    title: </span><span><span class="hljs-built_in">str</span></span><span>
    data: </span><span><span class="hljs-built_in">str</span></span><span>
    modalities: </span><span><span class="hljs-type">Dict</span></span><span>[</span><span><span class="hljs-built_in">str</span></span><span>, </span><span><span class="hljs-built_in">str</span></span><span>] = field(default_factory=</span><span><span class="hljs-built_in">dict</span></span><span>)
    metadata: </span><span><span class="hljs-type">Dict</span></span><span>[</span><span><span class="hljs-built_in">str</span></span><span>, </span><span><span class="hljs-built_in">str</span></span><span>] = field(default_factory=</span><span><span class="hljs-built_in">dict</span></span><span>)
    entropy_score: </span><span><span class="hljs-built_in">float</span></span><span> = </span><span><span class="hljs-number">0.0</span></span><span>

    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">clone</span></span><span>(</span><span><span class="hljs-params">self, **overrides</span></span><span>):
        d = asdict(self)
        d.update(overrides)
        </span><span><span class="hljs-keyword">return</span></span><span> Sphere(**d)

</span><span><span class="hljs-comment"># --- Rule types ---</span></span><span>
</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">Rule</span></span><span>:
    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">__init__</span></span><span>(</span><span><span class="hljs-params">self, name: <span class="hljs-built_in">str</span></span></span><span>, func: </span><span><span class="hljs-type">Callable</span></span><span>[[Sphere], Sphere], description: </span><span><span class="hljs-built_in">str</span></span><span>=</span><span><span class="hljs-string">""</span></span><span>):
        self.name = name
        self.func = func
        self.description = description

    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">apply</span></span><span>(</span><span><span class="hljs-params">self, s: Sphere</span></span><span>) -&gt; Sphere:
        </span><span><span class="hljs-keyword">return</span></span><span> self.func(s)

</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">RegexRule</span></span><span>(</span><span><span class="hljs-title class_ inherited__">Rule</span></span><span>):
    <span class="hljs-string">"""
    Applies regex substitutions to a chosen modality (default 'text').
    substitutions: list of (pattern, repl)
    """</span>
    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">__init__</span></span><span>(</span><span><span class="hljs-params">self, name: <span class="hljs-built_in">str</span></span></span><span>, substitutions: </span><span><span class="hljs-type">List</span></span><span>[</span><span><span class="hljs-type">Tuple</span></span><span>[</span><span><span class="hljs-built_in">str</span></span><span>,</span><span><span class="hljs-built_in">str</span></span><span>]], modality=</span><span><span class="hljs-string">"text"</span></span><span>, description=</span><span><span class="hljs-string">""</span></span><span>):
        </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">func</span></span><span>(</span><span><span class="hljs-params">s: Sphere</span></span><span>) -&gt; Sphere:
            txt = s.modalities.get(modality, s.data)
            </span><span><span class="hljs-keyword">for</span></span><span> pat, repl </span><span><span class="hljs-keyword">in</span></span><span> substitutions:
                txt = re.sub(pat, repl, txt)
            new_modalities = {**s.modalities, modality: txt}
            </span><span><span class="hljs-keyword">return</span></span><span> s.clone(modalities=new_modalities)
        </span><span><span class="hljs-built_in">super</span></span><span>().__init__(name, func, description)
        self.substitutions = substitutions
        self.modality = modality

</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">TypedRule</span></span><span>(</span><span><span class="hljs-title class_ inherited__">Rule</span></span><span>):
    <span class="hljs-string">"""
    Declares required input modality and output modality for a transformation.
    The transform function receives (text:str, sphere:Sphere) and returns new_text:str.
    """</span>
    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">__init__</span></span><span>(</span><span><span class="hljs-params">self, name: <span class="hljs-built_in">str</span></span></span><span>, input_modality: </span><span><span class="hljs-built_in">str</span></span><span>, output_modality: </span><span><span class="hljs-built_in">str</span></span><span>, transform: </span><span><span class="hljs-type">Callable</span></span><span>[[</span><span><span class="hljs-built_in">str</span></span><span>, Sphere], </span><span><span class="hljs-built_in">str</span></span><span>], description=</span><span><span class="hljs-string">""</span></span><span>):
        </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">func</span></span><span>(</span><span><span class="hljs-params">s: Sphere</span></span><span>) -&gt; Sphere:
            input_text = s.modalities.get(input_modality, s.data)
            out = transform(input_text, s)
            new_modalities = {**s.modalities, output_modality: out}
            </span><span><span class="hljs-keyword">return</span></span><span> s.clone(modalities=new_modalities)
        </span><span><span class="hljs-built_in">super</span></span><span>().__init__(name, func, description)
        self.input_modality = input_modality
        self.output_modality = output_modality

</span><span><span class="hljs-comment"># --- Core Interpreter with DSL support ---</span></span><span>
</span><span><span class="hljs-keyword">class</span></span><span> </span><span><span class="hljs-title class_">SpherePopInterpreterDSL</span></span><span>:
    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">__init__</span></span><span>(</span><span><span class="hljs-params">self</span></span><span>):
        self.store: </span><span><span class="hljs-type">Dict</span></span><span>[</span><span><span class="hljs-built_in">str</span></span><span>, Sphere] = {}
        self.rules: </span><span><span class="hljs-type">Dict</span></span><span>[</span><span><span class="hljs-built_in">str</span></span><span>, Rule] = {}
        self._register_builtin_rules()

    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">_register_builtin_rules</span></span><span>(</span><span><span class="hljs-params">self</span></span><span>):
        </span><span><span class="hljs-comment"># lowercase rule</span></span><span>
        </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">lowercase</span></span><span>(</span><span><span class="hljs-params">s: Sphere</span></span><span>) -&gt; Sphere:
            t = s.modalities.get(</span><span><span class="hljs-string">"text"</span></span><span>, s.data)
            </span><span><span class="hljs-keyword">return</span></span><span> s.clone(modalities={**s.modalities, </span><span><span class="hljs-string">"text"</span></span><span>: t.lower()})
        self.rules[</span><span><span class="hljs-string">"lowercase"</span></span><span>] = Rule(</span><span><span class="hljs-string">"lowercase"</span></span><span>, lowercase, </span><span><span class="hljs-string">"Lowercase text modality"</span></span><span>)

        </span><span><span class="hljs-comment"># summarize rule</span></span><span>
        </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">summarize</span></span><span>(</span><span><span class="hljs-params">s: Sphere</span></span><span>) -&gt; Sphere:
            t = s.modalities.get(</span><span><span class="hljs-string">"text"</span></span><span>, s.data)
            summary = t[:</span><span><span class="hljs-number">200</span></span><span>] + (</span><span><span class="hljs-string">"…"</span></span><span> </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-built_in">len</span></span><span>(t) &gt; </span><span><span class="hljs-number">200</span></span><span> </span><span><span class="hljs-keyword">else</span></span><span> </span><span><span class="hljs-string">""</span></span><span>)
            </span><span><span class="hljs-keyword">return</span></span><span> s.clone(modalities={**s.modalities, </span><span><span class="hljs-string">"summary"</span></span><span>: summary})
        self.rules[</span><span><span class="hljs-string">"summarize"</span></span><span>] = Rule(</span><span><span class="hljs-string">"summarize"</span></span><span>, summarize, </span><span><span class="hljs-string">"Summarize text to 200 chars"</span></span><span>)

        </span><span><span class="hljs-comment"># example TypedRule: expand acronyms -&gt; produces 'text' (updates text)</span></span><span>
        acronyms = {</span><span><span class="hljs-string">"RSVP"</span></span><span>:</span><span><span class="hljs-string">"Relativistic Scalar-Vector Plenum"</span></span><span>, </span><span><span class="hljs-string">"TTS"</span></span><span>:</span><span><span class="hljs-string">"Text-to-Speech"</span></span><span>, </span><span><span class="hljs-string">"STT"</span></span><span>:</span><span><span class="hljs-string">"Speech-to-Text"</span></span><span>}
        </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">expand_acronyms_transform</span></span><span>(</span><span><span class="hljs-params">text, s</span></span><span>):
            </span><span><span class="hljs-keyword">for</span></span><span> k,v </span><span><span class="hljs-keyword">in</span></span><span> acronyms.items():
                </span><span><span class="hljs-comment"># word-boundary replacement, preserve case if exact match</span></span><span>
                text = re.sub(</span><span><span class="hljs-string">rf"\b<span class="hljs-subst">{k}</span></span></span><span>\b", v, text)
            </span><span><span class="hljs-keyword">return</span></span><span> text
        self.rules[</span><span><span class="hljs-string">"expand_acronyms"</span></span><span>] = TypedRule(</span><span><span class="hljs-string">"expand_acronyms"</span></span><span>, </span><span><span class="hljs-string">"text"</span></span><span>, </span><span><span class="hljs-string">"text"</span></span><span>, expand_acronyms_transform,
                                                 </span><span><span class="hljs-string">"Expand known acronyms in text"</span></span><span>)

    </span><span><span class="hljs-comment"># --- store operations ---</span></span><span>
    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">add_sphere</span></span><span>(</span><span><span class="hljs-params">self, title: <span class="hljs-built_in">str</span></span></span><span>, text: </span><span><span class="hljs-built_in">str</span></span><span>, author: </span><span><span class="hljs-built_in">str</span></span><span>=</span><span><span class="hljs-string">"anon"</span></span><span>, modalities: </span><span><span class="hljs-type">Optional</span></span><span>[</span><span><span class="hljs-type">Dict</span></span><span>[</span><span><span class="hljs-built_in">str</span></span><span>,</span><span><span class="hljs-built_in">str</span></span><span>]]=</span><span><span class="hljs-literal">None</span></span><span>) -&gt; Sphere:
        s = Sphere(</span><span><span class="hljs-built_in">id</span></span><span>=new_id(), title=title, data=text, modalities=modalities </span><span><span class="hljs-keyword">or</span></span><span> {</span><span><span class="hljs-string">"text"</span></span><span>: text}, metadata={</span><span><span class="hljs-string">"author"</span></span><span>: author})
        self.store[s.</span><span><span class="hljs-built_in">id</span></span><span>] = s
        </span><span><span class="hljs-keyword">return</span></span><span> s

    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">get</span></span><span>(</span><span><span class="hljs-params">self, sphere_id: <span class="hljs-built_in">str</span></span></span><span>) -&gt; Sphere:
        </span><span><span class="hljs-keyword">return</span></span><span> self.store[sphere_id]

    </span><span><span class="hljs-comment"># --- DSL parsing &amp; execution ---</span></span><span>
    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">execute</span></span><span>(</span><span><span class="hljs-params">self, command: <span class="hljs-built_in">str</span></span></span><span>) -&gt; </span><span><span class="hljs-type">Optional</span></span><span>[Sphere]:
        <span class="hljs-string">"""
        Very small DSL with commands:
         - pop &lt;sphere_id&gt; with &lt;rule1&gt; then &lt;rule2&gt; ...
         - merge &lt;sphere_id1&gt; and &lt;sphere_id2&gt; as &lt;new_title&gt;
         - define regexrule &lt;name&gt; on &lt;modality&gt; { pattern =&gt; repl; ... }
         - define typerule &lt;name&gt; input:&lt;inmod&gt; output:&lt;outmod&gt; { python expression using `text` variable }
        Returns the resulting Sphere (for pop/merge)
        """</span>
        command = command.strip()
