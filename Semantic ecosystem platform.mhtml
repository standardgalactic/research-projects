"tests/test_core.py": textwrap.dedent("""<br data-start="9330" data-end="9332">
from plenumhub.sphere import Sphere<br>
from plenumhub.rule import Rule<br>
from plenumhub.merge import MergeEngine<br>
from plenumhub.trace import TraceOperator</p>
<p data-start="9483" data-end="9709">def test_rule_apply():<br>
s = Sphere(id='t', modalities={'text':'hello'}, entropy=0.01, provenance=[])<br>
r = Rule('r', 'text','text',0.001, lambda v: v+'!')<br>
s2 = r.apply(s)<br>
assert s2.modalities['text'].endswith('!')</p>
<p data-start="9711" data-end="9974">def test_merge_entropy():<br>
a = Sphere('A', {'text':'a'}, entropy=0.01, provenance=[])<br>
b = Sphere('B', {'text':'b'}, entropy=0.02, provenance=[])<br>
me = MergeEngine()<br>
m = me.merge(a,b)<br>
assert 'a' in m.modalities['text']<br>
assert m.entropy &gt;= 0.0</p>
<p data-start="9976" data-end="10352">def test_trace_converge():<br>
s = Sphere('X', {'text':'x'}, entropy=0.05, provenance=[])<br>
def f(sph):<br>
sph2 = sph.copy()<br>
sph2.modalities['text'] = sph2.modalities['text'].upper()<br>
sph2.entropy = max(0.0, sph2.entropy - 0.01)<br>
return sph2<br>
tr = TraceOperator(max_iters=5)<br>
fx = tr.trace(f,s)<br>
assert fx.modalities['text'] == 'X'<br>
""")<br>
