    </span><span><span class="hljs-keyword">return</span></span><span> (score(a), score(b))

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">merge_spheres</span></span><span>(</span><span><span class="hljs-params">a: Sphere, b: Sphere, policy: <span class="hljs-built_in">str</span></span></span><span>=</span><span><span class="hljs-string">"balanced"</span></span><span>) -&gt; Sphere:
