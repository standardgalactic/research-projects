<span class="line"><span style="color: rgb(220, 220, 170);">\begin</span><span style="color: rgb(78, 201, 176);">{</span><span style="color: rgb(156, 220, 254);">equation</span><span style="color: rgb(78, 201, 176);">}</span></span>
