<span class="line"><span style="color: rgb(220, 220, 170);">\subsection</span><span style="color: rgb(230, 230, 230);">{11.6 Relation to Alternative Theories}</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(220, 220, 170);">\paragraph</span><span style="color: rgb(230, 230, 230);">{Bostromâ€™s Orthogonality Thesis.}</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">RSVP replaces it with the </span><span style="color: rgb(220, 220, 170);">\emph</span><span style="color: rgb(230, 230, 230);">{</span><span style="color: rgb(230, 230, 230); font-style: italic;">Thermodynamic Orthogonality Principle</span><span style="color: rgb(230, 230, 230);">}:</span></span>
